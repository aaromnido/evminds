# Supabase Configuration
PUBLIC_SUPABASE_URL=your_supabase_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Edge Function Authentication (generated secret token)
SCRAPE_SECRET=your_scrape_secret_token

# OpenAI API (for translation)
OPENAI_API_KEY=your_openai_api_key

# Umami Analytics
PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id

# Cloudinary (image storage + on-the-fly transformations)
# Cloud name is public (used by the frontend); API key/secret are server-side
# and must also be set as Edge Function secrets in the Supabase Dashboard.
PUBLIC_CLOUDINARY_CLOUD=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini AI (article summaries + transparency notes)
# Server-side only. Must also be set as Edge Function secret in the
# Supabase Dashboard. Obtain at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<BaseLayout>
  <main class="page">
    <Header />

    <!-- Hero Section -->
    <section class="hero">
      <h1 class="hero__title">
        Hablemos de <strong>movilidad eléctrica</strong>
      </h1>
      <p class="hero__subtitle">
        ¿Tienes una sugerencia, quieres colaborar o simplemente charlar? Aquí
        estoy
      </p>
    </section>

    <!-- Contact Section -->
    <section class="contact">
      <div class="contact__main">
        <!-- Contact Info -->
        <div class="contact__info">
          <div class="contact__item">
            <h2 class="contact__label">Nombre</h2>
            <p class="contact__value">Fernando Val</p>
          </div>

          <div class="contact__item">
            <h2 class="contact__label">Email</h2>
            <a
              href="#"
              id="email-link"
              class="contact__value contact__value--link"
              data-user="aaromnido"
              data-domain="gmail.com"
            >
              <!-- Email rendered via JavaScript to prevent spam -->
            </a>
          </div>

          <div class="contact__item">
            <h2 class="contact__label">Web</h2>
            <a
              href="https://fernandoval.es/"
              target="_blank"
              rel="noopener noreferrer"
              class="contact__value contact__value--link"
            >
              fernandoval.es
            </a>
          </div>

          <div class="contact__item">
            <h2 class="contact__label">LinkedIn</h2>
            <a
              href="https://www.linkedin.com/in/aaromnido/"
              target="_blank"
              rel="noopener noreferrer"
              class="contact__value contact__value--link"
            >
              /in/aaromnido
            </a>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="cta">
          <div class="cta__content">
            <h2 class="cta__title">Únete a la comunidad</h2>
            <p class="cta__text">
              Forma parte del grupo de Telegram donde debatimos sobre movilidad
              eléctrica, compartimos noticias y construimos comunidad.
            </p>
            <a
              href="https://t.me/evminders"
              target="_blank"
              rel="noopener noreferrer"
              class="cta__button"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"
                  fill="currentColor"></path>
              </svg>
              Unirse a @evminders
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <Footer />
  </main>
</BaseLayout>

<script>
  // Anti-spam email obfuscation
  // Renders email via JavaScript to prevent spam bots from scraping it
  const emailLink = document.getElementById("email-link") as HTMLAnchorElement;
  if (emailLink) {
    const user = emailLink.getAttribute("data-user");
    const domain = emailLink.getAttribute("data-domain");
    if (user && domain) {
      const email = `${user}@${domain}`;
      emailLink.href = `mailto:${email}`;
      emailLink.textContent = email;
    }
  }
</script>

<style>
  .page {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    background-color: var(--sepia-light);
    min-height: 100vh;
  }

  /* Hero Section */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 0;
  }

  .hero__title {
    font-family: "Playfair Display", serif;
    font-size: 56px;
    font-style: italic;
    font-weight: 300;
    line-height: 1.1;
    color: var(--navy-2);
    letter-spacing: -0.01em;
    width: 100%;
  }

  .hero__title strong {
    font-weight: 600;
  }

  .hero__subtitle {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 20px;
    font-weight: 400;
    color: var(--navy-2);
    opacity: 0.7;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  /* Contact Section */
  .contact {
    max-width: 740px;
    margin: 0 auto;
    width: 100%;
  }

  .contact__main {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  .contact__info {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .contact__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact__item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .contact__label {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--navy-2);
    opacity: 0.5;
  }

  .contact__value {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 22px;
    font-weight: 400;
    color: var(--navy-2);
    line-height: 1.4;
  }

  .contact__value--link {
    text-decoration: none;
    transition: opacity 0.2s ease;
    width: fit-content;
  }

  .contact__value--link:hover {
    opacity: 0.6;
    text-decoration: underline;
  }

  /* Call to Action */
  .cta {
    background: var(--navy-2);
    border-radius: 16px;
    padding: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cta__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    max-width: 500px;
  }

  .cta__title {
    font-family: "Playfair Display", serif;
    font-size: 32px;
    font-style: italic;
    font-weight: 600;
    line-height: 1.2;
    color: var(--sepia-light);
    letter-spacing: -0.01em;
  }

  .cta__text {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--sepia-light);
    opacity: 0.85;
  }

  .cta__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: var(--sepia-light);
    color: var(--navy-2);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 17px;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    margin-top: 12px;
  }

  .cta__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }

  .cta__button svg {
    width: 20px;
    height: 20px;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .hero__title {
      font-size: 42px;
    }

    .hero__subtitle {
      font-size: 18px;
    }

    .contact__value {
      font-size: 20px;
    }

    .cta {
      padding: 40px 32px;
    }

    .cta__title {
      font-size: 28px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .page {
      padding: 0 12px 72px;
      gap: 36px;
    }

    .hero {
      padding: 24px 0;
      gap: 16px;
    }

    .hero__title {
      font-size: 28px;
    }

    .hero__subtitle {
      font-size: 15px;
    }

    .contact__main {
      gap: 48px;
    }

    .contact__info {
      gap: 28px;
    }

    .contact__item {
      padding-bottom: 20px;
    }

    .contact__value {
      font-size: 18px;
    }

    .cta {
      padding: 32px 24px;
      border-radius: 12px;
    }

    .cta__title {
      font-size: 24px;
    }

    .cta__text {
      font-size: 15px;
    }

    .cta__button {
      padding: 14px 28px;
      font-size: 15px;
    }
  }
</style>

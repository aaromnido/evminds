---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HeroSection from "@/components/HeroSection.astro";
import TelegramCTA from "@/components/TelegramCTA.astro";

export const prerender = true;
---

<BaseLayout
  title="Contacto — EVMinds | Hablemos de Movilidad Eléctrica"
  description="¿Quieres colaborar, sugerir una fuente o simplemente charlar sobre movilidad eléctrica? Contacta con EVMinds."
>
  <PageLayout>
    <Header />

    <!-- Hero Section -->
    <HeroSection
      subtitle="¿Tienes una sugerencia, quieres colaborar o simplemente charlar? Aquí estoy"
    >
      Hablemos de <strong>movilidad eléctrica</strong>
    </HeroSection>

    <!-- Contact Section -->
    <section class="contact">
      <div class="contact__main">
        <!-- Contact Info -->
        <div class="contact__info">
          <div class="contact__item">
            <h2 class="contact__label">Nombre</h2>
            <p class="contact__value">Fernando Val</p>
          </div>

          <div class="contact__item">
            <h2 class="contact__label">Email</h2>
            <a
              href="#"
              id="email-link"
              class="contact__value contact__value--link"
              data-user="fer"
              data-domain="evminds.es"
            >
              <!-- Email rendered via JavaScript to prevent spam -->
            </a>
          </div>

          <div class="contact__item">
            <h2 class="contact__label">Web</h2>
            <a
              href="https://fernandoval.es/"
              target="_blank"
              rel="noopener noreferrer"
              class="contact__value contact__value--link"
            >
              fernandoval.es
            </a>
          </div>

          <div class="contact__item">
            <h2 class="contact__label">LinkedIn</h2>
            <a
              href="https://www.linkedin.com/in/aaromnido/"
              target="_blank"
              rel="noopener noreferrer"
              class="contact__value contact__value--link"
            >
              /in/aaromnido
            </a>
          </div>
        </div>

        <!-- Call to Action -->
        <TelegramCTA
          title="Únete a la comunidad"
          text="Forma parte del grupo de Telegram donde debatimos sobre movilidad eléctrica, compartimos noticias y construimos comunidad."
        />
      </div>
    </section>

    <!-- Footer -->
    <Footer />
  </PageLayout>
</BaseLayout>

<script>
  // Anti-spam email obfuscation
  // Renders email via JavaScript to prevent spam bots from scraping it
  const emailLink = document.getElementById("email-link") as HTMLAnchorElement;
  if (emailLink) {
    const user = emailLink.getAttribute("data-user");
    const domain = emailLink.getAttribute("data-domain");
    if (user && domain) {
      const email = `${user}@${domain}`;
      emailLink.href = `mailto:${email}`;
      emailLink.textContent = email;
    }
  }
</script>

<style>
  /* Contact Section */
  .contact {
    max-width: 740px;
    margin: 0 auto;
    width: 100%;
  }

  .contact__main {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  .contact__info {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .contact__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact__item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .contact__label {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--navy-2);
    opacity: 0.5;
  }

  .contact__value {
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: 400;
    color: var(--navy-2);
    line-height: 1.4;
  }

  .contact__value--link {
    text-decoration: none;
    transition: opacity 0.2s ease;
    width: fit-content;
  }

  .contact__value--link:hover {
    opacity: 0.6;
    text-decoration: underline;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .contact__value {
      font-size: 20px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .contact__main {
      gap: 48px;
    }

    .contact__info {
      gap: 28px;
      background-color: color-mix(in srgb, var(--navy-2) 8%, transparent);
      padding: 24px;
      border-radius: 12px;
    }

    .contact__item {
      padding-bottom: 20px;
    }

    .contact__value {
      font-size: 18px;
    }
  }
</style>

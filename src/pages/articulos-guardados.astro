---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Subheader from "@/components/Subheader.astro";
import NewsCard from "@/components/NewsCard.astro";
import Badge from "@/components/Badge.astro";
import EmptyState from "@/components/EmptyState.astro";
import { STORAGE_KEY } from "@/lib/bookmarks";
---

<BaseLayout
  title="Mis artículos y vídeos guardados - EVMinds"
  description="Tu lista personal con artículos y vídeos guardados sobre movilidad eléctrica."
>
  <PageLayout>
    <Header />

    <Subheader subtitle="Tu colección personal de noticias para leer cuando quieras">
      <Fragment slot="title">
        Mis artículos <strong>guardados</strong>
      </Fragment>
    </Subheader>

    <!-- Empty state (hidden by JS when bookmarks exist) -->
    <div id="guardados-empty">
      <EmptyState ctaLabel="Explorar artículos" ctaHref="/">
        Aún <strong>no has guardado</strong> ningún artículo.<br />Pulsa el icono de marcador en
        cualquier artículo para guardarlo aquí.
      </EmptyState>
    </div>

    <!-- Grid (hidden by default, shown by JS) -->
    <section
      id="guardados-grid-section"
      class="news"
      style="display: none;"
      aria-label="Artículos guardados"
    >
      <div id="guardados-grid" class="news__grid"></div>
    </section>

    <!-- Hidden: forces Astro to include ArticleCard + Badge global styles -->
    <div style="display:none;" aria-hidden="true">
      <NewsCard image="" title="" date="" excerpt="" source="" category="" />
    </div>

    <Footer />
  </PageLayout>
</BaseLayout>

<script is:inline define:vars={{ STORAGE_KEY }}>
  function formatDate(dateString) {
    if (!dateString) return "";
    var date = new Date(dateString);
    return date.toLocaleDateString("es-ES", {
      day: "numeric",
      month: "long",
      year: "numeric",
    });
  }

  function renderBookmarkCard(bookmark) {
    var image = bookmark.image_url || "/images/placeholder-image.webp";
    var title = bookmark.title;
    var date = formatDate(bookmark.scraped_at);
    var source = bookmark.source_name;
    var category = bookmark.category;
    var contentType = bookmark.content_type || "news";
    var isVideo = contentType === "video";
    var href = isVideo ? "/video/" + bookmark.slug : "/noticia/" + bookmark.slug;
    var identifier = bookmark.id;
    var excerptText = bookmark.excerpt || "";

    // Create article element
    var articleEl = document.createElement("article");
    articleEl.className = "article-card";

    // Photo link
    var photoLink = document.createElement("a");
    photoLink.href = href;
    photoLink.className = "article-card__photo-link";

    var photoDiv = document.createElement("div");
    photoDiv.className = "article-card__photo";

    var img = document.createElement("img");
    img.src = image;
    img.alt = title;
    img.loading = "lazy";
    img.width = 600;
    img.height = 300;

    photoDiv.appendChild(img);

    // Play overlay for video bookmarks
    if (isVideo) {
      var overlay = document.createElement("div");
      overlay.className = "video-play-overlay";
      overlay.setAttribute("aria-hidden", "true");

      var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      svg.setAttribute("class", "video-play-overlay__icon");
      svg.setAttribute("viewBox", "0 0 48 48");
      svg.setAttribute("fill", "none");

      var circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("cx", "24");
      circle.setAttribute("cy", "24");
      circle.setAttribute("r", "23");
      circle.setAttribute("fill", "rgba(0,0,0,0.55)");
      circle.setAttribute("stroke", "white");
      circle.setAttribute("stroke-width", "2");

      var playPath = document.createElementNS("http://www.w3.org/2000/svg", "path");
      playPath.setAttribute("d", "M19 15L35 24L19 33V15Z");
      playPath.setAttribute("fill", "white");

      svg.appendChild(circle);
      svg.appendChild(playPath);
      overlay.appendChild(svg);
      photoDiv.appendChild(overlay);
    }

    // Actions: comment count + bookmark (top-right of photo)
    var actionsDiv = document.createElement("div");
    actionsDiv.className = "card-actions";

    var disqusSpan = document.createElement("span");
    disqusSpan.className = "disqus-comment-count";
    disqusSpan.setAttribute("data-disqus-identifier", identifier);
    disqusSpan.hidden = true;
    actionsDiv.appendChild(disqusSpan);

    // Bookmark button (always active on this page)
    var bookmarkBtn = document.createElement("button");
    bookmarkBtn.className = "bookmark-btn";
    bookmarkBtn.setAttribute("data-article-id", identifier);
    bookmarkBtn.setAttribute("aria-label", "Quitar de guardados");
    bookmarkBtn.setAttribute("aria-pressed", "true");

    var bookmarkData = JSON.stringify(bookmark);
    bookmarkBtn.setAttribute("data-article", bookmarkData);

    var defaultIcon = document.createElement("img");
    defaultIcon.className = "bookmark-btn__icon bookmark-btn__icon--default";
    defaultIcon.src = "/icons/icon-bookmark-default.svg";
    defaultIcon.width = 24;
    defaultIcon.height = 24;
    defaultIcon.alt = "";
    defaultIcon.style.display = "none";

    var activeIcon = document.createElement("img");
    activeIcon.className = "bookmark-btn__icon bookmark-btn__icon--active";
    activeIcon.src = "/icons/icon-bookmark-active.svg";
    activeIcon.width = 24;
    activeIcon.height = 24;
    activeIcon.alt = "";

    bookmarkBtn.appendChild(defaultIcon);
    bookmarkBtn.appendChild(activeIcon);
    actionsDiv.appendChild(bookmarkBtn);

    photoDiv.appendChild(actionsDiv);
    photoLink.appendChild(photoDiv);

    // Content div
    var contentDiv = document.createElement("div");
    contentDiv.className = "article-card__content";

    // Header div
    var headerDiv = document.createElement("div");
    headerDiv.className = "article-card__header";

    // Title link
    var titleLink = document.createElement("a");
    titleLink.href = href;
    titleLink.className = "article-card__title-link";

    var titleEl = document.createElement("h3");
    titleEl.className = "article-card__title";
    titleEl.textContent = title;

    titleLink.appendChild(titleEl);

    // Arrow SVG
    var arrowSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    arrowSvg.setAttribute("class", "article-card__arrow");
    arrowSvg.setAttribute("width", "11");
    arrowSvg.setAttribute("height", "11");
    arrowSvg.setAttribute("viewBox", "0 0 11 11");
    arrowSvg.setAttribute("fill", "none");
    arrowSvg.setAttribute("aria-hidden", "true");

    var path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.setAttribute("d", "M1 10L10 1M10 1H3M10 1V8");
    path.setAttribute("stroke", "currentColor");
    path.setAttribute("stroke-width", "1.5");
    path.setAttribute("stroke-linecap", "round");
    path.setAttribute("stroke-linejoin", "round");

    arrowSvg.appendChild(path);

    headerDiv.appendChild(titleLink);
    headerDiv.appendChild(arrowSvg);
    contentDiv.appendChild(headerDiv);

    // Date
    var dateEl = document.createElement("p");
    dateEl.className = "article-card__date";
    dateEl.textContent = date;
    contentDiv.appendChild(dateEl);

    // Footer: badges + bookmark
    var footerDiv = document.createElement("div");
    footerDiv.className = "article-card__footer";

    var badgesDiv = document.createElement("div");
    badgesDiv.className = "article-card__badges";

    var sourceBadge = document.createElement("span");
    sourceBadge.className = "badge badge--filled";
    sourceBadge.textContent = source;

    var categoryBadge = document.createElement("span");
    categoryBadge.className = "badge badge--outlined";
    categoryBadge.textContent = category;

    badgesDiv.appendChild(sourceBadge);
    badgesDiv.appendChild(categoryBadge);
    footerDiv.appendChild(badgesDiv);

    contentDiv.appendChild(footerDiv);

    // Assemble article
    articleEl.appendChild(photoLink);
    articleEl.appendChild(contentDiv);

    return articleEl;
  }

  function clearGrid(grid) {
    while (grid.firstChild) {
      grid.removeChild(grid.firstChild);
    }
  }

  function renderGuardados() {
    var emptyState = document.getElementById("guardados-empty");
    var gridSection = document.getElementById("guardados-grid-section");
    var grid = document.getElementById("guardados-grid");

    if (!emptyState || !gridSection || !grid) return;

    var bookmarks = [];
    try {
      bookmarks = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
    } catch (e) {
      bookmarks = [];
    }

    // Clear grid safely
    clearGrid(grid);

    if (bookmarks.length === 0) {
      emptyState.style.display = "";
      gridSection.style.display = "none";
      return;
    }

    emptyState.style.display = "none";
    gridSection.style.display = "";

    var fragment = document.createDocumentFragment();
    bookmarks.forEach(function (bookmark) {
      fragment.appendChild(renderBookmarkCard(bookmark));
    });
    grid.appendChild(fragment);

    // Trigger Disqus to populate comment counts for the new cards
    if (window.refreshDisqusCount) {
      window.refreshDisqusCount();
    }
  }

  // Re-render only when a bookmark is removed on this page
  document.addEventListener("evminds:bookmark-change", function (e) {
    if (e.detail && e.detail.bookmarked === false) {
      renderGuardados();
    }
  });

  renderGuardados();
</script>

<style>
  /* News grid (same as index) */
  .news {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .news__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 36px;
    align-items: flex-start;
  }

  @media (max-width: 1024px) {
    .news__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .news__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

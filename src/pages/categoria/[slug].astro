---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Subheader from "@/components/Subheader.astro";
import CategoryFilter from "@/components/CategoryFilter.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import EmptyState from "@/components/EmptyState.astro";
import SkeletonCard from "@/components/SkeletonCard.astro";
import { formatDate } from "@/lib/date-utils";
import {
  getCategoryBySlug,
  getAllCategorySlugs,
  getCategorySlugByName,
} from "@/lib/categories";
import { getSourceBySlug } from "@/lib/sources";
import { supabase } from "@/lib/supabase";
import { getArticleUrl } from "@/lib/article-url";
import type { ArticleData } from "@/loaders/supabase-loader";

// Generate static paths for all categories
export async function getStaticPaths() {
  const categorySlugs = getAllCategorySlugs();
  return categorySlugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug!);

// If category not found, return 404
if (!category) {
  return Astro.redirect("/404");
}

// Get source filter from URL
const urlParams = new URL(Astro.request.url).searchParams;
const sourceParam = urlParams.get("source");
const sourceObj = sourceParam ? await getSourceBySlug(sourceParam) : undefined;
const activeSource = sourceObj ? sourceParam : null;

// Fetch articles filtered by category (and optionally source) directly from Supabase
let query = supabase
  .from("articles")
  .select("*, source:sources!inner(name, url)")
  .eq("category", category.name)
  .order("scraped_at", { ascending: false })
  .limit(23);

if (activeSource && sourceObj) {
  query = query.eq("source.name", sourceObj.name);
}

const { data: articleData } = await query;

const articles: ArticleData[] = (articleData || []).map((a: any) => {
  const source = Array.isArray(a.source) ? a.source[0] : a.source;
  return {
    id: a.id,
    slug: a.slug,
    title: a.title,
    excerpt: a.excerpt,
    image_url: a.image_url,
    article_url: a.article_url,
    category: a.category,
    published_at: new Date(a.published_at),
    scraped_at: new Date(a.scraped_at),
    source_name: source.name,
    source_url: source.url,
  };
});

// Get unique categories that have articles (for CategoryFilter)
const { data: categoryRows } = await supabase
  .from("articles")
  .select("category");
const availableCategorySlugs: string[] = Array.from(
  new Set(
    (categoryRows || [])
      .map((r: any) => r.category)
      .filter(Boolean)
      .map((name: string) => getCategorySlugByName(name))
      .filter((slug: string | undefined) => slug !== undefined) as string[]
  )
);

// Helper to map article to component props
function mapArticleToProps(article: ArticleData) {
  return {
    image: article.image_url || "/placeholder-image.jpg",
    title: article.title,
    date: formatDate(article.published_at.toISOString()),
    excerpt: article.excerpt,
    source: article.source_name,
    category: article.category,
    href: getArticleUrl(article.slug),
    identifier: article.id,
    articleId: article.id,
    articleSlug: article.slug,
    scraped_at: article.scraped_at.toISOString(),
  };
}

// Calculate initial cursor for pagination
const initialCursor =
  articles.length > 0
    ? articles[articles.length - 1].scraped_at.toISOString()
    : null;

// Page metadata
const pageTitle = `${category.name} - EVMinds`;
const pageDescription = `${category.description}. Últimas noticias sobre ${category.name.toLowerCase()} en EVMinds.`;

// Breadcrumbs for structured data
const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: category.name, url: `/categoria/${slug}` },
];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <main class="page">
    <Header />

    <!-- Subheader -->
    <Subheader subtitle={category.description} variant="category">
      <Fragment slot="title">{category.name}</Fragment>
      <CategoryFilter
        activeCategory={category.slug}
        availableCategorySlugs={availableCategorySlugs}
        activeSource={activeSource}
      />
    </Subheader>

    <!-- News grid -->
    {
      articles.length > 0 ? (
        <section class="news" aria-label={`Noticias sobre ${category.name}`}>
          <div id="articles-grid" class="news__grid">
            {articles.map((article) => (
              <ArticleCard {...mapArticleToProps(article)} />
            ))}
          </div>

          <!-- Loading skeletons -->
          <div id="loading-skeletons" class="news__grid" style="display: none;">
            <SkeletonCard />
            <SkeletonCard />
            <SkeletonCard />
          </div>
        </section>
      ) : (
        <EmptyState ctaLabel="Explorar artículos" ctaHref="/">
          Aún <strong>no hay artículos</strong> en esta categoría.
        </EmptyState>
      )
    }

    <!-- Footer -->
    <Footer availableCategorySlugs={availableCategorySlugs} />
  </main>
</BaseLayout>

<script
  is:inline
  define:vars={{
    initialCursor,
    categorySlug: category.slug,
    sourceSlug: activeSource,
  }}
>
  // Infinite scroll implementation with category and source filtering
  let cursor = initialCursor;
  let isLoading = false;
  let hasMore = true;
  let observer = null;

  // Get DOM elements
  const articlesGrid = document.getElementById("articles-grid");
  const loadingSkeletons = document.getElementById("loading-skeletons");

  /**
   * Get limit based on current breakpoint
   */
  function getLimitForBreakpoint() {
    const width = window.innerWidth;
    if (width < 768) return 10;
    if (width < 1024) return 16;
    return 20;
  }

  /**
   * Format date to Spanish locale
   */
  function formatDate(dateString) {
    var date = new Date(dateString);
    return date.toLocaleDateString("es-ES", {
      day: "numeric",
      month: "long",
      year: "numeric",
    });
  }

  /**
   * Render article card using safe DOM methods
   */
  function renderArticleCard(article) {
    const image = article.image_url || "/placeholder-image.jpg";
    const title = article.title;
    const date = formatDate(article.published_at);
    const source = article.source.name;
    const category = article.category;
    const href = '/articulo/' + article.slug;
    const identifier = article.id;

    // Create article element
    const articleEl = document.createElement("article");
    articleEl.className = "article-card";

    // Photo link
    const photoLink = document.createElement("a");
    photoLink.href = href;
    photoLink.className = "article-card__photo-link";

    const photoDiv = document.createElement("div");
    photoDiv.className = "article-card__photo";

    const img = document.createElement("img");
    img.src = image;
    img.alt = title;
    img.loading = "lazy";
    img.width = 600;
    img.height = 300;

    photoDiv.appendChild(img);

    // Hidden Disqus counter (visible badge created dynamically by cleanDisqusCounts)
    if (identifier) {
      const countSpan = document.createElement("span");
      countSpan.className = "disqus-comment-count";
      countSpan.setAttribute("data-disqus-identifier", identifier);
      countSpan.hidden = true;
      photoDiv.appendChild(countSpan);
    }

    photoLink.appendChild(photoDiv);

    // Content div
    const contentDiv = document.createElement("div");
    contentDiv.className = "article-card__content";

    // Header div
    const headerDiv = document.createElement("div");
    headerDiv.className = "article-card__header";

    // Title link
    const titleLink = document.createElement("a");
    titleLink.href = href;
    titleLink.className = "article-card__title-link";

    const titleEl = document.createElement("h3");
    titleEl.className = "article-card__title";
    titleEl.textContent = title;

    titleLink.appendChild(titleEl);

    // Arrow SVG
    const arrowSvg = document.createElementNS(
      "http://www.w3.org/2000/svg",
      "svg"
    );
    arrowSvg.setAttribute("class", "article-card__arrow");
    arrowSvg.setAttribute("width", "11");
    arrowSvg.setAttribute("height", "11");
    arrowSvg.setAttribute("viewBox", "0 0 11 11");
    arrowSvg.setAttribute("fill", "none");
    arrowSvg.setAttribute("aria-hidden", "true");

    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.setAttribute("d", "M1 10L10 1M10 1H3M10 1V8");
    path.setAttribute("stroke", "currentColor");
    path.setAttribute("stroke-width", "1.5");
    path.setAttribute("stroke-linecap", "round");
    path.setAttribute("stroke-linejoin", "round");

    arrowSvg.appendChild(path);

    headerDiv.appendChild(titleLink);
    headerDiv.appendChild(arrowSvg);

    contentDiv.appendChild(headerDiv);

    var excerptText = article.excerpt || "";

    // Date
    const dateEl = document.createElement("p");
    dateEl.className = "article-card__date";
    dateEl.textContent = date;
    contentDiv.appendChild(dateEl);

    // Footer: badges + bookmark
    const footerDiv = document.createElement("div");
    footerDiv.className = "article-card__footer";

    const badgesDiv = document.createElement("div");
    badgesDiv.className = "article-card__badges";

    const sourceBadge = document.createElement("span");
    sourceBadge.className = "badge badge--filled";
    sourceBadge.textContent = source;

    const categoryBadge = document.createElement("span");
    categoryBadge.className = "badge badge--outlined";
    categoryBadge.textContent = category;

    badgesDiv.appendChild(sourceBadge);
    badgesDiv.appendChild(categoryBadge);
    footerDiv.appendChild(badgesDiv);

    // Bookmark button
    var bookmarkBtn = document.createElement("button");
    bookmarkBtn.className = "bookmark-btn";
    bookmarkBtn.setAttribute("data-article-id", identifier);
    bookmarkBtn.setAttribute("aria-label", "Guardar artículo");
    bookmarkBtn.setAttribute("aria-pressed", "false");

    var bookmarkData = JSON.stringify({
      id: identifier,
      slug: article.slug,
      title: title,
      excerpt: excerptText,
      image_url: image,
      scraped_at: article.scraped_at || "",
      source_name: source,
      category: category,
      savedAt: ""
    });
    bookmarkBtn.setAttribute("data-article", bookmarkData);

    var defaultIcon = document.createElement("img");
    defaultIcon.className = "bookmark-btn__icon bookmark-btn__icon--default";
    defaultIcon.src = "/icon-bookmark-default.svg";
    defaultIcon.width = 24;
    defaultIcon.height = 24;
    defaultIcon.alt = "";

    var activeIcon = document.createElement("img");
    activeIcon.className = "bookmark-btn__icon bookmark-btn__icon--active";
    activeIcon.src = "/icon-bookmark-active.svg";
    activeIcon.width = 24;
    activeIcon.height = 24;
    activeIcon.alt = "";
    activeIcon.style.display = "none";

    // Check initial bookmark state
    if (window.__evminds_bookmarks && window.__evminds_bookmarks.isBookmarked(identifier)) {
      defaultIcon.style.display = "none";
      activeIcon.style.display = "";
      bookmarkBtn.setAttribute("aria-pressed", "true");
    }

    bookmarkBtn.appendChild(defaultIcon);
    bookmarkBtn.appendChild(activeIcon);
    footerDiv.appendChild(bookmarkBtn);

    contentDiv.appendChild(footerDiv);

    // Assemble article
    articleEl.appendChild(photoLink);
    articleEl.appendChild(contentDiv);

    return articleEl;
  }

  /**
   * Fetch next page of articles with category filter
   */
  async function loadMoreArticles() {
    if (isLoading || !hasMore || !cursor) return;

    isLoading = true;
    loadingSkeletons.style.display = "grid";

    try {
      const limit = getLimitForBreakpoint();
      let url = `/api/articles?limit=${limit}&cursor=${encodeURIComponent(cursor)}&category=${encodeURIComponent(categorySlug)}`;

      // Add source filter if present
      if (sourceSlug) {
        url += `&source=${encodeURIComponent(sourceSlug)}`;
      }

      const response = await fetch(url);

      if (!response.ok) {
        throw new Error("Failed to fetch articles");
      }

      const data = await response.json();

      // Hide loading skeletons
      loadingSkeletons.style.display = "none";

      if (data.articles.length === 0) {
        hasMore = false;
        if (observer) observer.disconnect();
        return;
      }

      // Render new articles
      const fragment = document.createDocumentFragment();

      data.articles.forEach((article) => {
        const cardEl = renderArticleCard(article);
        fragment.appendChild(cardEl);
      });

      articlesGrid.appendChild(fragment);

      // Refresh Disqus comment counts for new articles
      if (window.DISQUSWIDGETS) {
        window.DISQUSWIDGETS.getCount({ reset: true });
        // Clean up count text after Disqus updates
        setTimeout(function() {
          if (window.cleanDisqusCounts) window.cleanDisqusCounts();
        }, 500);
      }

      // Update cursor
      cursor = data.nextCursor;

      // If no more articles, disconnect observer
      if (!data.nextCursor) {
        hasMore = false;
        if (observer) observer.disconnect();
      } else {
        // Re-observe the new second-to-last card
        setupObserver();
      }
    } catch (error) {
      console.error("Error loading articles:", error);
      loadingSkeletons.style.display = "none";
    } finally {
      isLoading = false;
    }
  }

  /**
   * Setup IntersectionObserver on second-to-last card
   */
  function setupObserver() {
    if (observer) observer.disconnect();

    const cards = articlesGrid?.querySelectorAll(".article-card");
    if (!cards || cards.length < 2) return;

    const targetCard = cards[cards.length - 2];

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadMoreArticles();
          }
        });
      },
      {
        rootMargin: "200px",
        threshold: 0.1,
      }
    );

    observer.observe(targetCard);
  }

  // Initialize observer
  if (articlesGrid && cursor && hasMore) {
    setupObserver();
  }

  // Re-setup on resize
  let resizeTimer;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (hasMore && !isLoading) {
        setupObserver();
      }
    }, 250);
  });
</script>

<style>
  .page {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 48px 48px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    background-color: var(--sepia-light);
    min-height: 100vh;
  }

  /* News grid */
  .news {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .news__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
    align-items: flex-start;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .news__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .page {
      padding: 0 12px 48px;
    }

    .news {
      gap: 48px;
    }

    .news__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

  }
</style>

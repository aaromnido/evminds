---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Subheader from "@/components/Subheader.astro";
import CategoryFilter from "@/components/CategoryFilter.astro";
import NewsCard from "@/components/NewsCard.astro";
import EmptyState from "@/components/EmptyState.astro";
import NewsGrid from "@/components/NewsGrid.astro";
import InfiniteScrollConfig from "@/components/InfiniteScrollConfig.astro";
import { getCategoryBySlug, getAllCategorySlugs } from "@/lib/categories";
import { getSourceBySlug } from "@/lib/sources";
import { supabase } from "@/lib/supabase";
import { readPrefsFromCookie } from "@/lib/preferences";
import {
  ARTICLE_SELECT,
  INITIAL_ARTICLES_LIMIT,
  normalizeArticles,
  mapArticleToProps,
  getAvailableCategorySlugs,
} from "@/lib/article-utils";

// Generate static paths for all categories
export async function getStaticPaths() {
  const categorySlugs = getAllCategorySlugs();
  return categorySlugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug!);

// If category not found, return 404
if (!category) {
  return Astro.redirect("/404");
}

// Get source filter from URL
const urlParams = new URL(Astro.request.url).searchParams;
const sourceParam = urlParams.get("source");
const sourceObj = sourceParam ? await getSourceBySlug(sourceParam) : undefined;
const activeSource = sourceObj ? sourceParam : null;

// Fetch articles + categories in parallel
let articlesQuery = supabase
  .from("articles")
  .select(ARTICLE_SELECT)
  .eq("content_type", "news")
  .eq("category", category.name)
  .order("scraped_at", { ascending: false })
  .limit(INITIAL_ARTICLES_LIMIT);

if (activeSource && sourceObj) {
  articlesQuery = articlesQuery.eq("source.name", sourceObj.name);
}

// Apply user preference exclusions
const prefs = readPrefsFromCookie(Astro.request.headers.get("cookie"));
if (prefs.excludedSources.length > 0) {
  for (const name of prefs.excludedSources) {
    articlesQuery = articlesQuery.neq("source.name", name);
  }
}
if (prefs.excludedCategories.length > 0) {
  articlesQuery = articlesQuery.not("category", "in", `(${prefs.excludedCategories.join(",")})`);
}
if (prefs.onlyWithComments) {
  articlesQuery = articlesQuery.eq("has_comments", true);
}

const [{ data: articleData }, { data: categoryRows }] = await Promise.all([
  articlesQuery,
  supabase.from("articles").select("category").eq("content_type", "news"),
]);

const articles = normalizeArticles(articleData);
const availableCategorySlugs = getAvailableCategorySlugs(categoryRows);

// Calculate initial cursor for pagination
const initialCursor =
  articles.length > 0
    ? articles[articles.length - 1].scraped_at.toISOString()
    : null;

// Page metadata
const pageTitle = `${category.name} - EVMinds`;
const pageDescription = `${category.description}. Últimas noticias sobre ${category.name.toLowerCase()} en EVMinds.`;

// Breadcrumbs for structured data
const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: category.name, url: `/categoria/${slug}` },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
>
  <PageLayout variant="compact">
    <Header />

    <!-- Subheader -->
    <Subheader subtitle={category.description} variant="category">
      <Fragment slot="title">{category.name}</Fragment>
      <CategoryFilter
        activeCategory={category.slug}
        availableCategorySlugs={availableCategorySlugs}
        activeSource={activeSource}
      />
    </Subheader>

    <!-- News grid -->
    {
      articles.length > 0 ? (
        <NewsGrid ariaLabel={`Noticias sobre ${category.name}`} showSkeletons>
          {articles.map((article) => (
            <NewsCard {...mapArticleToProps(article)} />
          ))}
        </NewsGrid>
      ) : (
        <EmptyState ctaLabel="Explorar artículos" ctaHref="/">
          Aún <strong>no hay artículos</strong> en esta categoría.
        </EmptyState>
      )
    }

    <!-- Footer -->
    <Footer availableCategorySlugs={availableCategorySlugs} />
  </PageLayout>
</BaseLayout>

<InfiniteScrollConfig
  cursor={initialCursor || ""}
  category={category.slug}
  source={activeSource || ""}
/>


---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<BaseLayout>
  <main class="page">
    <Header />

    <!-- Hero Section -->
    <section class="hero">
      <h1 class="hero__title">
        De <strong>aficionado</strong> a <strong>aficionado</strong>
      </h1>
      <p class="hero__subtitle">
        Una historia sobre coches eléctricos, comunidad y devolver lo recibido
      </p>
    </section>

    <!-- Hero Image -->
    <div class="hero-image">
      <img
        src="/foto.webp"
        alt="Fernando Val con su coche eléctrico"
        class="hero-image__img"
      />
    </div>

    <!-- Content Section -->
    <section class="content">
      <div class="content__main">
        <div class="content__text">
          <p class="content__paragraph">
            Hace años que los <strong>coches eléctricos</strong> dejaron de ser solo
            un interés para convertirse en una pasión. Lo que empezó como curiosidad
            por la tecnología se transformó en horas de lectura, comparativas, debates...
            y sobre todo, <strong>amigos</strong>.
          </p>

          <p class="content__paragraph">
            En los comentarios de <strong>forococheselectricos.com</strong> y otros
            medios, encontré una comunidad increíble. Gente apasionada, informada,
            dispuesta a compartir experiencias y ayudar. He aprendido más de esas
            conversaciones que de cualquier manual.
          </p>

          <p class="content__paragraph">
            Como <strong>profesional IT</strong>, siempre he creído que la
            tecnología debe servir a las personas. Y después de tantos años
            recibiendo conocimiento, consejos y amistad de esta comunidad, sentí
            que era el momento de <strong>devolver algo</strong>.
          </p>

          <p class="content__paragraph">
            Y entonces, en uno de esos debates interminables que tanto nos
            gustan, surgió la idea. Gracias a <strong
              >José Luis el del Picasso</strong
            >, que con su entusiasmo contagioso, sin el saberlo, me inspiró para
            dar el paso. Sin él, evminds probablemente seguiría siendo solo una
            idea en mi cabeza.
          </p>

          <p class="content__paragraph">
            Así nació <strong>evminds</strong>: un agregador de noticias sobre
            movilidad eléctrica y sostenible. No es un proyecto comercial ni una
            gran startup. Es simplemente mi forma de <strong
              >aportar mi granito de arena</strong
            > a una comunidad que tanto me ha dado.
          </p>

          <!-- Signature -->
          <p>
            <strong>Fernando Val</strong>
          </p>

          <p class="content__paragraph content__paragraph--emphasis">
            Un lugar donde encontrar las noticias que nos importan, sin ruido,
            sin agendas. Solo información útil para seguir aprendiendo juntos.
          </p>
        </div>

        <!-- Call to Action -->
        <div class="cta">
          <div class="cta__content">
            <h2 class="cta__title">Sigamos debatiendo entre amigos</h2>
            <p class="cta__text">
              Únete al grupo de Telegram donde compartimos noticias, opiniones y
              seguimos construyendo comunidad.
            </p>
            <a
              href="https://t.me/evminders"
              target="_blank"
              rel="noopener noreferrer"
              class="cta__button"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"
                  fill="currentColor"></path>
              </svg>
              Unirse a @evminders
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <Footer />
  </main>
</BaseLayout>

<style>
  .page {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    background-color: var(--sepia-light);
    min-height: 100vh;
  }

  /* Hero Section */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 0;
  }

  .hero__title {
    font-family: "Playfair Display", serif;
    font-size: 56px;
    font-style: italic;
    font-weight: 300;
    line-height: 1.1;
    color: var(--navy-2);
    letter-spacing: -0.01em;
    width: 100%;
  }

  .hero__title strong {
    font-weight: 600;
  }

  .hero__subtitle {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 20px;
    font-weight: 400;
    color: var(--navy-2);
    opacity: 0.7;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  /* Hero Image */
  .hero-image {
    width: 100%;
    max-width: 1200px;
    margin: -24px auto 0;
    overflow: hidden;
    border-radius: 16px;
  }

  .hero-image__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-height: 500px;
  }

  /* Content Section */
  .content {
    max-width: 740px;
    margin: 0 auto;
    width: 100%;
  }

  .content__main {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  .content__text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .content__paragraph {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 19px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--navy-2);
    letter-spacing: -0.01em;
  }

  .content__paragraph strong {
    font-weight: 600;
  }

  .content__paragraph--emphasis {
    font-size: 21px;
    font-style: italic;
    font-weight: 500;
    padding: 32px 0;
    border-top: 1px solid rgba(25, 27, 65, 0.1);
    border-bottom: 1px solid rgba(25, 27, 65, 0.1);
    margin-top: 20px;
  }

  /* Call to Action */
  .cta {
    background: var(--navy-2);
    border-radius: 16px;
    padding: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cta__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    max-width: 500px;
  }

  .cta__title {
    font-family: "Playfair Display", serif;
    font-size: 32px;
    font-style: italic;
    font-weight: 600;
    line-height: 1.2;
    color: var(--sepia-light);
    letter-spacing: -0.01em;
  }

  .cta__text {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--sepia-light);
    opacity: 0.85;
  }

  .cta__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: var(--sepia-light);
    color: var(--navy-2);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 17px;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    margin-top: 12px;
  }

  .cta__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }

  .cta__button svg {
    width: 20px;
    height: 20px;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .hero__title {
      font-size: 42px;
    }

    .hero__subtitle {
      font-size: 18px;
    }

    .content__paragraph {
      font-size: 18px;
    }

    .content__paragraph--emphasis {
      font-size: 19px;
    }

    .cta {
      padding: 40px 32px;
    }

    .cta__title {
      font-size: 28px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .page {
      padding: 0 12px 72px;
      gap: 36px;
    }

    .hero {
      padding: 24px 0;
      gap: 16px;
    }

    .hero__title {
      font-size: 28px;
    }

    .hero__subtitle {
      font-size: 15px;
    }

    .hero-image {
      border-radius: 12px;
      margin: -18px -12px 0;
      width: calc(100% + 24px);
      max-width: none;
    }

    .hero-image__img {
      max-height: 300px;
    }

    .content__main {
      gap: 48px;
    }

    .content__text {
      gap: 24px;
    }

    .content__paragraph {
      font-size: 16px;
      line-height: 1.65;
    }

    .content__paragraph--emphasis {
      font-size: 17px;
      padding: 24px 0;
      margin-top: 8px;
    }

    .cta {
      padding: 32px 24px;
      border-radius: 12px;
    }

    .cta__title {
      font-size: 24px;
    }

    .cta__text {
      font-size: 15px;
    }

    .cta__button {
      padding: 14px 28px;
      font-size: 15px;
    }
  }
</style>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Subheader from "@/components/Subheader.astro";
import Badge from "@/components/Badge.astro";
import { supabase } from "@/lib/supabase";
import {
  parseWindow,
  parseContentFilter,
  countsForFilter,
  windowToSince,
  rankSources,
  TIME_WINDOWS,
  CONTENT_FILTERS,
  TONE_DEFINITIONS,
  MIN_SAMPLE,
  type SourceToneCounts,
} from "@/lib/headline-tone";
import { toDisplayName } from "@/lib/sources";

const periodo = parseWindow(Astro.url.searchParams.get("periodo"));
const tipo = parseContentFilter(Astro.url.searchParams.get("tipo"));
const year = new Date().getFullYear();

// Precompute every (window × content-type) view server-side so both client
// filters swap data instantly (no reload): each combination is rendered into its
// own panel, hidden except the active one. The RPC returns tone counts per source
// broken down by content type, so the three type-views are derived here from the
// same four window queries (no extra DB round-trips). Score/color/award are
// computed here.
const datasets = await Promise.all(
  TIME_WINDOWS.map(async (w) => {
    const { data, error } = await supabase.rpc(
      "source_headline_ranking",
      { p_since: windowToSince(w.key) },
    );
    if (error) {
      console.error("source_headline_ranking RPC failed:", error.message);
    }
    const rows = (error ? [] : (data ?? [])) as SourceToneCounts[];
    const views = CONTENT_FILTERS.map((f) => {
      // Project each source onto this content-type view, dropping sources with no
      // articles in it (e.g. video channels under the "Noticias" filter).
      const ranked = rankSources(
        rows.map((r) => countsForFilter(r, f.key)).filter((r) => r.n_total > 0),
      );
      return {
        filter: f.key,
        podium: ranked.filter((r) => r.enoughSample).slice(0, 3),
        // Full ranking, from #1: the podium sources are celebrated above as medals
        // but also appear here so the list reads as a complete classification.
        ranking: ranked,
      };
    });
    return { key: w.key, label: w.label, views };
  }),
);

const MEDALS = [
  { key: "gold", icon: "🥇", label: "Oro" },
  { key: "silver", icon: "🥈", label: "Plata" },
  { key: "bronze", icon: "🥉", label: "Bronce" },
] as const;

function pct(part: number, total: number): number {
  return total > 0 ? Math.round((part / total) * 100) : 0;
}
---

<BaseLayout
  title="Medios de Confianza — EVMinds | El semáforo de la honestidad"
  description="Clasificamos cada titular en honesto, hot o clickbait y reconocemos a los medios que informan sin cebo. Esta es nuestra apuesta editorial: sin clickbait, nunca."
  breadcrumbs={[
    { name: "Inicio", url: "/" },
    { name: "Medios de Confianza", url: "/medios-de-confianza" },
  ]}
  noIndex={true}
>
  <PageLayout>
    <Header />

    <div class="mdc__hero">
      <Subheader
        subtitle="Clasificamos el titular original de cada noticia y reconocemos a quien informa sin cebo."
      >
        <span slot="title">
          <strong>Medios de Confianza</strong>, el semáforo de la honestidad
        </span>
      </Subheader>
    </div>

    <!-- Filters (segmented button groups; JS swaps panels without reload) -->
    <div class="mdc__filters">
      <nav class="mdc__filter" data-mdc-group="periodo" aria-label="Periodo del ranking">
        {
          TIME_WINDOWS.map((w) => (
            <a
              href={`/medios-de-confianza?periodo=${w.key}&tipo=${tipo}`}
              data-value={w.key}
              class:list={["mdc__filter-item", { "mdc__filter-item--active": w.key === periodo }]}
              aria-current={w.key === periodo ? "true" : undefined}
            >
              {w.label}
            </a>
          ))
        }
      </nav>

      <nav class="mdc__filter" data-mdc-group="tipo" aria-label="Tipo de contenido">
        {
          CONTENT_FILTERS.map((f) => (
            <a
              href={`/medios-de-confianza?periodo=${periodo}&tipo=${f.key}`}
              data-value={f.key}
              class:list={["mdc__filter-item", { "mdc__filter-item--active": f.key === tipo }]}
              aria-current={f.key === tipo ? "true" : undefined}
            >
              {f.label}
            </a>
          ))
        }
      </nav>
    </div>

    {
      datasets.flatMap((d) =>
        d.views.map((v) => {
          const noun = v.filter === "video" ? "Canales" : "Medios";
          return (
        <div
          class="mdc__panel"
          data-mdc-panel={`${d.key}__${v.filter}`}
          hidden={!(d.key === periodo && v.filter === tipo)}
        >
          {v.podium.length > 0 ? (
            <section class="mdc__podium" aria-label={`${noun} más fiables del periodo`}>
              <p class="mdc__podium-kicker">
                🏆 {noun} más fiables {d.key === "year" ? year : `· ${d.label}`}
              </p>
              <ol class="mdc__podium-grid">
                {v.podium.map((s, i) => (
                  <li class:list={["mdc__medal", `mdc__medal--${MEDALS[i].key}`]}>
                    <span class="mdc__medal-icon" aria-hidden="true">{MEDALS[i].icon}</span>
                    <span class="mdc__medal-label">{MEDALS[i].label}</span>
                    <p class="mdc__medal-name">{toDisplayName(s.sourceName)}</p>
                    <div class="mdc__medal-badge">
                      <Badge
                        label={s.color ? TONE_DEFINITIONS[s.color].label.es : "Titular honesto"}
                        variant={s.color ?? "green"}
                      />
                    </div>
                    <p class="mdc__medal-stat">
                      {pct(s.counts.green, s.counts.total)}% honestos
                      <span class="mdc__medal-stat-sub"> · {s.counts.total} titulares</span>
                    </p>
                  </li>
                ))}
              </ol>
            </section>
          ) : (
            <section class="mdc__empty">
              <p class="mdc__empty-title">Aún estamos recopilando datos</p>
              <p class="mdc__empty-text">
                Clasificamos los titulares según se publican. En cuanto cada medio
                acumule al menos {MIN_SAMPLE} titulares en este periodo, aparecerá aquí su nota y
                entregaremos el reconocimiento a los más fiables.
              </p>
            </section>
          )}

          {v.ranking.length > 0 && (
            <section class="mdc__ranking" aria-label="Ranking de medios">
              <h2 class="mdc__section-title">Ranking completo</h2>
              <ol class="mdc__list">
                {v.ranking.map((s, i) => (
                  <li class="mdc__row">
                    <span class="mdc__rank">{i + 1}</span>
                    <span class:list={["mdc__dot", `mdc__dot--${s.color ?? "empty"}`]} aria-hidden="true" />
                    <span class="mdc__name">{toDisplayName(s.sourceName)}</span>
                    <span class="mdc__bar" role="img"
                      aria-label={`${s.counts.green} honestos, ${s.counts.amber} hot, ${s.counts.red} clickbait`}>
                      <span class="mdc__bar-seg mdc__bar-seg--green" style={`width:${pct(s.counts.green, s.counts.total)}%`} />
                      <span class="mdc__bar-seg mdc__bar-seg--amber" style={`width:${pct(s.counts.amber, s.counts.total)}%`} />
                      <span class="mdc__bar-seg mdc__bar-seg--red" style={`width:${pct(s.counts.red, s.counts.total)}%`} />
                    </span>
                    <span class="mdc__count">{s.counts.total}</span>
                  </li>
                ))}
              </ol>
            </section>
          )}
        </div>
          );
        }),
      )
    }

    <!-- Legend / methodology -->
    <section class="mdc__legend" aria-label="Cómo funciona">
      <h2 class="mdc__section-title">Cómo lo medimos</h2>
      <ul class="mdc__legend-list">
        <li><span class="mdc__dot mdc__dot--green" aria-hidden="true" /> <strong>Titular honesto.</strong> {TONE_DEFINITIONS.green.description.es}</li>
        <li><span class="mdc__dot mdc__dot--amber" aria-hidden="true" /> <strong>Titular hot.</strong> {TONE_DEFINITIONS.amber.description.es}</li>
        <li><span class="mdc__dot mdc__dot--red" aria-hidden="true" /> <strong>Titular clickbait.</strong> {TONE_DEFINITIONS.red.description.es}</li>
      </ul>
      <p class="mdc__legend-note">
        Evaluamos el titular original de cada fuente. Mostramos color solo a
        partir de {MIN_SAMPLE} titulares en el periodo, para que nadie quede señalado por azar.
        El ranking se reinicia cada año: borrón y cuenta nueva.
      </p>
    </section>

    <Footer />
  </PageLayout>
</BaseLayout>

<style>
  /* Center the hero (title + subtitle) on this page only; Subheader defaults to
     left-aligned and is shared, so override its internals via :global here. */
  .mdc__hero :global(.subheader) {
    align-items: center;
    text-align: center;
  }
  .mdc__hero :global(.subheader__row) {
    display: flex;
    justify-content: center;
  }
  .mdc__hero :global(.subheader__subtitle) {
    line-height: 1.4;
    text-align: center;
  }

  /* Filters — stacked segmented button groups (period + content type) */
  .mdc__filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 16px;
    margin: 0 auto 28px;
  }
  .mdc__filter {
    display: flex;
    width: fit-content;
    align-self: center;
    border: 1.5px solid var(--navy-2);
    border-radius: 75px;
    overflow: hidden;
  }
  .mdc__filter-item {
    display: flex;
    align-items: center;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 700;
    padding: 8px 18px;
    border-left: 1.5px solid var(--navy-2);
    color: var(--navy-2);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .mdc__filter-item:first-child {
    border-left: none;
  }
  .mdc__filter-item--active,
  .mdc__filter-item:hover {
    background-color: var(--navy-2);
    color: var(--ev-text-on-image);
  }

  /* Per-window panels: only one shown at a time (toggled client-side). Using
     display:contents lets the inner sections keep the parent .page flex rhythm.
     The [hidden] selector (two attributes) outweighs the base rule, so the
     inactive panels stay collapsed. */
  .mdc__panel {
    display: contents;
  }
  .mdc__panel[hidden] {
    display: none;
  }

  /* Podium (top 3) */
  .mdc__podium {
    margin-bottom: 40px;
  }
  .mdc__podium-kicker {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--navy-2);
    opacity: 0.85;
    margin: 0 0 28px;
    text-align: center;
  }
  .mdc__podium-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
  .mdc__medal {
    /* ~1/3 width so three medals fill the row, but fewer stay centered. */
    flex: 0 1 calc((100% - 32px) / 3);
    text-align: center;
    background-color: var(--sepia-light);
    border: 2px solid var(--ev-border-subtle);
    border-radius: 18px;
    padding: 24px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .mdc__medal--gold { border-color: #d4af37; }
  .mdc__medal--silver { border-color: #a8adb4; }
  .mdc__medal--bronze { border-color: #b08147; }
  .mdc__medal-icon { font-size: 34px; line-height: 1; }
  .mdc__medal-label {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
    color: var(--navy-2);
  }
  .mdc__medal-name {
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-weight: 700;
    font-size: 26px;
    line-height: 1.1;
    color: var(--navy-light);
    margin: 0;
  }
  .mdc__medal-badge { margin: 10px 0 2px; }
  .mdc__medal-stat {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--navy-2);
    margin: 0;
  }
  .mdc__medal-stat-sub {
    font-weight: 500;
    opacity: 0.7;
  }

  /* Empty state */
  .mdc__empty {
    text-align: center;
    border: 1.5px dashed var(--ev-border-subtle);
    border-radius: 20px;
    padding: 40px 24px;
    margin-bottom: 40px;
  }
  .mdc__empty-title {
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-size: 26px;
    color: var(--navy-light);
    margin: 0 0 10px;
  }
  .mdc__empty-text {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: var(--navy-2);
    max-width: 540px;
    margin: 0 auto;
    opacity: 0.85;
  }

  /* Sections */
  .mdc__section-title {
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-weight: 700;
    font-size: 24px;
    color: var(--navy-light);
    margin: 0 0 16px;
  }
  .mdc__section-title--muted {
    font-size: 18px;
    opacity: 0.7;
  }

  /* Ranking list */
  .mdc__ranking { margin-bottom: 40px; }
  .mdc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mdc__row {
    display: grid;
    grid-template-columns: 28px 16px 1fr minmax(120px, 200px) 44px;
    align-items: center;
    gap: 12px;
    padding: 12px 8px;
    border-bottom: 1px solid var(--ev-border-subtle);
    font-family: "Plus Jakarta Sans", sans-serif;
  }
  .mdc__rank {
    font-weight: 800;
    font-size: 14px;
    color: var(--navy-2);
    opacity: 0.6;
    text-align: center;
  }
  .mdc__name {
    font-weight: 700;
    font-size: 16px;
    color: var(--navy-2);
  }
  .mdc__count {
    font-size: 13px;
    font-weight: 600;
    color: var(--navy-2);
    opacity: 0.7;
    text-align: right;
  }

  /* Tone dot */
  .mdc__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--navy-2);
    box-sizing: border-box;
    flex: 0 0 auto;
    display: inline-block;
  }
  .mdc__dot--green { background-color: var(--ev-tone-green); }
  .mdc__dot--amber { background-color: var(--ev-tone-amber); }
  .mdc__dot--red { background-color: var(--ev-tone-red); }
  .mdc__dot--empty { background-color: var(--ev-tone-empty); }

  /* Stacked breakdown bar */
  .mdc__bar {
    display: flex;
    height: 10px;
    border-radius: 5px;
    overflow: hidden;
    background-color: var(--ev-border-subtle);
  }
  .mdc__bar-seg { height: 100%; }
  .mdc__bar-seg--green { background-color: var(--ev-tone-green); }
  .mdc__bar-seg--amber { background-color: var(--ev-tone-amber); }
  .mdc__bar-seg--red { background-color: var(--ev-tone-red); }

  /* Pending */
  .mdc__pending { margin-bottom: 40px; }
  .mdc__pending-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
  }
  .mdc__pending-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    color: var(--navy-2);
    opacity: 0.8;
  }
  .mdc__pending-count {
    font-size: 12px;
    opacity: 0.7;
  }

  /* Legend */
  .mdc__legend {
    background-color: var(--ev-bg-accent);
    border-radius: 20px;
    padding: 28px 28px 30px;
    color: var(--ev-text-on-image);
  }
  .mdc__legend .mdc__section-title { color: var(--ev-text-on-image); }
  .mdc__legend-list {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 15px;
    line-height: 1.5;
  }
  .mdc__legend-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .mdc__legend-list .mdc__dot { border-color: var(--ev-text-on-image); align-self: center; }
  .mdc__legend-note {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 13.5px;
    line-height: 1.6;
    opacity: 0.85;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .mdc__filters {
      flex-direction: column;
    }
    .mdc__row {
      grid-template-columns: 24px 14px 1fr 44px;
    }
    .mdc__bar { display: none; }
    .mdc__podium-grid {
      gap: 12px;
    }
    .mdc__medal {
      flex-basis: 100%;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px 12px;
    }
    .mdc__medal-name { font-size: 22px; flex-basis: 100%; }
  }
</style>

<script is:inline>
  // Client-side filters: every (period × content-type) combination is pre-rendered
  // as a hidden panel keyed "<periodo>__<tipo>", so switching either group is
  // instant (no reload, no network). Both navs feed a shared {periodo, tipo} state
  // and the matching panel is shown. Anchors keep their href as a no-JS fallback.
  // Re-binds on every View Transitions navigation.
  (function () {
    function initMdcFilters() {
      const navs = Array.from(
        document.querySelectorAll(".mdc__filter[data-mdc-group]"),
      );
      if (!navs.length || navs[0].dataset.bound) return;
      const panels = Array.from(document.querySelectorAll("[data-mdc-panel]"));

      // Seed state from whichever item starts active in each group.
      const state = {};
      navs.forEach(function (nav) {
        const active = nav.querySelector(".mdc__filter-item--active");
        if (active) state[nav.dataset.mdcGroup] = active.dataset.value;
      });

      function apply() {
        const key = state.periodo + "__" + state.tipo;
        panels.forEach(function (p) {
          p.hidden = p.dataset.mdcPanel !== key;
        });
      }

      navs.forEach(function (nav) {
        nav.dataset.bound = "1";
        const buttons = Array.from(nav.querySelectorAll(".mdc__filter-item"));
        const group = nav.dataset.mdcGroup;
        nav.addEventListener("click", function (e) {
          const link = e.target.closest(".mdc__filter-item");
          if (!link) return;
          e.preventDefault();
          const value = link.dataset.value;
          state[group] = value;
          buttons.forEach(function (b) {
            const on = b.dataset.value === value;
            b.classList.toggle("mdc__filter-item--active", on);
            if (on) b.setAttribute("aria-current", "true");
            else b.removeAttribute("aria-current");
          });
          apply();
          const url = new URL(window.location.href);
          url.searchParams.set(group, value);
          window.history.replaceState(null, "", url);
        });
      });
    }
    document.addEventListener("astro:page-load", initMdcFilters);
  })();
</script>

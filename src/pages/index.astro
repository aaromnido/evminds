---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Subheader from "@/components/Subheader.astro";
import CategoryFilter from "@/components/CategoryFilter.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import SkeletonCard from "@/components/SkeletonCard.astro";
import FeaturedPrimary from "@/components/FeaturedPrimary.astro";
import FeaturedSecondary from "@/components/FeaturedSecondary.astro";
import { formatDate } from "@/lib/date-utils";
import { getCategorySlugByName } from "@/lib/categories";
import { getSourceBySlug } from "@/lib/sources";
import { supabase } from "@/lib/supabase";
import type { ArticleData } from "@/loaders/supabase-loader";

// Get source filter from URL
const urlParams = new URL(Astro.request.url).searchParams;
const sourceParam = urlParams.get("source");
const sourceObj = sourceParam ? await getSourceBySlug(sourceParam) : undefined;
const activeSource = sourceObj ? sourceParam : null;

// Fetch initial articles directly from Supabase
let query = supabase
  .from("articles")
  .select("*, source:sources!inner(name, url)")
  .order("scraped_at", { ascending: false })
  .limit(23);

if (activeSource && sourceObj) {
  query = query.eq("source.name", sourceObj.name);
}

const { data: articleData } = await query;

const articles: ArticleData[] = (articleData || []).map((a: any) => {
  const source = Array.isArray(a.source) ? a.source[0] : a.source;
  return {
    id: a.id,
    title: a.title,
    excerpt: a.excerpt,
    image_url: a.image_url,
    article_url: a.article_url,
    category: a.category,
    published_at: new Date(a.published_at),
    scraped_at: new Date(a.scraped_at),
    source_name: source.name,
    source_url: source.url,
  };
});

// Get unique categories that have articles (for CategoryFilter)
const { data: categoryRows } = await supabase
  .from("articles")
  .select("category");
const availableCategorySlugs: string[] = Array.from(
  new Set(
    (categoryRows || [])
      .map((r: any) => r.category)
      .filter(Boolean)
      .map((name: string) => getCategorySlugByName(name))
      .filter((slug: string | undefined) => slug !== undefined) as string[]
  )
);

// Featured primary — exclude hibridosyelectricos (small images)
const EXCLUDED_FROM_PRIMARY = "hibridosyelectricos.com";
const primaryIndex = articles.findIndex((a) => a.source_name !== EXCLUDED_FROM_PRIMARY);
const featuredPrimary = primaryIndex >= 0 ? articles[primaryIndex] : articles[0];

// Secondary and grid: everything else in order
const remaining = articles.filter((_, i) => i !== primaryIndex);
const featuredSecondary1 = remaining[0];
const featuredSecondary2 = remaining[1];
const gridArticles = remaining.slice(2);

// Helper to map article to component props
function mapArticleToProps(article: ArticleData) {
  return {
    image: article.image_url || "/placeholder-image.jpg",
    title: article.title,
    date: formatDate(article.published_at.toISOString()),
    excerpt: article.excerpt,
    source: article.source_name,
    category: article.category,
    href: article.article_url,
  };
}

// Calculate initial cursor for pagination (scraped_at of last article)
const initialCursor = articles.length > 0 ? articles[articles.length - 1].scraped_at.toISOString() : null;
---

<BaseLayout>
  <main class="page">
    <Header />

    <!-- Subheader -->
    <Subheader subtitle="Aquí encontrarás noticias, análisis, recursos, y una comunidad entorno a la movilidad eléctrica y las energías renovables">
      <Fragment slot="title">
        Un punto de encuentro para <strong>mentes inquietas</strong> y <strong>eléctricas</strong>
      </Fragment>
      <CategoryFilter
        availableCategorySlugs={availableCategorySlugs}
        activeSource={activeSource}
      />
    </Subheader>

    <!-- Featured news -->
    {
      featuredPrimary && (
        <section class="featured" aria-label="Noticias destacadas">
          <FeaturedPrimary {...mapArticleToProps(featuredPrimary)} />

          <div class="featured__right">
            {featuredSecondary1 && (
              <FeaturedSecondary {...mapArticleToProps(featuredSecondary1)} />
            )}
            {featuredSecondary2 && (
              <FeaturedSecondary {...mapArticleToProps(featuredSecondary2)} />
            )}
          </div>
        </section>
      )
    }

    <!-- News grid -->
    {
      gridArticles.length > 0 && (
        <section class="news" aria-label="Últimas noticias">
          <div id="articles-grid" class="news__grid">
            {gridArticles.map((article) => (
              <ArticleCard {...mapArticleToProps(article)} />
            ))}
          </div>

          <!-- Loading skeletons -->
          <div id="loading-skeletons" class="news__grid" style="display: none;">
            <SkeletonCard />
            <SkeletonCard />
            <SkeletonCard />
          </div>
        </section>
      )
    }

    <!-- Footer -->
    <Footer availableCategorySlugs={availableCategorySlugs} />
  </main>
</BaseLayout>

<script is:inline define:vars={{ initialCursor, sourceSlug: activeSource }}>
  // Infinite scroll implementation with IntersectionObserver
  let cursor = initialCursor;
  let isLoading = false;
  let hasMore = true;
  let observer = null;

  // Get DOM elements
  const articlesGrid = document.getElementById("articles-grid");
  const loadingSkeletons = document.getElementById("loading-skeletons");

  /**
   * Get limit based on current breakpoint
   * Mobile (<768px): 10 cards
   * Tablet (768-1024px): 16 cards
   * Desktop (>1024px): 20 cards
   */
  function getLimitForBreakpoint() {
    const width = window.innerWidth;
    if (width < 768) return 10;
    if (width < 1024) return 16;
    return 20;
  }

  /**
   * Format date to Spanish locale
   */
  function formatDate(dateString) {
    const date = new Date(dateString);
    const now = new Date();
    const diffTime = Math.abs(now - date);
    const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

    if (diffDays === 0) return "Hoy";
    if (diffDays === 1) return "Ayer";
    if (diffDays < 7) return `Hace ${diffDays} días`;

    return date.toLocaleDateString("es-ES", {
      day: "numeric",
      month: "short",
      year: "numeric",
    });
  }

  /**
   * Render article card using safe DOM methods (XSS-safe)
   */
  function renderArticleCard(article) {
    const image = article.image_url || "/placeholder-image.jpg";
    const title = article.title;
    const date = formatDate(article.published_at);
    const source = article.source.name;
    const category = article.category;
    const href = article.article_url;

    // Create article element
    const articleEl = document.createElement("article");
    articleEl.className = "article-card";

    // Photo link
    const photoLink = document.createElement("a");
    photoLink.href = href;
    photoLink.className = "article-card__photo-link";
    photoLink.target = "_blank";
    photoLink.rel = "noopener noreferrer";

    const photoDiv = document.createElement("div");
    photoDiv.className = "article-card__photo";

    const img = document.createElement("img");
    img.src = image;
    img.alt = title;
    img.loading = "lazy";
    img.width = 600;
    img.height = 300;

    photoDiv.appendChild(img);
    photoLink.appendChild(photoDiv);

    // Content div
    const contentDiv = document.createElement("div");
    contentDiv.className = "article-card__content";

    // Header div
    const headerDiv = document.createElement("div");
    headerDiv.className = "article-card__header";

    // Title link
    const titleLink = document.createElement("a");
    titleLink.href = href;
    titleLink.className = "article-card__title-link";
    titleLink.target = "_blank";
    titleLink.rel = "noopener noreferrer";

    const titleEl = document.createElement("h3");
    titleEl.className = "article-card__title";
    titleEl.textContent = title;

    const dateEl = document.createElement("p");
    dateEl.className = "article-card__date";
    dateEl.textContent = date;

    titleLink.appendChild(titleEl);
    titleLink.appendChild(dateEl);

    // Arrow SVG (static, safe)
    const arrowSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    arrowSvg.setAttribute("class", "article-card__arrow");
    arrowSvg.setAttribute("width", "11");
    arrowSvg.setAttribute("height", "11");
    arrowSvg.setAttribute("viewBox", "0 0 11 11");
    arrowSvg.setAttribute("fill", "none");
    arrowSvg.setAttribute("aria-hidden", "true");

    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.setAttribute("d", "M1 10L10 1M10 1H3M10 1V8");
    path.setAttribute("stroke", "#191b41");
    path.setAttribute("stroke-width", "1.5");
    path.setAttribute("stroke-linecap", "round");
    path.setAttribute("stroke-linejoin", "round");

    arrowSvg.appendChild(path);

    headerDiv.appendChild(titleLink);
    headerDiv.appendChild(arrowSvg);

    // Badges div
    const badgesDiv = document.createElement("div");
    badgesDiv.className = "article-card__badges";

    const sourceBadge = document.createElement("span");
    sourceBadge.className = "badge badge--filled";
    sourceBadge.textContent = source;

    const categoryBadge = document.createElement("span");
    categoryBadge.className = "badge badge--outlined";
    categoryBadge.textContent = category;

    badgesDiv.appendChild(sourceBadge);
    badgesDiv.appendChild(categoryBadge);

    // Assemble content
    contentDiv.appendChild(headerDiv);
    contentDiv.appendChild(badgesDiv);

    // Assemble article
    articleEl.appendChild(photoLink);
    articleEl.appendChild(contentDiv);

    return articleEl;
  }

  /**
   * Fetch next page of articles
   */
  async function loadMoreArticles() {
    if (isLoading || !hasMore || !cursor) return;

    isLoading = true;
    loadingSkeletons.style.display = "grid";

    try {
      const limit = getLimitForBreakpoint();
      let url = `/api/articles?limit=${limit}&cursor=${encodeURIComponent(cursor)}`;

      // Add source filter if present
      if (sourceSlug) {
        url += `&source=${encodeURIComponent(sourceSlug)}`;
      }

      const response = await fetch(url);

      if (!response.ok) {
        throw new Error("Failed to fetch articles");
      }

      const data = await response.json();

      // Hide loading skeletons
      loadingSkeletons.style.display = "none";

      if (data.articles.length === 0) {
        hasMore = false;
        if (observer) observer.disconnect();
        return;
      }

      // Render new articles using safe DOM methods
      const fragment = document.createDocumentFragment();

      data.articles.forEach((article) => {
        const cardEl = renderArticleCard(article);
        fragment.appendChild(cardEl);
      });

      articlesGrid.appendChild(fragment);

      // Update cursor for next load
      cursor = data.nextCursor;

      // If no more articles, disconnect observer
      if (!data.nextCursor) {
        hasMore = false;
        if (observer) observer.disconnect();
      } else {
        // Re-observe the new second-to-last card
        setupObserver();
      }
    } catch (error) {
      console.error("Error loading articles:", error);
      loadingSkeletons.style.display = "none";
    } finally {
      isLoading = false;
    }
  }

  /**
   * Setup IntersectionObserver on second-to-last card
   */
  function setupObserver() {
    if (observer) observer.disconnect();
    if (!articlesGrid) return;

    const cards = articlesGrid.querySelectorAll(".article-card");
    if (cards.length < 2) return;

    // Observe the second-to-last card
    const targetCard = cards[cards.length - 2];

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadMoreArticles();
          }
        });
      },
      {
        rootMargin: "200px", // Trigger 200px before card enters viewport
        threshold: 0.1,
      }
    );

    observer.observe(targetCard);
  }

  // Initialize observer on page load
  if (articlesGrid && cursor && hasMore) {
    setupObserver();
  }

  // Re-setup observer on window resize (breakpoint change)
  let resizeTimer;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (hasMore && !isLoading) {
        setupObserver();
      }
    }, 250);
  });
</script>

<style>
  .page {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 48px 48px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    background-color: var(--sepia-light);
    min-height: 100vh;
  }

  /* Featured section */
  .featured {
    display: grid;
    grid-template-columns: calc(66.667% - 8px) calc(33.333%);
    gap: 24px;
  }

  .featured__right {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* News grid */
  .news {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .news__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
    align-items: flex-start;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured__right {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .news__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .page {
      padding: 0 12px 48px;
    }

    .featured {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .featured__right {
      display: flex;
      flex-direction: column;
      gap: 48px;
    }

    .news {
      gap: 72px;
      margin-top: 24px;
    }

    .news__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

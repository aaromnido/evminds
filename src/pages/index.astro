---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Subheader from "@/components/Subheader.astro";
import CategoryFilter from "@/components/CategoryFilter.astro";
import NewsCard from "@/components/NewsCard.astro";
import NewsGrid from "@/components/NewsGrid.astro";
import InfiniteScrollConfig from "@/components/InfiniteScrollConfig.astro";
import FeaturedPrimary from "@/components/FeaturedPrimary.astro";
import FeaturedSecondary from "@/components/FeaturedSecondary.astro";
import EmptyState from "@/components/EmptyState.astro";
import { getSourceBySlug } from "@/lib/sources";
import { supabase } from "@/lib/supabase";
import { readPrefsFromCookie } from "@/lib/preferences";
import { getOwnArticles } from "@/lib/own-articles";
import { formatDate } from "@/lib/date-utils";
import { getArticleUrl } from "@/lib/article-url";
import {
  ARTICLE_SELECT,
  INITIAL_ARTICLES_LIMIT,
  normalizeArticles,
  mapArticleToProps,
  getAvailableCategorySlugs,
} from "@/lib/article-utils";

// Get source filter from URL
const urlParams = new URL(Astro.request.url).searchParams;
const sourceParam = urlParams.get("source");
const sourceObj = sourceParam ? await getSourceBySlug(sourceParam) : undefined;
const activeSource = sourceObj ? sourceParam : null;

// Read user preferences from cookie
const prefs = readPrefsFromCookie(Astro.request.headers.get("cookie"));

// Fetch initial articles + categories in parallel
let articlesQuery = supabase
  .from("articles")
  .select(ARTICLE_SELECT)
  .eq("content_type", "news")
  .order("scraped_at", { ascending: false })
  .limit(INITIAL_ARTICLES_LIMIT);

if (activeSource && sourceObj) {
  articlesQuery = articlesQuery.eq("source.name", sourceObj.name);
}

// Apply user preference exclusions
if (prefs.excludedSources.length > 0) {
  for (const name of prefs.excludedSources) {
    articlesQuery = articlesQuery.neq("source.name", name);
  }
}
if (prefs.excludedCategories.length > 0) {
  articlesQuery = articlesQuery.not("category", "in", `(${prefs.excludedCategories.join(",")})`);
}
if (prefs.onlyWithComments) {
  articlesQuery = articlesQuery.eq("has_comments", true);
}

const [{ data: articleData }, { data: categoryRows }, { data: videoData }] = await Promise.all([
  articlesQuery,
  supabase.rpc("get_article_categories", { p_content_type: "news" }),
  supabase
    .from("articles")
    .select(ARTICLE_SELECT)
    .eq("content_type", "video")
    .order("published_at", { ascending: false })
    .limit(1),
]);

const articles = normalizeArticles(articleData);
// get_article_categories() returns bare category names (SETOF text). Two
// casts: supabase-js types SETOF text as `string`, not `string[]` (the
// runtime data is an array — justified cast, see the admin call sites in
// noticias/new.astro); then wrap into the { category } row shape
// getAvailableCategorySlugs expects.
const availableCategorySlugs = getAvailableCategorySlugs(
  ((categoryRows ?? []) as string[]).map((category) => ({ category })),
);
const featuredVideos = normalizeArticles(videoData);

// Featured primary — exclude hibridosyelectricos (small images)
const EXCLUDED_FROM_PRIMARY = "hibridosyelectricos.com";
const primaryIndex = articles.findIndex((a) => a.source_name !== EXCLUDED_FROM_PRIMARY);
const featuredPrimary = primaryIndex >= 0 ? articles[primaryIndex] : articles[0];

// Secondary: most recent video (top) + latest own article or 2nd news (bottom)
const remaining = articles.filter((_, i) => i !== primaryIndex);
const featuredSecondary1 = featuredVideos[0];

// Fetch latest published own article for featured slot (.md + DB posts).
// Gated: A10 newsletter exclusivity window (48h) hides the freshest article
// from discovery surfaces while its direct URL keeps working.
const ownArticles = await getOwnArticles({ gated: true });
const latestArticle = ownArticles[0];

const featuredSecondary2 = latestArticle
  ? {
      image: latestArticle.image || "/images/placeholder-image.webp",
      title: latestArticle.title,
      date: formatDate(latestArticle.date.toISOString()),
      source: "EVMinds",
      category: latestArticle.category,
      href: getArticleUrl(latestArticle.slug),
      contentType: "article",
      excerpt: latestArticle.excerpt,
      identifier: `articulo-${latestArticle.slug}`,
      articleId: `articulo-${latestArticle.slug}`,
      articleSlug: latestArticle.slug,
      scraped_at: latestArticle.date.toISOString(),
    }
  : mapArticleToProps(remaining[0]);

// Grid: rest of news (skip first only if no own article took the featured slot)
const gridArticles = latestArticle ? remaining : remaining.slice(1);

// Calculate initial cursor for pagination (scraped_at of last article)
const initialCursor =
  articles.length > 0 ? articles[articles.length - 1].scraped_at.toISOString() : null;

const hasActivePrefs = prefs.excludedSources.length > 0 || prefs.excludedCategories.length > 0;
---

<BaseLayout
  title="EVMinds — Noticias de Movilidad Eléctrica y Coches Eléctricos"
  description="Agregador de noticias sobre movilidad eléctrica en español. Coches eléctricos, baterías, energías renovables e infraestructura de carga, todo en un solo lugar."
>
  <PageLayout variant="compact">
    <Header />

    <!-- Subheader -->
    <Subheader
      subtitle="Aquí encontrarás noticias, análisis, recursos, y una comunidad en torno a la movilidad eléctrica y las energías renovables"
    >
      <Fragment slot="title">
        Un punto de encuentro para <strong>mentes inquietas</strong> y <strong>eléctricas</strong>
      </Fragment>
      <CategoryFilter availableCategorySlugs={availableCategorySlugs} activeSource={activeSource} />
    </Subheader>

    {
      articles.length === 0 && hasActivePrefs ? (
        <EmptyState ctaLabel="Restablecer filtros" ctaHref="/">
          Sin resultados para tus preferencias.
          <>
            <br />
            <strong>Ajusta tus filtros</strong>
          </>{" "}
          para ver contenido.
        </EmptyState>
      ) : (
        <>
          {/* Featured news */}
          {featuredPrimary && (
            <section class="featured" aria-label="Noticias destacadas">
              <FeaturedPrimary {...mapArticleToProps(featuredPrimary)} />

              <div class="featured__right">
                {featuredSecondary2 && <FeaturedSecondary {...featuredSecondary2} badge="New" />}
                {featuredSecondary1 && (
                  <FeaturedSecondary
                    {...{ ...mapArticleToProps(featuredSecondary1), category: "Vídeo" }}
                  />
                )}
              </div>
            </section>
          )}

          {/* News grid */}
          {gridArticles.length > 0 && (
            <NewsGrid ariaLabel="Últimas noticias" showSkeletons>
              {gridArticles.map((article) => (
                <NewsCard {...mapArticleToProps(article)} />
              ))}
            </NewsGrid>
          )}
        </>
      )
    }

    {
      /* Resets preferences when the "empty state" CTA is clicked. Lives outside the
        ternary because the listener is safe to register unconditionally: it uses
        optional chaining and no-ops when .empty-state__cta isn't in the DOM. */
    }
    <script is:inline>
      document.querySelector(".empty-state__cta")?.addEventListener("click", function (e) {
        e.preventDefault();
        localStorage.removeItem("evminds-prefs");
        document.cookie = "evminds-prefs=;path=/;max-age=0";
        window.location.href = "/";
      });
    </script>

    <!-- Footer -->
    <Footer availableCategorySlugs={availableCategorySlugs} />
  </PageLayout>
</BaseLayout>

<InfiniteScrollConfig cursor={initialCursor || ""} source={activeSource || ""} />

<style>
  /* Featured section */
  .featured {
    display: grid;
    grid-template-columns: calc(66.667% - 8px) calc(33.333% - 16px);
    gap: 24px;
  }

  .featured__right {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured__right {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .featured {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .featured__right {
      display: flex;
      flex-direction: column;
      gap: 48px;
    }
  }
</style>

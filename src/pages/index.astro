---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Subheader from "@/components/Subheader.astro";
import CategoryFilter from "@/components/CategoryFilter.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import SkeletonCard from "@/components/SkeletonCard.astro";
import FeaturedPrimary from "@/components/FeaturedPrimary.astro";
import FeaturedSecondary from "@/components/FeaturedSecondary.astro";
import { formatDate } from "@/lib/date-utils";
import { getCategorySlugByName } from "@/lib/categories";
import { getSourceBySlug } from "@/lib/sources";
import { supabase } from "@/lib/supabase";
import { getArticleUrl } from "@/lib/article-url";
import type { ArticleData } from "@/loaders/supabase-loader";

// Get source filter from URL
const urlParams = new URL(Astro.request.url).searchParams;
const sourceParam = urlParams.get("source");
const sourceObj = sourceParam ? await getSourceBySlug(sourceParam) : undefined;
const activeSource = sourceObj ? sourceParam : null;

const INITIAL_ARTICLES_LIMIT = 24;

// Fetch initial articles + categories in parallel
const articleSelect = "id, slug, title, excerpt, image_url, article_url, category, published_at, scraped_at, source:sources!inner(name, url)";

let articlesQuery = supabase
  .from("articles")
  .select(articleSelect)
  .order("scraped_at", { ascending: false })
  .limit(INITIAL_ARTICLES_LIMIT);

if (activeSource && sourceObj) {
  articlesQuery = articlesQuery.eq("source.name", sourceObj.name);
}

const [{ data: articleData }, { data: categoryRows }] = await Promise.all([
  articlesQuery,
  supabase.from("articles").select("category"),
]);

const articles: ArticleData[] = (articleData || []).map((a: any) => {
  const source = Array.isArray(a.source) ? a.source[0] : a.source;
  return {
    id: a.id,
    slug: a.slug,
    title: a.title,
    excerpt: a.excerpt,
    image_url: a.image_url,
    article_url: a.article_url,
    category: a.category,
    published_at: new Date(a.published_at),
    scraped_at: new Date(a.scraped_at),
    source_name: source.name,
    source_url: source.url,
  };
});
const availableCategorySlugs: string[] = Array.from(
  new Set(
    (categoryRows || [])
      .map((r: any) => r.category)
      .filter(Boolean)
      .map((name: string) => getCategorySlugByName(name))
      .filter((slug: string | undefined) => slug !== undefined) as string[]
  )
);

// Featured primary — exclude hibridosyelectricos (small images)
const EXCLUDED_FROM_PRIMARY = "hibridosyelectricos.com";
const primaryIndex = articles.findIndex((a) => a.source_name !== EXCLUDED_FROM_PRIMARY);
const featuredPrimary = primaryIndex >= 0 ? articles[primaryIndex] : articles[0];

// Secondary and grid: everything else in order
const remaining = articles.filter((_, i) => i !== primaryIndex);
const featuredSecondary1 = remaining[0];
const featuredSecondary2 = remaining[1];
const gridArticles = remaining.slice(2);

// Helper to map article to component props
function mapArticleToProps(article: ArticleData) {
  return {
    image: article.image_url || "/placeholder-image.webp",
    title: article.title,
    date: formatDate(article.published_at.toISOString()),
    excerpt: article.excerpt,
    source: article.source_name,
    category: article.category,
    href: getArticleUrl(article.slug),
    identifier: article.id,
    articleId: article.id,
    articleSlug: article.slug,
    scraped_at: article.scraped_at.toISOString(),
  };
}

// Calculate initial cursor for pagination (scraped_at of last article)
const initialCursor = articles.length > 0 ? articles[articles.length - 1].scraped_at.toISOString() : null;
---

<BaseLayout
  title="EVMinds — Noticias de Movilidad Eléctrica y Coches Eléctricos"
  description="Agregador de noticias sobre movilidad eléctrica en español. Coches eléctricos, baterías, energías renovables e infraestructura de carga, todo en un solo lugar."
>
  <main class="page">
    <Header />

    <!-- Subheader -->
    <Subheader subtitle="Aquí encontrarás noticias, análisis, recursos, y una comunidad en torno a la movilidad eléctrica y las energías renovables">
      <Fragment slot="title">
        Un punto de encuentro para <strong>mentes inquietas</strong> y <strong>eléctricas</strong>
      </Fragment>
      <CategoryFilter
        availableCategorySlugs={availableCategorySlugs}
        activeSource={activeSource}
      />
    </Subheader>

    <!-- Featured news -->
    {
      featuredPrimary && (
        <section class="featured" aria-label="Noticias destacadas">
          <FeaturedPrimary {...mapArticleToProps(featuredPrimary)} />

          <div class="featured__right">
            {featuredSecondary1 && (
              <FeaturedSecondary {...mapArticleToProps(featuredSecondary1)} />
            )}
            {featuredSecondary2 && (
              <FeaturedSecondary {...mapArticleToProps(featuredSecondary2)} />
            )}
          </div>
        </section>
      )
    }

    <!-- News grid -->
    {
      gridArticles.length > 0 && (
        <section class="news" aria-label="Últimas noticias">
          <div id="articles-grid" class="news__grid">
            {gridArticles.map((article) => (
              <ArticleCard {...mapArticleToProps(article)} />
            ))}
          </div>

          <!-- Loading skeletons -->
          <div id="loading-skeletons" class="news__grid" style="display: none;">
            <SkeletonCard />
            <SkeletonCard />
            <SkeletonCard />
          </div>
        </section>
      )
    }

    <!-- Footer -->
    <Footer availableCategorySlugs={availableCategorySlugs} />
  </main>
</BaseLayout>

<div
  id="infinite-scroll-config"
  data-cursor={initialCursor || ""}
  data-source={activeSource || ""}
  hidden
></div>
<script>
  import "@/scripts/infinite-scroll";
</script>

<style>
  .page {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 48px 48px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    background-color: var(--sepia-light);
    min-height: 100vh;
  }

  /* Featured section */
  .featured {
    display: grid;
    grid-template-columns: calc(66.667% - 8px) calc(33.333% - 16px);
    gap: 24px;
  }

  .featured__right {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* News grid */
  .news {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .news__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 36px;
    align-items: flex-start;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured__right {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .news__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .page {
      padding: 0 12px 48px;
    }

    .featured {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .featured__right {
      display: flex;
      flex-direction: column;
      gap: 48px;
    }

    .news {
      gap: 72px;
      margin-top: 24px;
    }

    .news__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

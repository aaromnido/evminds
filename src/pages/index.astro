---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Badge from "@/components/Badge.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import FeaturedPrimary from "@/components/FeaturedPrimary.astro";
import FeaturedSecondary from "@/components/FeaturedSecondary.astro";
import { getLiveCollection } from "astro:content";
import { formatDate } from "@/lib/date-utils";
import type { ArticleData } from "@/loaders/supabase-loader";

// Fetch articles using Live Content Collections (runtime, not build-time)
const { entries, error } = await getLiveCollection("articles");

if (error) {
  console.error("Failed to fetch articles:", error);
}

// Extract article data from entries and limit to 12
const articles = entries?.slice(0, 12).map((entry) => entry.data) || [];

// Featured articles (top 3)
const featuredPrimary = articles[0];
const featuredSecondary1 = articles[1];
const featuredSecondary2 = articles[2];

// Grid articles (remaining)
const gridArticles = articles.slice(3);

// Helper to map article to component props
function mapArticleToProps(article: ArticleData) {
  return {
    image: article.image_url || "/placeholder-image.jpg",
    title: article.title,
    date: formatDate(article.published_at.toISOString()),
    excerpt: article.excerpt,
    source: article.source_name,
    category: article.category,
    href: article.article_url,
  };
}
---

<BaseLayout>
  <main class="page">
    <Header />

    <!-- Subheader -->
    <section class="subheader">
      <h1 class="subheader__title">
        Un punto de encuentro para <strong>mentes inquietas</strong> y <strong
          >eléctricas</strong
        >
      </h1>
      <p class="subheader__subtitle">
        Aquí encontrarás noticias, análisis, recursos, y una comunidad entorno a
        la movilidad eléctrica y las energías renovables
      </p>
    </section>

    <!-- Featured news -->
    {
      featuredPrimary && (
        <section class="featured" aria-label="Noticias destacadas">
          <FeaturedPrimary {...mapArticleToProps(featuredPrimary)} />

          <div class="featured__right">
            {featuredSecondary1 && (
              <FeaturedSecondary {...mapArticleToProps(featuredSecondary1)} />
            )}
            {featuredSecondary2 && (
              <FeaturedSecondary {...mapArticleToProps(featuredSecondary2)} />
            )}
          </div>
        </section>
      )
    }

    <!-- News grid -->
    {
      gridArticles.length > 0 && (
        <section class="news" aria-label="Últimas noticias">
          {[0, 1, 2].map((row) => {
            const rowArticles = gridArticles.slice(row * 3, row * 3 + 3);
            return (
              rowArticles.length > 0 && (
                <div class="news__row">
                  {rowArticles.map((article) => (
                    <ArticleCard {...mapArticleToProps(article)} />
                  ))}
                </div>
              )
            );
          })}
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .page {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 48px 48px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    background-color: var(--sepia-light);
    min-height: 100vh;
  }

  /* Subheader */
  .subheader {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 1105px;
  }

  .subheader__title {
    font-family: "Playfair Display", serif;
    font-size: 48px;
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    color: var(--navy-2);
    letter-spacing: -0.01em;
  }

  .subheader__title strong {
    font-weight: 600;
  }

  .subheader__subtitle {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: var(--navy-2);
    letter-spacing: -0.01em;
    line-height: 1;
  }

  /* Featured section */
  .featured {
    display: grid;
    grid-template-columns: calc(66.667% - 8px) calc(33.333%);
    gap: 24px;
  }

  .featured__right {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* News grid */
  .news {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .news__row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
    align-items: flex-start;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured__right {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .news__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .page {
      padding: 0 12px 48px;
    }

    .subheader__title {
      font-size: 24px;
    }

    .subheader__subtitle {
      font-size: 13.5px;
    }

    .featured {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .featured__right {
      display: flex;
      flex-direction: column;
      gap: 48px;
    }

    .news {
      gap: 72px;
      margin-top: 24px;
    }

    .news__row {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

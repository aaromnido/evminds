---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Subheader from "@/components/Subheader.astro";
import Select from "@/components/Select.astro";
import PreferencesDrawer from "@/components/PreferencesDrawer.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import NewsGrid from "@/components/NewsGrid.astro";
import InfiniteScrollConfig from "@/components/InfiniteScrollConfig.astro";
import EmptyState from "@/components/EmptyState.astro";
import { supabase } from "@/lib/supabase";
import { readPrefsFromCookie } from "@/lib/preferences";
import { loadSources, getSourceBySlug } from "@/lib/sources";
import {
  ARTICLE_SELECT,
  INITIAL_ARTICLES_LIMIT,
  normalizeArticles,
  mapArticleToProps,
  getAvailableCategorySlugs,
} from "@/lib/article-utils";

// Read channel filter from URL
const urlParams = new URL(Astro.request.url).searchParams;
const channelParam = urlParams.get("canal");

// Resolve channel source
const channelSource = channelParam ? await getSourceBySlug(channelParam) : null;
const activeChannel = channelSource ? channelParam : null;

// Read user preferences from cookie
const prefs = readPrefsFromCookie(Astro.request.headers.get("cookie"));

// Fetch YouTube channels for the dropdown (exclude those disabled in preferences)
const allSources = await loadSources();
const videoChannels = allSources.filter(
  (s) => s.feedType === "youtube" && !prefs.excludedSources.includes(s.name),
);

// Fetch initial videos + categories in parallel
let videosQuery = supabase
  .from("articles")
  .select(ARTICLE_SELECT)
  .eq("content_type", "video")
  .order("published_at", { ascending: false })
  .limit(INITIAL_ARTICLES_LIMIT);

// Apply channel filter from URL
if (channelSource) {
  videosQuery = videosQuery.eq("source.name", channelSource.name);
}

// Apply user preference exclusions
if (prefs.excludedSources.length > 0) {
  for (const name of prefs.excludedSources) {
    videosQuery = videosQuery.neq("source.name", name);
  }
}
if (prefs.excludedCategories.length > 0) {
  videosQuery = videosQuery.not("category", "in", `(${prefs.excludedCategories.join(",")})`);
}
if (prefs.onlyWithComments) {
  videosQuery = videosQuery.eq("has_comments", true);
}

const [{ data: videoData }, { data: categoryRows }] = await Promise.all([
  videosQuery,
  supabase.from("articles").select("category").eq("content_type", "video"),
]);

const videos = normalizeArticles(videoData);
const availableCategorySlugs = getAvailableCategorySlugs(categoryRows);

// Build channel select options
const channelOptions = [
  { label: "Todos los canales", href: "/videos", isActive: !activeChannel },
  ...videoChannels.map((ch) => ({
    label: ch.displayName,
    href: `/videos?canal=${ch.slug}`,
    slug: ch.slug,
    isActive: activeChannel === ch.slug,
  })),
];

const activeChannelLabel = activeChannel
  ? videoChannels.find((ch) => ch.slug === activeChannel)?.displayName
  : undefined;

// Calculate initial cursor for pagination
const initialCursor =
  videos.length > 0
    ? videos[videos.length - 1].published_at.toISOString()
    : null;

const hasActivePrefs = prefs.excludedSources.length > 0 || prefs.excludedCategories.length > 0;
---

<BaseLayout
  title="Vídeos — EVMinds"
  description="Los mejores vídeos sobre movilidad eléctrica, coches eléctricos, reviews y noticias EV en español e inglés."
>
  <PageLayout variant="compact">
    <Header />

    <Subheader
      subtitle="Reviews, noticias y análisis en vídeo sobre movilidad eléctrica"
    >
      <Fragment slot="title">
        Vídeos
      </Fragment>
      <nav class="channel-filter" aria-label="Filtrar por canal">
        <div class="channel-filter__wrapper">
          <Select
            label="Canales"
            activeLabel={activeChannelLabel}
            options={channelOptions}
            dataSelector="channel"
            minWidth="210px"
          />

          <button
            type="button"
            class="preferences-btn"
            data-tooltip="Personalizar"
            aria-label="Personalizar"
            data-open-drawer
          >
            <svg
              class="preferences-btn__icon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="4" y1="21" x2="4" y2="14"></line>
              <line x1="4" y1="10" x2="4" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12" y2="3"></line>
              <line x1="20" y1="21" x2="20" y2="16"></line>
              <line x1="20" y1="12" x2="20" y2="3"></line>
              <line x1="1" y1="14" x2="7" y2="14"></line>
              <line x1="9" y1="8" x2="15" y2="8"></line>
              <line x1="17" y1="16" x2="23" y2="16"></line>
            </svg>
            <span class="preferences-btn__label">Personalizar preferencias</span>
          </button>
        </div>
      </nav>
      <PreferencesDrawer />
    </Subheader>

    {videos.length === 0 && hasActivePrefs ? (
      <EmptyState ctaLabel="Restablecer filtros" ctaHref="/videos">
        Sin resultados para tus preferencias.<br /><strong>Ajusta tus filtros</strong> para ver contenido.
      </EmptyState>
      <script is:inline>
        document.querySelector('.empty-state__cta')?.addEventListener('click', function (e) {
          e.preventDefault();
          localStorage.removeItem('evminds-prefs');
          document.cookie = 'evminds-prefs=;path=/;max-age=0';
          window.location.href = '/videos';
        });
      </script>
    ) : videos.length === 0 ? (
      <EmptyState ctaLabel="Explorar artículos" ctaHref="/">
        Aún <strong>no hay vídeos</strong> disponibles. Pronto empezaremos a publicar contenido.
      </EmptyState>
    ) : (
      <NewsGrid ariaLabel="Últimos vídeos" showSkeletons>
        {videos.map((video) => (
          <ArticleCard {...mapArticleToProps(video)} />
        ))}
      </NewsGrid>
    )}

    <Footer availableCategorySlugs={availableCategorySlugs} />
  </PageLayout>
</BaseLayout>

<InfiniteScrollConfig
  cursor={initialCursor || ""}
  contentType="video"
  source={activeChannel || ""}
/>

<style>
  .channel-filter {
    flex-shrink: 0;
  }

  .channel-filter__wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 4px 0;
  }

  .preferences-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 42px;
    height: 42px;
    border-radius: 100px;
    border: 1.5px solid var(--navy-2);
    color: var(--navy-2);
    background-color: transparent;
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
    position: relative;
  }

  .preferences-btn__label {
    display: none;
  }

  .preferences-btn:hover {
    background-color: color-mix(in srgb, var(--navy-2) 5%, transparent);
  }

  .preferences-btn::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 10px);
    right: 0;
    background: var(--navy-2);
    color: var(--ev-text-on-image);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    padding: 6px 10px;
    border-radius: 6px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .preferences-btn::before {
    content: "";
    position: absolute;
    bottom: calc(100% - 2px);
    right: 12px;
    border: 6px solid transparent;
    border-top-color: var(--navy-2);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
    z-index: 1;
  }

  @media (hover: hover) {
    .preferences-btn:hover::after,
    .preferences-btn:hover::before {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (max-width: 768px) {
    .channel-filter {
      width: 100%;
    }

    .channel-filter__wrapper {
      flex-direction: column;
      gap: 10px;
    }

    .preferences-btn {
      width: 100%;
      height: auto;
      padding: 10px 18px;
      justify-content: center;
    }

    .preferences-btn__label {
      display: inline;
      font-family: "Plus Jakarta Sans", sans-serif;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: -0.01em;
    }

    .preferences-btn::after,
    .preferences-btn::before {
      display: none;
    }
  }
</style>

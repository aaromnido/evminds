---
/**
 * Redacción — step ① of the writing wizard: choose what to write about.
 *
 * The wizard belongs to "Redacción", not to "Ideas" (Fer, 2026-07-25): writing is
 * the process, and ideas are the raw material it starts from. The separate
 * "Ideas" section will list the bank of saved ideas and is not designed yet.
 *
 * PROTOTYPE (task A3, UI-first phase): fed by `editorial-mocks.ts`, not by
 * Supabase. The `editorial_candidates` table does not exist yet. To wire this up
 * for real, replace `buildMockIdeas(nowIso)` with the query and delete the mock
 * module. See `.claude/design/ai-editorial-agent-ui.md`.
 */
import AdminShell from "@/layouts/AdminShell.astro";
import PickIdeaStep from "@/components/admin/editorial/PickIdeaStep.tsx";
import WizardSteps from "@/components/admin/editorial/WizardSteps.tsx";
import { buildMockIdeas } from "@/lib/editorial-mocks";

// Single clock reference shared with the island, so the relative labels ("hace
// 6 h") render identically on the server and after hydration.
const nowIso = new Date().toISOString();
const ideas = buildMockIdeas(nowIso);
---

<AdminShell
  title="Redacción · Admin"
  pageTitle="Redacción"
  pageDescription="Elige sobre qué escribir: una propuesta del curador o un tema tuyo."
>
  <div class="flex flex-col gap-6">
    <WizardSteps current={1} />
    <PickIdeaStep client:load ideas={ideas} nowIso={nowIso} />
  </div>
</AdminShell>

---
import PickIdeaStep from "@/components/admin/editorial/PickIdeaStep.tsx";
import PiecesInProgress from "@/components/admin/editorial/PiecesInProgress.tsx";
import WizardSteps from "@/components/admin/editorial/WizardSteps.tsx";
/**
 * Redacción — step ① of the writing wizard: choose what to write about.
 *
 * **Lives at `/nueva` since phase 2b** (2026-07-27), because starting a piece is
 * an action and the section's landing belongs to what already exists.
 *
 * The wizard belongs to "Redacción", not to "Ideas" (Fer, 2026-07-25): writing is
 * the process, and ideas are the raw material it starts from. Since phase 7
 * (2026-07-28), "Ideas" is the section that holds everything durable about an
 * idea — this screen only shows today's fresh proposals.
 *
 * "Propuestas de hoy" is deliberately NOT fetched here — it goes through
 * `curate-ideas.ts` client-side, since that call may hit Gemini on a cache
 * miss and every other AI wait in this wizard already happens after the page
 * has painted.
 */
import AdminShell from "@/layouts/AdminShell.astro";
import { fetchPieceSummaries } from "@/lib/editorial-pieces";

// Single clock reference shared with the island, so the relative labels ("hace
// 6 h") render identically on the server and after hydration.
const nowIso = new Date().toISOString();

const PIECES_SHOWN = 3;
const supabase = Astro.locals.supabase;
const { pieces, total } = supabase
  ? await fetchPieceSummaries(supabase, { status: "in_progress", limit: PIECES_SHOWN })
  : { pieces: [], total: 0 };
---

<AdminShell
  title="Escribir · Admin"
  pageTitle="Escribir algo nuevo"
  pageDescription="Elige sobre qué escribir: una propuesta del curador o un tema tuyo."
>
  <div class="flex flex-col gap-6">
    <WizardSteps current={1} />
    <PickIdeaStep client:load nowIso={nowIso} />
    {
      /* Rendered with no `client:` directive — cards and links only, so it
        costs zero JavaScript. Below the proposals (Fer, 2026-07-29): picking
        today's topic is the reason you're on this screen, and a piece you
        already started is one click away either way via "Ver todas". */
    }
    <PiecesInProgress pieces={pieces} total={total} nowIso={nowIso} />
  </div>
</AdminShell>

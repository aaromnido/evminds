---
/**
 * Redacción — step ② for a piece that does NOT exist yet.
 *
 * Two entry routes:
 *   - `?idea=<id>` → arrived from a picked curator proposal (route A)
 *   - no params    → Fer's own topic, starting from scratch (route B)
 *
 * The brief of a piece that **does** exist is a different page — the piece's own
 * root, `/admin/redaccion/pieza/[id]` — because that one is a resource and this
 * one is not anything yet. Splitting them keeps each loader honest: this one
 * reads an idea, that one reads a row, and neither has to ask which case it is in.
 *
 * PROTOTYPE (task A3): the ideas are still `editorial-mocks.ts`.
 * See `.claude/design/ai-editorial-agent-ui.md`.
 *
 * The step indicator is rendered inside the island here (unlike step ①), because
 * choosing a second channel adds a fourth step to it live.
 */
import AdminShell from "@/layouts/AdminShell.astro";
import DefineAngleStep from "@/components/admin/editorial/DefineAngleStep.tsx";
import { buildMockIdeas } from "@/lib/editorial-mocks";

const ideaId = Astro.url.searchParams.get("idea");
const nowIso = new Date().toISOString();
const idea = ideaId ? buildMockIdeas(nowIso).find((i) => i.id === ideaId) : undefined;
---

<AdminShell
  title="Enfoque · Admin"
  pageTitle="Definir el enfoque"
  pageDescription={idea
    ? "Ajusta qué quieres contar y dónde se publica antes de generar el texto."
    : "Cuenta de qué quieres escribir y dónde se publica."}
>
  <DefineAngleStep client:load idea={idea ?? null} />
</AdminShell>

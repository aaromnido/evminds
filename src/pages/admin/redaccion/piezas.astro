---
/**
 * Redacción — every piece, open and finished.
 *
 * The other half of "Guardar borrador": a piece that saves and cannot be found
 * again is not saved in any way that matters. Step ① carries a capped block with
 * what is unfinished; this is where all of them live, and the only place a piece
 * can be deleted — deliberately, because nothing here expires on its own.
 *
 * It is also how a finished piece is reopened to move its date when Motor.es
 * moves theirs, which is the requirement that made durable drafts necessary.
 */
import AdminShell from "@/layouts/AdminShell.astro";
import PiecesList from "@/components/admin/editorial/PiecesList.tsx";
import { fetchPieceSummaries } from "@/lib/editorial-pieces";

const supabase = Astro.locals.supabase;
const nowIso = new Date().toISOString();
const { pieces } = supabase ? await fetchPieceSummaries(supabase) : { pieces: [] };
---

<AdminShell
  title="Piezas · Admin"
  pageTitle="Tus piezas"
  pageDescription="Todo lo que has empezado a escribir, terminado o no."
>
  <PiecesList client:load pieces={pieces} nowIso={nowIso} />
</AdminShell>

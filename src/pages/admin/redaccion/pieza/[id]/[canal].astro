---
/**
 * Redacción — steps ③ and ④: one channel of one piece.
 *
 * **The piece and the channel are the path** (phase 2b, 2026-07-27), and that is
 * the point: everything else this screen needs — the brief, which channels the
 * piece has, and the previous channel's date — comes from the row. The four query
 * parameters this page used to carry (`?pieza=`, `?canal=`, `?canales=`, `?idea=`,
 * `?fecha=`) are gone, and with them the class of bug that shipped twice: a
 * parameter that did not survive a navigation.
 *
 * A piece that does not exist, or a channel the piece was not created for, is a
 * redirect to the list rather than a guess — showing the wrong channel's screen
 * with an empty draft is indistinguishable from having lost the text.
 *
 * PROTOTYPE (task A3): the text is still generated by `editorial-mocks.ts` and
 * the AI image edit is a CSS filter. What is real from phase 2 on is the row.
 * And — confirmed by Fer, 2026-07-25 — there is no integration with Motor.es'
 * CMS: the text is copied by hand. See `.claude/design/ai-editorial-agent-ui.md`.
 */
import AdminShell from "@/layouts/AdminShell.astro";
import PublishChannelStep from "@/components/admin/editorial/PublishChannelStep.tsx";
import { getChannel, parseChannels } from "@/lib/editorial-channels";
import { channelDraftFromRow, type ChannelDraftStatus } from "@/lib/editorial-drafts";
import { piecesUrl } from "@/lib/editorial-routes";
import type { PublishChannel } from "@/lib/editorial-types";

const { id, canal } = Astro.params;
const supabase = Astro.locals.supabase;

const { data: piece } = supabase
  ? await supabase.from("editorial_pieces").select("*").eq("id", id!).maybeSingle()
  : { data: null };

if (!piece) return Astro.redirect(piecesUrl());

// The piece's own channel list is the only source now: no `?canales=` to be
// hand-edited into contradicting what the piece was created for.
const channels: PublishChannel[] = parseChannels(piece.channels.join(","));
const channel = channels.find((c) => c === canal);

// A channel this piece does not have is not a screen to fall back from.
if (!channel) return Astro.redirect(piecesUrl());

const spec = getChannel(channel);

const { data: draftRows } = supabase
  ? await supabase.from("editorial_channel_drafts").select("*").eq("piece_id", piece.id)
  : { data: null };

const currentRow = draftRows?.find((row) => row.channel === channel) ?? null;
const initialDraft = currentRow ? channelDraftFromRow(currentRow) : null;
const initialStatus = (currentRow?.status ?? "draft") as ChannelDraftStatus;

// Where this channel's date starts from when it has none of its own: the day the
// PREVIOUS channel is set to, a week earlier. Read from that channel's stored row,
// which is what made `?fecha=` unnecessary.
const previousChannel = channels[channels.indexOf(channel) - 1];
const previousChannelDate =
  draftRows?.find((row) => row.channel === previousChannel)?.publish_date ?? null;

// "Now", in Madrid, as two plain wall-clock strings. Computed here and not in the
// island for the reason the whole section follows: `Date` inside a hydrated
// component gives a different answer on the server than on the client. As strings
// they can be compared against what the native date input returns without parsing
// anything (see `isPublishDatePast`).
const now = new Date();
const madrid = { timeZone: "Europe/Madrid" } as const;
const todayInMadrid = new Intl.DateTimeFormat("en-CA", {
  ...madrid,
  dateStyle: "short",
}).format(now);
const nowHourInMadrid = new Intl.DateTimeFormat("en-GB", {
  ...madrid,
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
}).format(now);
---

<AdminShell
  title={`${spec.name} · Admin`}
  pageTitle={`Texto para ${spec.name}`}
  pageDescription={spec.needsCmsFields
    ? "Los campos de su CMS, en su mismo orden. Copia uno a uno y pégalos allí."
    : "Revisa el texto, elige la imagen y programa la publicación."}
>
  <PublishChannelStep
    client:load
    channel={channel}
    channels={channels}
    pieceId={piece.id}
    initialDraft={initialDraft}
    initialStatus={initialStatus}
    briefTitle={piece.brief_title}
    briefAngle={piece.brief_angle}
    briefSourceName={piece.source_name}
    briefSourceUrl={piece.source_url}
    todayInMadrid={todayInMadrid}
    nowHourInMadrid={nowHourInMadrid}
    previousChannelDate={previousChannelDate}
  />
</AdminShell>

---
/**
 * Redacción — steps ③ and ④: one screen per channel chosen in step ②.
 *
 * Which channel this screen is for comes from `?canal=`, and `?canales=` carries
 * the whole selection so the step indicator and the "next channel" hand-off know
 * how long the wizard is. Defaults to the first chosen channel.
 *
 * PROTOTYPE (task A3, UI-first phase): the draft, the AI image edit and the
 * hand-off are all simulated in `editorial-mocks.ts`. There is no
 * `external_collaboration_drafts` row yet, and — confirmed by Fer, 2026-07-25 —
 * there is no integration with Motor.es' CMS either: the text is copied by hand.
 * See `.claude/design/ai-editorial-agent-ui.md`.
 */
import AdminShell from "@/layouts/AdminShell.astro";
import PublishChannelStep from "@/components/admin/editorial/PublishChannelStep.tsx";
import { getChannel, parseChannels } from "@/lib/editorial-channels";
import { buildMockIdeas } from "@/lib/editorial-mocks";

const params = Astro.url.searchParams;
const channels = parseChannels(params.get("canales"));
const requested = params.get("canal");
const channel = channels.find((c) => c === requested) ?? channels[0];
const spec = getChannel(channel);

// The brief would travel in the draft row; until that exists, it is rebuilt from
// the idea so the generated text is about the right thing.
const ideaId = params.get("idea");
const nowIso = new Date().toISOString();
const idea = ideaId ? buildMockIdeas(nowIso).find((i) => i.id === ideaId) : undefined;
---

<AdminShell
  title={`${spec.name} · Admin`}
  pageTitle={`Texto para ${spec.name}`}
  pageDescription={spec.handoff === "copy"
    ? "Revisa el texto, elige la imagen y cópialo a su CMS."
    : "Revisa el texto, elige la imagen y programa la publicación."}
>
  <PublishChannelStep
    client:load
    channel={channel}
    channels={channels}
    briefTitle={idea?.proposed_title_es ?? ""}
    briefAngle={idea?.angle ?? ""}
    ideaId={ideaId}
  />
</AdminShell>

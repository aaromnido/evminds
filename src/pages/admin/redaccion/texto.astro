---
/**
 * Redacción — steps ③ and ④: one screen per channel chosen in step ②.
 *
 * Which channel this screen is for comes from `?canal=`, and `?pieza=` carries
 * the durable piece created when step ② was left. With a piece, everything the
 * screen needs — the brief, the channels, and whatever was already written for
 * this channel — is read from the database here and handed down as props: the
 * page loads, the island holds state.
 *
 * Without `?pieza=` the screen still works (route C, writing from scratch), just
 * with nothing to restore.
 *
 * PROTOTYPE (task A3): the text is still generated by `editorial-mocks.ts` and
 * the AI image edit is a CSS filter. What is real from phase 2 on is the row.
 * And — confirmed by Fer, 2026-07-25 — there is no integration with Motor.es'
 * CMS: the text is copied by hand. See `.claude/design/ai-editorial-agent-ui.md`.
 */
import AdminShell from "@/layouts/AdminShell.astro";
import PublishChannelStep from "@/components/admin/editorial/PublishChannelStep.tsx";
import { getChannel, parseChannels } from "@/lib/editorial-channels";
import { channelDraftFromRow, type ChannelDraftStatus } from "@/lib/editorial-drafts";
import { buildMockIdeas } from "@/lib/editorial-mocks";
import type { PublishChannel } from "@/lib/editorial-types";

const params = Astro.url.searchParams;
const supabase = Astro.locals.supabase;
const pieceId = params.get("pieza");

// The piece and every channel draft it already has. One round trip each, and
// only when there is a piece to load.
const { data: piece } =
  pieceId && supabase
    ? await supabase.from("editorial_pieces").select("*").eq("id", pieceId).maybeSingle()
    : { data: null };

const { data: draftRows } =
  piece && supabase
    ? await supabase.from("editorial_channel_drafts").select("*").eq("piece_id", piece.id)
    : { data: null };

// The piece's own channel list wins over the URL when it exists: it is the
// stored answer, and a hand-edited `?canales=` should not be able to contradict
// what the piece was created for.
const channels: PublishChannel[] = piece?.channels?.length
  ? parseChannels(piece.channels.join(","))
  : parseChannels(params.get("canales"));
const requested = params.get("canal");
const channel = channels.find((c) => c === requested) ?? channels[0];
const spec = getChannel(channel);

const currentRow = draftRows?.find((row) => row.channel === channel) ?? null;
const initialDraft = currentRow ? channelDraftFromRow(currentRow) : null;
const initialStatus = (currentRow?.status ?? "draft") as ChannelDraftStatus;

// Where this channel's date starts from when it has none of its own: the day the
// PREVIOUS channel is set to, a week earlier. Read from that channel's stored row
// when there is one, so going back and forth no longer depends on `?fecha=`
// surviving the trip. The parameter stays as the fallback for a piece that has
// not been saved yet.
const previousChannel = channels[channels.indexOf(channel) - 1];
const previousChannelDate =
  draftRows?.find((row) => row.channel === previousChannel)?.publish_date ?? params.get("fecha");

// Without a piece, the brief is rebuilt from the idea so the generated text is
// about the right thing.
const ideaId = piece?.idea_id ?? params.get("idea");
const now = new Date();
const nowIso = now.toISOString();
const idea = !piece && ideaId ? buildMockIdeas(nowIso).find((i) => i.id === ideaId) : undefined;

// "Now", in Madrid, as two plain wall-clock strings. Computed here and not in the
// island for the reason the whole section follows: `Date` inside a hydrated
// component gives a different answer on the server than on the client. As strings
// they can be compared against what the native date input returns without parsing
// anything (see `isPublishDatePast`).
const madrid = { timeZone: "Europe/Madrid" } as const;
const todayInMadrid = new Intl.DateTimeFormat("en-CA", {
  ...madrid,
  dateStyle: "short",
}).format(now);
const nowHourInMadrid = new Intl.DateTimeFormat("en-GB", {
  ...madrid,
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
}).format(now);
---

<AdminShell
  title={`${spec.name} · Admin`}
  pageTitle={`Texto para ${spec.name}`}
  pageDescription={spec.needsCmsFields
    ? "Los campos de su CMS, en su mismo orden. Copia uno a uno y pégalos allí."
    : "Revisa el texto, elige la imagen y programa la publicación."}
>
  <PublishChannelStep
    client:load
    channel={channel}
    channels={channels}
    pieceId={piece?.id ?? null}
    initialDraft={initialDraft}
    initialStatus={initialStatus}
    briefTitle={piece?.brief_title ?? idea?.proposed_title_es ?? ""}
    briefAngle={piece?.brief_angle ?? idea?.angle ?? ""}
    briefSourceName={piece?.source_name ?? idea?.source_name}
    briefSourceUrl={piece?.source_url ?? idea?.source_url}
    ideaId={ideaId}
    todayInMadrid={todayInMadrid}
    nowHourInMadrid={nowHourInMadrid}
    previousChannelDate={previousChannelDate}
  />
</AdminShell>

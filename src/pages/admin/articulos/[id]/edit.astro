---
import AdminShell from "@/layouts/AdminShell.astro";
import PostEditor, { type PostFormValues } from "@/components/admin/PostEditor.tsx";
import { parsePostForm, validatePostForm } from "@/lib/post-form";
import { purgeTags } from "@/lib/cache-purge";

const supabase = Astro.locals.supabase;
const { id } = Astro.params;

let errorMsg = "";
let formValues: PostFormValues | undefined;
let notFound = false;

if (!supabase || !id) {
  notFound = true;
} else if (Astro.request.method === "POST") {
  // Slug is editable here (unlike news), so fetch the pre-edit slug up front —
  // the purge must reach the old URL (→ 404 if renamed) as well as the new one.
  const { data: current } = await supabase.from("posts").select("slug").eq("id", id).single();

  // The request body (formData) can only be read once.
  const form = await Astro.request.formData();
  const action = String(form.get("_action") ?? "");

  if (action === "delete") {
    const { error } = await supabase.from("posts").delete().eq("id", id);
    if (!error) {
      const tags = current?.slug ? [`articulo-${current.slug}`, "listings"] : ["listings"];
      await purgeTags(tags);
      return Astro.redirect("/admin/articulos");
    }
    errorMsg = `No se pudo eliminar: ${error.message}`;
  } else {
    const parsed = parsePostForm(form);
    formValues = parsed.values;

    const validationError = validatePostForm(parsed);
    if (validationError) {
      errorMsg = validationError;
    } else {
      const { error } = await supabase
        .from("posts")
        .update(parsed.payload as never)
        .eq("id", id);
      if (error) {
        errorMsg =
          error.code === "23505"
            ? "Ya existe un artículo con ese slug. Cámbialo."
            : `No se pudo guardar: ${error.message}`;
      } else {
        const tags = new Set(["listings"]);
        if (current?.slug) tags.add(`articulo-${current.slug}`);
        if (parsed.payload.slug && parsed.payload.slug !== current?.slug) {
          tags.add(`articulo-${parsed.payload.slug}`);
        }
        await purgeTags([...tags]);
        return Astro.redirect("/admin/articulos");
      }
    }
  }
}

// Initial load (GET) or after a failed delete: fetch the row to prefill.
if (!formValues && !notFound && supabase && id) {
  const { data, error } = await supabase.from("posts").select("*").eq("id", id).single();
  if (error || !data) {
    notFound = true;
  } else {
    const row = data as unknown as {
      title: string;
      slug: string;
      excerpt: string;
      content: string;
      category: string;
      tags: string[] | null;
      image_url: string | null;
      image_alt: string | null;
      status: string;
      published_at: string | null;
    };
    formValues = {
      title: row.title,
      slug: row.slug,
      excerpt: row.excerpt,
      content: row.content,
      category: row.category,
      tags: (row.tags ?? []).join(", "),
      image_url: row.image_url ?? "",
      image_alt: row.image_alt ?? "",
      status: row.status,
      // ISO → datetime-local ("YYYY-MM-DDTHH:mm"). Shows UTC; refine later if needed.
      published_at: row.published_at ? String(row.published_at).slice(0, 16) : "",
    };
  }
}

if (notFound) return Astro.redirect("/admin/articulos");
---

<AdminShell
  title="Editar artículo · Admin"
  pageTitle="Editar artículo"
  pageDescription="Modifica un artículo propio (tabla posts)."
>
  <PostEditor
    client:load
    post={formValues}
    error={errorMsg || undefined}
    submitLabel="Guardar cambios"
    showDelete
  />
</AdminShell>

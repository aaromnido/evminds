---
import AdminShell from "@/layouts/AdminShell.astro";
import PostsList, { type PostListItem } from "@/components/admin/PostsList.tsx";

// Authed admin client set by the middleware. RLS policy posts_admin_all lets
// the admin read ALL posts (drafts + scheduled + published), not just public ones.
const supabase = Astro.locals.supabase;

const PAGE_SIZE = 20;
const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);
const from = (page - 1) * PAGE_SIZE;
const to = from + PAGE_SIZE - 1;

let posts: PostListItem[] = [];
let total = 0;
let errorMsg: string | undefined;

if (supabase) {
  let query = supabase
    .from("posts")
    .select("id, slug, title, status, published_at, updated_at, category", {
      count: "exact",
    });
  if (q) query = query.ilike("title", `%${q}%`);
  const { data, error, count } = await query
    // Matches the "Publicación" column now shown in the list. Drafts with no
    // published_at yet sort last, not first (Postgres' DESC default).
    .order("published_at", { ascending: false, nullsFirst: false })
    .range(from, to);
  if (error) errorMsg = error.message;
  // Cast: hand-written Database type infers `never` on .from() (see typecheck
  // cleanup task). Shape is guaranteed by the explicit select above.
  else {
    posts = (data ?? []) as unknown as PostListItem[];
    total = count ?? 0;
  }
}

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const nowIso = new Date().toISOString();
---

<AdminShell
  title="Artículos propios · Admin"
  pageTitle="Artículos propios"
  pageDescription="Contenido original (tabla posts)."
  actionLabel="Nuevo artículo"
  actionHref="/admin/articulos/new"
>
  <PostsList
    posts={posts}
    error={errorMsg}
    nowIso={nowIso}
    q={q}
    page={page}
    totalPages={totalPages}
    total={total}
  />
</AdminShell>

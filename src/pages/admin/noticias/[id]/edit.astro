---
import AdminShell from "@/layouts/AdminShell.astro";
import NewsEditor, { type NewsFormValues } from "@/components/admin/NewsEditor.tsx";
import { purgeTags } from "@/lib/cache-purge";

const supabase = Astro.locals.supabase;
const { id } = Astro.params;

let errorMsg = "";
let formValues: NewsFormValues | undefined;
let notFound = false;
let categories: string[] = [];

if (!supabase || !id) {
  notFound = true;
} else if (Astro.request.method === "POST") {
  // Slug is immutable for news articles (not part of either update payload
  // below), so one fetch up front covers both branches' purge tag.
  const { data: current } = await supabase.from("articles").select("slug").eq("id", id).single();
  const purgeTagsForThis = current?.slug ? [`noticia-${current.slug}`, "listings"] : ["listings"];

  const form = await Astro.request.formData();
  const action = String(form.get("_action") ?? "");

  if (action === "archive" || action === "unarchive") {
    const { error } = await supabase
      .from("articles")
      .update({ archived: action === "archive" })
      .eq("id", id);
    if (!error) {
      await purgeTags(purgeTagsForThis);
      return Astro.redirect("/admin/noticias");
    }
    errorMsg = `No se pudo ${action === "archive" ? "archivar" : "desarchivar"}: ${error.message}`;
  } else {
    const get = (k: string) => String(form.get(k) ?? "").trim();
    const title = get("title");
    const excerpt = get("excerpt");
    const category = get("category");
    const imageUrl = get("image_url");
    const seoTitle = get("seo_title");
    const aiSummary = get("ai_summary");
    const aiDiscussionPrompt = get("ai_discussion_prompt");
    // Headline tone: validate against the allowed buckets; anything else → null
    // ("Sin clasificar"). Manual override of the AI traffic-light classification.
    const rawTone = get("headline_tone");
    const headlineTone =
      rawTone === "green" || rawTone === "amber" || rawTone === "red" ? rawTone : null;

    const missing: string[] = [];
    if (!title) missing.push("título");
    if (!excerpt) missing.push("extracto");
    if (!category) missing.push("categoría");
    if (missing.length) {
      errorMsg = `Faltan campos obligatorios: ${missing.join(", ")}.`;
      formValues = {
        title,
        excerpt,
        category,
        image_url: imageUrl,
        seo_title: seoTitle,
        headline_tone: headlineTone,
        ai_summary: aiSummary,
        ai_discussion_prompt: aiDiscussionPrompt,
      };
    } else {
      const { error } = await supabase
        .from("articles")
        .update({
          title,
          excerpt,
          category,
          image_url: imageUrl || null,
          seo_title: seoTitle || null,
          headline_tone: headlineTone,
          ai_summary: aiSummary || null,
          ai_discussion_prompt: aiDiscussionPrompt || null,
        })
        .eq("id", id);
      if (error) {
        errorMsg = `No se pudo guardar: ${error.message}`;
      } else {
        await purgeTags(purgeTagsForThis);
        return Astro.redirect("/admin/noticias");
      }
    }
  }
}

// GET (or failed POST): fetch the row + source name to prefill, plus the
// distinct categories already in use for the datalist suggestions.
if (!notFound && supabase && id) {
  // Categories come from a DISTINCT RPC (get_article_categories) instead of
  // fetching the `category` column of every article — see migration 43.
  const [{ data, error }, { data: catRows }] = await Promise.all([
    supabase
      .from("articles")
      .select(
        "title, slug, excerpt, category, image_url, archived, article_url, published_at, content_type, has_comments, seo_title, headline_tone, ai_summary, ai_discussion_prompt, ai_warnings, ai_generated_at, source:sources!inner(name)",
      )
      .eq("id", id)
      .single(),
    supabase.rpc("get_article_categories"),
  ]);

  if (error || !data) {
    notFound = true;
  } else {
    const row = data;
    // Keep the edited (failed-submit) values if present, only fill the rest.
    formValues = {
      title: formValues?.title ?? row.title,
      excerpt: formValues?.excerpt ?? row.excerpt,
      category: formValues?.category ?? row.category,
      image_url: formValues?.image_url ?? row.image_url ?? "",
      seo_title: formValues?.seo_title ?? row.seo_title ?? "",
      // null here is a meaningful choice ("Sin clasificar"), so on a failed
      // submit keep the user's pick; on a plain GET fall back to the DB value.
      headline_tone: formValues ? (formValues.headline_tone ?? null) : row.headline_tone,
      archived: row.archived,
      ai_summary: formValues?.ai_summary ?? row.ai_summary ?? "",
      ai_discussion_prompt: formValues?.ai_discussion_prompt ?? row.ai_discussion_prompt ?? "",
      ai_warnings: (row.ai_warnings ?? []).map((w) => w.type),
      ai_generated_at: row.ai_generated_at ?? undefined,
      sourceName: row.source?.name,
      articleUrl: row.article_url,
      slug: row.slug,
      publishedAt: row.published_at,
      contentType: row.content_type,
      hasComments: row.has_comments,
    };
    // supabase-js types SETOF text as `string` (not string[]); the runtime data
    // is an array. Justified cast — see supabase-js GenericFunction limitations.
    categories = (catRows ?? []) as string[];
  }
}

if (notFound) return Astro.redirect("/admin/noticias");
---

<AdminShell
  title="Editar noticia · Admin"
  pageTitle="Editar noticia"
  pageDescription="Modifica una noticia scrapeada (tabla articles)."
>
  <NewsEditor
    client:load
    id={id!}
    article={formValues ?? {}}
    error={errorMsg || undefined}
    categories={categories}
  />
</AdminShell>

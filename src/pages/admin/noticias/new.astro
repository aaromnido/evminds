---
import AdminShell from "@/layouts/AdminShell.astro";
import NewsCreateForm, {
  type SourceOption,
  type NewsCreateValues,
} from "@/components/admin/NewsCreateForm.tsx";
import { madridLocalToUtcIso } from "@/lib/madrid-time";

const supabase = Astro.locals.supabase;

let errorMsg = "";
let values: NewsCreateValues | undefined;

if (supabase && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const get = (k: string) => String(form.get(k) ?? "").trim();

  const sourceId = get("source_id");
  const title = get("title");
  const slug = get("slug");
  const excerpt = get("excerpt");
  const category = get("category");
  const rawType = get("content_type");
  const contentType = ["news", "video"].includes(rawType) ? rawType : "news";
  const articleUrl = get("article_url");
  const imageUrl = get("image_url");
  const publishedAtRaw = get("published_at");
  const youtubeId = get("youtube_video_id");

  values = {
    source_id: sourceId,
    title,
    slug,
    excerpt,
    category,
    content_type: contentType,
    article_url: articleUrl,
    image_url: imageUrl,
    published_at: publishedAtRaw,
    youtube_video_id: youtubeId,
  };

  const missing: string[] = [];
  if (!sourceId) missing.push("medio");
  if (!title) missing.push("título");
  if (!slug) missing.push("slug");
  if (!excerpt) missing.push("extracto");
  if (!category) missing.push("categoría");
  if (!articleUrl) missing.push("URL");
  if (!publishedAtRaw) missing.push("fecha");

  // The datetime-local input is timezone-naive Madrid wall-clock time, so it
  // must go through madridLocalToUtcIso rather than a bare `new Date()` — the
  // latter parses it in the server process's own timezone (UTC on Netlify),
  // silently shifting the published time by Madrid's offset (1-2h with DST).
  let publishedAt = "";
  if (publishedAtRaw) {
    try {
      publishedAt = madridLocalToUtcIso(publishedAtRaw);
    } catch {
      missing.push("fecha (formato no válido)");
    }
  }

  if (missing.length) {
    errorMsg = `Faltan campos obligatorios: ${missing.join(", ")}.`;
  } else {
    const payload = {
      source_id: sourceId,
      title,
      slug,
      excerpt,
      category,
      content_type: contentType,
      article_url: articleUrl,
      image_url: imageUrl || null,
      published_at: publishedAt,
      youtube_video_id: contentType === "video" && youtubeId ? youtubeId : null,
    };
    const { error } = await supabase.from("articles").insert(payload);
    if (error) {
      errorMsg =
        error.code === "23505"
          ? "Ya existe una noticia con ese slug o URL. Cámbialos."
          : `No se pudo crear: ${error.message}`;
    } else {
      return Astro.redirect("/admin/noticias");
    }
  }
}

// Sources for the <select> + distinct categories for the datalist.
let sources: SourceOption[] = [];
let categories: string[] = [];
if (supabase) {
  // Categories come from a DISTINCT RPC (get_article_categories) instead of
  // fetching the `category` column of every article — see migration 43.
  const [{ data: srcRows }, { data: catRows }] = await Promise.all([
    supabase.from("sources").select("id, name").order("name"),
    supabase.rpc("get_article_categories"),
  ]);
  sources = (srcRows ?? []) as SourceOption[];
  // supabase-js types SETOF text as `string` (not string[]); the runtime data
  // is an array. Justified cast — see supabase-js GenericFunction limitations.
  categories = (catRows ?? []) as string[];
}
---

<AdminShell
  title="Nueva noticia · Admin"
  pageTitle="Nueva noticia"
  pageDescription="Alta manual de una noticia (tabla articles)."
>
  <NewsCreateForm
    client:load
    sources={sources}
    categories={categories}
    values={values}
    error={errorMsg || undefined}
  />
</AdminShell>

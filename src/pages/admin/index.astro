---
import AdminShell from "@/layouts/AdminShell.astro";
import DashboardHome, {
  type RecentNewsItem,
  type RecentPostItem,
} from "@/components/admin/DashboardHome.tsx";

const supabase = Astro.locals.supabase;

// Dashboard metrics. All counts use head:true (no rows transferred) and the
// recent lists are tiny LIMIT 5 reads — cheap, and faster now that the perf
// indexes exist. Casts follow the house style (hand-maintained Database types).
let newsTotal = 0;
// "Sin IA" surfaces only RECENTLY-scraped news still missing an AI summary — a
// pipeline-health signal. The full ai_summary IS NULL count (~3.6k) is mostly
// legacy news + videos (videos get no summary by design), so showing it would be
// alarming and useless. 7-day window over content_type='news' is the actionable
// "did the Gemini pipeline fail lately?" number.
let newsNoAiRecent = 0;
let newsArchived = 0;
let postsTotal = 0;
let postsDrafts = 0;
let lastScrapeIso: string | null = null;
let recentNews: RecentNewsItem[] = [];
let recentPosts: RecentPostItem[] = [];

if (supabase) {
  const articles = () => supabase.from("articles");
  const posts = () => supabase.from("posts");
  const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();

  const [
    newsTotalRes,
    newsNoAiRes,
    newsArchivedRes,
    postsTotalRes,
    postsDraftsRes,
    lastScrapeRes,
    recentNewsRes,
    recentPostsRes,
  ] = await Promise.all([
    articles().select("*", { count: "exact", head: true }),
    articles()
      .select("*", { count: "exact", head: true })
      .is("ai_summary", null)
      .eq("content_type", "news")
      .gte("scraped_at", sevenDaysAgo),
    articles().select("*", { count: "exact", head: true }).eq("archived", true),
    posts().select("*", { count: "exact", head: true }),
    posts().select("*", { count: "exact", head: true }).eq("status", "draft"),
    articles()
      .select("scraped_at")
      .order("scraped_at", { ascending: false })
      .limit(1)
      .maybeSingle(),
    articles()
      .select("id, slug, title, content_type, scraped_at")
      .order("scraped_at", { ascending: false })
      .limit(5),
    posts()
      .select("id, title, status, published_at, updated_at")
      .order("updated_at", { ascending: false })
      .limit(5),
  ]);

  newsTotal = newsTotalRes.count ?? 0;
  newsNoAiRecent = newsNoAiRes.count ?? 0;
  newsArchived = newsArchivedRes.count ?? 0;
  postsTotal = postsTotalRes.count ?? 0;
  postsDrafts = postsDraftsRes.count ?? 0;
  lastScrapeIso =
    (lastScrapeRes.data as unknown as { scraped_at: string } | null)?.scraped_at ?? null;
  recentNews = (recentNewsRes.data ?? []) as unknown as RecentNewsItem[];
  recentPosts = (recentPostsRes.data ?? []) as unknown as RecentPostItem[];
}
---

<AdminShell
  title="Panel · Admin evminds"
  pageTitle="Panel de administración"
  pageDescription="Gestiona el contenido de evminds desde aquí."
>
  <DashboardHome
    newsTotal={newsTotal}
    newsNoAiRecent={newsNoAiRecent}
    newsArchived={newsArchived}
    postsTotal={postsTotal}
    postsDrafts={postsDrafts}
    lastScrapeIso={lastScrapeIso}
    recentNews={recentNews}
    recentPosts={recentPosts}
    nowIso={new Date().toISOString()}
  />
</AdminShell>

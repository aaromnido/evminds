---
import AdminShell from "@/layouts/AdminShell.astro";

// Sections of the admin. Routes land in later phases (3: posts, 6: news);
// shown here as the planned map. `ready: false` renders them as disabled.
const sections = [
  {
    href: "/admin/posts",
    title: "Artículos propios",
    desc: "Crear y editar el contenido original (tabla posts).",
    ready: false,
  },
  {
    href: "/admin/noticias",
    title: "Noticias",
    desc: "Editar, archivar y regenerar la IA de las noticias agregadas.",
    ready: false,
  },
];
---

<AdminShell title="Panel · Admin evminds">
  <h1 class="text-3xl font-bold tracking-tight">Panel de administración</h1>
  <p class="mt-1 mb-7 text-muted-foreground">
    Gestiona el contenido de evminds desde aquí.
  </p>

  <div class="grid grid-cols-[repeat(auto-fill,minmax(15rem,1fr))] gap-4">
    {
      sections.map((s) =>
        s.ready ? (
          <a
            href={s.href}
            class="flex flex-col gap-1 rounded-xl border border-border bg-card p-5 text-card-foreground transition-all hover:-translate-y-0.5 hover:border-ring"
          >
            <span class="font-bold">{s.title}</span>
            <span class="text-sm text-muted-foreground">{s.desc}</span>
          </a>
        ) : (
          <div class="flex flex-col gap-1 rounded-xl border border-border bg-card p-5 text-card-foreground opacity-60">
            <span class="flex items-center gap-2 font-bold">
              {s.title}
              <span class="rounded-full bg-secondary px-2 py-0.5 text-[0.65rem] font-semibold tracking-wide text-secondary-foreground uppercase">
                Próximamente
              </span>
            </span>
            <span class="text-sm text-muted-foreground">{s.desc}</span>
          </div>
        ),
      )
    }
  </div>
</AdminShell>

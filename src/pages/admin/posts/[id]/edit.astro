---
import AdminShell from "@/layouts/AdminShell.astro";
import PostEditor, { type PostFormValues } from "@/components/admin/PostEditor.tsx";

const supabase = Astro.locals.supabase;
const { id } = Astro.params;

let errorMsg = "";
let formValues: PostFormValues | undefined;
let notFound = false;

const parseForm = (
  form: FormData,
): {
  values: PostFormValues;
  payload: Record<string, unknown>;
  missingFields: string[];
} => {
  const get = (k: string) => String(form.get(k) ?? "").trim();

  const title = get("title");
  const slug = get("slug");
  const excerpt = get("excerpt");
  const content = get("content");
  const category = get("category");
  const tagsRaw = get("tags");
  const imageUrl = get("image_url");
  const imageAlt = get("image_alt");
  const status = get("status");
  const publishedAtRaw = get("published_at");

  const tags = tagsRaw
    ? tagsRaw
        .split(",")
        .map((t) => t.trim())
        .filter(Boolean)
    : [];

  let publishedAt: string | null = null;
  if (publishedAtRaw) publishedAt = new Date(publishedAtRaw).toISOString();
  else if (status === "published") publishedAt = new Date().toISOString();

  const emptyContent = !content || content === "<p></p>";
  const missingFields: string[] = [];
  if (!title) missingFields.push("título");
  if (!slug) missingFields.push("slug");
  if (!excerpt) missingFields.push("extracto");
  if (emptyContent) missingFields.push("contenido");

  return {
    values: {
      title,
      slug,
      excerpt,
      content,
      category,
      tags: tagsRaw,
      image_url: imageUrl,
      image_alt: imageAlt,
      status,
      published_at: publishedAtRaw,
    },
    payload: {
      title,
      slug,
      excerpt,
      content,
      category,
      tags,
      image_url: imageUrl || null,
      image_alt: imageAlt || null,
      status,
      published_at: publishedAt,
    },
    missingFields,
  };
};

if (!supabase || !id) {
  notFound = true;
} else if (Astro.request.method === "POST") {
  // The request body (formData) can only be read once.
  const form = await Astro.request.formData();
  const action = String(form.get("_action") ?? "");

  if (action === "delete") {
    const { error } = await supabase.from("posts").delete().eq("id", id);
    if (!error) return Astro.redirect("/admin/posts");
    errorMsg = `No se pudo eliminar: ${error.message}`;
  } else {
    const { values, payload, missingFields } = parseForm(form);
    formValues = values;
    const VALID_CATEGORIES = ["Experiencia", "Guía", "Review", "Opinión", "Viaje"];
    const publishedAtRaw = String(form.get("published_at") ?? "").trim();
    if (missingFields.length) {
      errorMsg = `Faltan campos obligatorios: ${missingFields.join(", ")}.`;
    } else if (payload.category && !VALID_CATEGORIES.includes(payload.category as string)) {
      errorMsg = "Categoría no válida.";
    } else if (publishedAtRaw && isNaN(new Date(publishedAtRaw).getTime())) {
      errorMsg = "Fecha de publicación no válida.";
    } else {
      // Cast: hand-written Database type infers `never` on .from() (typecheck task).
      const { error } = await supabase
        .from("posts")
        .update(payload as never)
        .eq("id", id);
      if (error) {
        errorMsg =
          error.code === "23505"
            ? "Ya existe un artículo con ese slug. Cámbialo."
            : `No se pudo guardar: ${error.message}`;
      } else {
        return Astro.redirect("/admin/posts");
      }
    }
  }
}

// Initial load (GET) or after a failed delete: fetch the row to prefill.
if (!formValues && !notFound && supabase && id) {
  const { data, error } = await supabase.from("posts").select("*").eq("id", id).single();
  if (error || !data) {
    notFound = true;
  } else {
    const row = data as unknown as {
      title: string;
      slug: string;
      excerpt: string;
      content: string;
      category: string;
      tags: string[] | null;
      image_url: string | null;
      image_alt: string | null;
      status: string;
      published_at: string | null;
    };
    formValues = {
      title: row.title,
      slug: row.slug,
      excerpt: row.excerpt,
      content: row.content,
      category: row.category,
      tags: (row.tags ?? []).join(", "),
      image_url: row.image_url ?? "",
      image_alt: row.image_alt ?? "",
      status: row.status,
      // ISO → datetime-local ("YYYY-MM-DDTHH:mm"). Shows UTC; refine later if needed.
      published_at: row.published_at ? String(row.published_at).slice(0, 16) : "",
    };
  }
}

if (notFound) return Astro.redirect("/admin/posts");
---

<AdminShell
  title="Editar artículo · Admin"
  pageTitle="Editar artículo"
  pageDescription="Modifica un artículo propio (tabla posts)."
>
  <PostEditor
    client:load
    post={formValues}
    error={errorMsg || undefined}
    submitLabel="Guardar cambios"
    showDelete
  />
</AdminShell>

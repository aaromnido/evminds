---
import AdminShell from "@/layouts/AdminShell.astro";
import PostEditor, { type PostFormValues } from "@/components/admin/PostEditor.tsx";
import { parsePostForm, validatePostForm } from "@/lib/post-form";
import { purgeTags } from "@/lib/cache-purge";

// Authed admin client set by the middleware. Insert is validated by the
// posts_admin_all RLS policy (WITH CHECK is_admin()).
const supabase = Astro.locals.supabase;

let errorMsg = "";
let values: PostFormValues | undefined;

if (Astro.request.method === "POST" && supabase) {
  const form = await Astro.request.formData();
  const parsed = parsePostForm(form);
  values = parsed.values;

  const validationError = validatePostForm(parsed);
  if (validationError) {
    errorMsg = validationError;
  } else {
    const { error } = await supabase.from("posts").insert(parsed.payload as never);

    if (error) {
      errorMsg =
        error.code === "23505"
          ? "Ya existe un artículo con ese slug. Cámbialo."
          : `No se pudo guardar: ${error.message}`;
    } else {
      await purgeTags([`articulo-${parsed.payload.slug}`, "listings"]);
      return Astro.redirect("/admin/posts");
    }
  }
}
---

<AdminShell
  title="Nuevo artículo · Admin"
  pageTitle="Nuevo artículo"
  pageDescription="Crea un artículo propio (tabla posts)."
>
  <PostEditor
    client:load
    post={values}
    error={errorMsg || undefined}
    submitLabel="Crear artículo"
  />
</AdminShell>

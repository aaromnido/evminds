---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Badge from "@/components/Badge.astro";
import NewsCard from "@/components/NewsCard.astro";
import BookmarkButton from "@/components/BookmarkButton.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import DisqusComments from "@/components/DisqusComments.astro";
import DisqusCommentCount from "@/components/DisqusCommentCount.astro";
import { supabase } from "@/lib/supabase";
import { isAdminRequest } from "@/lib/admin-session";
import AdminEditButton from "@/components/AdminEditButton.astro";
import { formatDate } from "@/lib/date-utils";
import { optimizedImageUrl } from "@/lib/image-utils";
import { getCategorySlugByName } from "@/lib/categories";
import { getNewsUrl, getVideoUrl } from "@/lib/article-url";
import {
  ARTICLE_SELECT,
  normalizeArticle,
  mapArticleToProps,
  serializeBookmarkData,
} from "@/lib/article-utils";
import { extractKeywords, relatedArticleScore, searchTermsFor } from "@/lib/related-articles";
import { resolveWarningText, type AiWarning } from "@/lib/ai-warnings";
import ToneIndicator from "@/components/ToneIndicator.astro";
import { formatSummaryParagraph, summaryToMetaDescription } from "@/lib/format-summary";
import { stripHtml, sanitizeExcerpt } from "@/lib/html-utils";
import FlagEN from "@/components/FlagEN.astro";

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// Fetch article with source info
const { data, error } = await supabase
  .from("articles")
  .select(
    "id, slug, title, seo_title, excerpt, image_url, article_url, category, content_type, published_at, scraped_at, ai_summary, ai_warnings, ai_discussion_prompt, headline_tone, source:sources!inner(name, lang)",
  )
  .eq("slug", slug)
  .single();

if (error || !data) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const article = data;

const isAdmin = await isAdminRequest({ request: Astro.request, cookies: Astro.cookies });

// Redirect videos to their correct URL
if (article.content_type === "video") {
  return Astro.redirect(getVideoUrl(article.slug), 301);
}
const source = Array.isArray(article.source) ? article.source[0] : article.source;

const RELATED_ARTICLES_LIMIT = 3;
const RELATED_CANDIDATE_POOL_SIZE = 20;
const RELATED_KEYWORD_TERMS_LIMIT = 14;
const RELATED_KEYWORD_PER_TERM_LIMIT = 6;

const currentKeywords = extractKeywords(article.title, article.seo_title);
// DB-searchable terms: a matched topic cluster (e.g. "topic:conduccion-autonoma")
// expands back into its full synonym list (autopilot, waymo, fsd...) so a
// sibling using different vocabulary than this article still gets fetched —
// see src/lib/related-articles.ts.
const searchTerms = searchTermsFor(currentKeywords);

// Same-category pool: recency-ordered safety net so the section never goes
// empty even when no candidate shares a meaningful keyword with this article.
const { data: categoryPool } = await supabase
  .from("articles")
  .select(ARTICLE_SELECT)
  .eq("category", article.category)
  .neq("id", article.id)
  .order("scraped_at", { ascending: false })
  .limit(RELATED_CANDIDATE_POOL_SIZE);

// Cross-category pool: articles whose title/seo_title mention one of this
// article's search terms, so a genuinely related piece can outrank
// same-category noise (A9, 2026-07-15 SEO/stats meeting).
//
// One RPC call covering every term (not 14 separate round trips): each term
// still gets its own per-term LIMIT inside related_articles_pool() (a
// combined query's LIMIT is filled by whichever term matches most often and
// most recently, so a common one like "tesla" would starve a rarer, more
// specific one like "degradacion" out of the result window entirely —
// confirmed during A9 manual QA), so recall is unchanged from the previous
// 14-query version. See supabase/migrations/48_related_articles_pool_fn.sql
// for why this needs to be a DEFINER RPC rather than a client-side query.
const { data: keywordPoolRows } =
  searchTerms.length > 0
    ? await (supabase as any).rpc("related_articles_pool", {
        p_article_id: article.id,
        p_terms: searchTerms.slice(0, RELATED_KEYWORD_TERMS_LIMIT),
        p_per_term: RELATED_KEYWORD_PER_TERM_LIMIT,
      })
    : { data: [] };
const keywordPool = (keywordPoolRows || []).map((row: any) => ({
  ...row,
  source: { name: row.source_name, url: row.source_url },
}));

const candidatesById = new Map<string, ReturnType<typeof normalizeArticle>>();
for (const raw of [...(categoryPool || []), ...keywordPool]) {
  const candidate = normalizeArticle(raw);
  candidatesById.set(candidate.id, candidate);
}

const currentKeywordSet = new Set(currentKeywords);
const relatedArticles = Array.from(candidatesById.values())
  .map((candidate) => ({
    candidate,
    score: relatedArticleScore(
      extractKeywords(candidate.title, candidate.seo_title),
      currentKeywordSet,
      candidate.category === article.category,
    ),
  }))
  .sort(
    (a, b) =>
      b.score - a.score || b.candidate.scraped_at.getTime() - a.candidate.scraped_at.getTime(),
  )
  .slice(0, RELATED_ARTICLES_LIMIT)
  .map((entry) => mapArticleToProps(entry.candidate));

// SEO-optimized headline: feeds <title>, og:title and the visible <h1>.
// Falls back to the source title when no seo_title was generated (old articles).
const displayTitle = article.seo_title || article.title;

// Page data
const heroImage = article.image_url || "/images/placeholder-image.webp";
const formattedDate = formatDate(article.published_at);
const categorySlug = getCategorySlugByName(article.category);
const canonicalUrl = new URL(getNewsUrl(article.slug), Astro.site).toString();

// Meta description: prefer the AI summary (1500ch unique editorial content)
// truncated to ~160ch over the source's excerpt (short, often duplicated).
const metaDescription = article.ai_summary
  ? summaryToMetaDescription(article.ai_summary)
  : stripHtml(article.excerpt);

// Excerpt is rendered with set:html — sanitize server-side so no executable
// markup can reach the page even if a scraper or admin edit slips through.
const safeExcerpt = sanitizeExcerpt(article.excerpt);

const articleDataJson = serializeBookmarkData({
  id: article.id,
  slug: article.slug,
  title: displayTitle,
  excerpt: article.excerpt,
  image: article.image_url || "",
  scraped_at: article.scraped_at || "",
  source: source.name,
  category: article.category,
});
---

<BaseLayout
  title={`${displayTitle} - EVMinds`}
  description={metaDescription}
  image={article.image_url || undefined}
  type="article"
  publishedAt={article.published_at}
  breadcrumbs={[
    { name: "Inicio", url: "/" },
    ...(categorySlug ? [{ name: article.category, url: `/categoria/${categorySlug}` }] : []),
    { name: displayTitle, url: getNewsUrl(article.slug) },
  ]}
>
  <main class="article-detail">
    <Header />

    <article class="article-detail__content">
      <!-- Title -->
      <div class="article-detail__title-wrap">
        <h1 class="article-detail__title">{displayTitle}</h1>
        {isAdmin && <AdminEditButton href={`/admin/noticias/${article.id}/edit`} />}
      </div>

      <!-- Hero image -->
      <div class="article-detail__hero">
        <img
          src={optimizedImageUrl(heroImage, 900)}
          alt={article.title}
          class="article-detail__hero-image"
          loading="eager"
          fetchpriority="high"
          width="900"
          height="500"
        />
      </div>

      <div class="article-detail__header">
        <div class="article-detail__meta">
          <time datetime={article.published_at}>{formattedDate}</time>
        </div>

        <!-- Badges + Bookmark -->
        <div class="article-detail__badges">
          <div class="article-detail__tags">
            <Badge label={source.name} variant="filled" />
            {
              categorySlug && (
                <a href={`/categoria/${categorySlug}`} class="article-detail__category-link">
                  <Badge label={article.category} variant="outlined" />
                </a>
              )
            }
            {!categorySlug && <Badge label={article.category} variant="outlined" />}
          </div>
          <div class="article-detail__actions">
            <DisqusCommentCount identifier={article.id} />
            <BookmarkButton articleId={article.id} articleData={articleDataJson} />
          </div>
        </div>
        <ToneIndicator tone={article.headline_tone} />
      </div>
      <!-- Meta: date + source -->

      <!-- Excerpt -->
      <div class="article-detail__excerpt" set:html={safeExcerpt} />

      <!-- AI summary -->
      {
        article.ai_summary && (
          <section class="article-detail__ai-summary" aria-labelledby="ai-summary-heading">
            <h2 id="ai-summary-heading" class="article-detail__ai-summary-heading">
              Resumen
            </h2>
            {article.ai_summary.trimStart().startsWith("<p>") ? (
              <div class="article-detail__ai-summary-body" set:html={article.ai_summary} />
            ) : (
              article.ai_summary
                .split("\n\n")
                .map((para: string) => (
                  <p
                    class="article-detail__ai-summary-paragraph"
                    set:html={formatSummaryParagraph(para)}
                  />
                ))
            )}
            {article.ai_discussion_prompt && (
              <p class="article-detail__ai-summary-paragraph">{article.ai_discussion_prompt}</p>
            )}
            <p class="article-detail__ai-disclaimer">
              Síntesis editorial de EVMinds a partir de la noticia original.
            </p>
          </section>
        )
      }

      <!-- AI transparency notes -->
      {
        article.ai_warnings && article.ai_warnings.length > 0 && (
          <aside class="article-detail__ai-warnings" aria-labelledby="ai-warnings-heading">
            <h2 id="ai-warnings-heading" class="article-detail__ai-warnings-title">
              Conviene saber:
            </h2>
            <ul class="article-detail__ai-warnings-list">
              {(article.ai_warnings as AiWarning[]).map((w) => (
                <li class={`article-detail__ai-warning article-detail__ai-warning--${w.type}`}>
                  {resolveWarningText(w, "es")}
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <!-- CTA: read full article -->
      <a
        href={article.article_url}
        target="_blank"
        rel="noopener noreferrer"
        class="article-detail__cta"
      >
        {source.lang === "en" && <FlagEN label="Fuente en inglés" />}
        Leer artículo completo en {source.name}
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>

      <!-- Share buttons -->
      <ShareButtons url={canonicalUrl} title={displayTitle} />

      <!-- Related articles -->
      {
        relatedArticles.length > 0 && (
          <section class="article-detail__related" aria-label="Noticias relacionadas">
            <h2 class="article-detail__related-title">Noticias relacionadas</h2>
            <div class="article-detail__related-grid">
              {relatedArticles.map((props) => (
                <NewsCard {...props} />
              ))}
            </div>
          </section>
        )
      }

      <!-- Disqus comments -->
      <DisqusComments identifier={article.id} url={canonicalUrl} title={article.title} />
    </article>

    <Footer />
  </main>
</BaseLayout>

<style>
  .article-detail {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    min-height: 100vh;
  }

  .article-detail__content {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Header (meta + badges) */
  .article-detail__header {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Tone badge sits at the far right of the header row. Rendered by the Badge
     child component, so it needs :global() to escape page-scoped styles. */
  .article-detail__header > :global(.badge) {
    margin-left: auto;
  }

  /* Badges */
  .article-detail__badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* On desktop the tags/actions wrappers are transparent, so the badges row
     flows exactly as before (source, category, comment count, bookmark).
     They become real flex groups only on mobile to rearrange the header. */
  .article-detail__tags,
  .article-detail__actions {
    display: contents;
  }

  .article-detail__category-link {
    text-decoration: none;
  }

  .article-detail__category-link:hover {
    opacity: 0.8;
  }

  /* Hero image */
  .article-detail__hero {
    border-radius: 16px;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--navy-2) 8%, transparent);
  }

  .article-detail__hero-image {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
    display: block;
  }

  /* Title */
  .article-detail__title-wrap {
    position: relative;
  }

  .article-detail__title {
    font-family: var(--font-heading);
    font-size: 48px;
    font-weight: 700;
    font-style: italic;
    line-height: 1.1;
    color: var(--navy-light);
    letter-spacing: -0.01em;
  }

  /* Meta */
  .article-detail__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--navy-2);
  }

  /* Excerpt */
  .article-detail__excerpt {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--navy-2);
    letter-spacing: -0.01em;
  }

  /* Excerpt is rendered HTML (rich-text editor output); reset paragraph margins. */
  .article-detail__excerpt :global(p) {
    margin: 0;
  }

  .article-detail__excerpt :global(p + p) {
    margin-top: 0.75em;
  }

  /* AI summary */
  .article-detail__ai-summary {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Visually hidden but readable by screen readers and crawlers */
  .article-detail__ai-summary-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .article-detail__ai-summary-paragraph,
  .article-detail__ai-summary-body :global(p) {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--navy-2);
    margin: 0;
  }

  .article-detail__ai-summary-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .article-detail__ai-disclaimer {
    font-family: var(--font-body);
    font-size: 14px;
    font-style: italic;
    line-height: 1.4;
    color: var(--navy-2);
    opacity: 0.6;
    margin: 4px 0 0;
  }

  /* AI transparency notes */
  .article-detail__ai-warnings {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 20px;
    background-color: rgba(25, 27, 65, 0.04);
    border-radius: 6px;
  }

  .article-detail__ai-warnings-title {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--navy-2);
    opacity: 0.7;
    margin: 0;
  }

  .article-detail__ai-warnings-list {
    list-style: disc;
    padding-left: 20px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .article-detail__ai-warning {
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.5;
    color: var(--navy-2);
  }

  :global(.dark) .article-detail__ai-warnings {
    background-color: rgba(250, 247, 240, 0.06);
  }

  :global(.dark) .article-detail__ai-warnings-title {
    color: var(--sepia-light);
  }

  /* CTA button */
  .article-detail__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    background-color: var(--navy-light);
    color: var(--sepia-light);
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 500;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    align-self: flex-start;
  }

  .article-detail__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }

  :global(.dark) .article-detail__cta {
    background-color: var(--ev-text-on-image);
    color: var(--ev-bg-accent);
  }

  /* Related articles */
  .article-detail__related {
    margin-top: 48px;
    padding-top: 36px;
    border-top: 2px solid var(--navy-2);
  }

  .article-detail__related-title {
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 700;
    color: var(--navy-light);
    margin-bottom: 24px;
  }

  .article-detail__related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .article-detail__related-grid :global(.article-card__photo) {
    height: 200px;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .article-detail__title {
      font-size: 42px;
    }

    .article-detail__excerpt {
      font-size: 18px;
    }

    .article-detail__related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .article-detail {
      padding: 0 12px 72px;
      gap: 36px;
    }

    .article-detail__hero {
      border-radius: 12px;
    }

    /* Header: date on the left, tone + comments + bookmark on the right,
       source/category tags centered on their own row below. */
    .article-detail__header {
      column-gap: 10px;
      row-gap: 16px;
    }

    .article-detail__badges {
      display: contents;
    }

    .article-detail__tags,
    .article-detail__actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .article-detail__meta {
      order: 1;
    }

    .article-detail__header > :global(.badge) {
      order: 2;
    }

    .article-detail__actions {
      order: 3;
    }

    .article-detail__tags {
      order: 4;
      flex-basis: 100%;
      justify-content: center;
    }

    .article-detail__title {
      font-size: 28px;
    }

    .article-detail__excerpt {
      font-size: 16px;
      line-height: 1.65;
    }

    .article-detail__cta {
      font-size: 15px;
      padding: 14px 28px;
    }

    .article-detail__related-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

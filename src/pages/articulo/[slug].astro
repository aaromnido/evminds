---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Badge from "@/components/Badge.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import DisqusComments from "@/components/DisqusComments.astro";
import { supabase } from "@/lib/supabase";
import { formatDate } from "@/lib/date-utils";
import { getCategorySlugByName } from "@/lib/categories";
import { getArticleUrl } from "@/lib/article-url";

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// Fetch article with source info
const { data, error } = await supabase
  .from("articles")
  .select("*, source:sources!inner(name, url)")
  .eq("slug", slug)
  .single();

if (error || !data) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const article = data as any;
const source = Array.isArray(article.source) ? article.source[0] : article.source;

// Fetch 3 related articles (same category, excluding current)
const { data: relatedData } = await supabase
  .from("articles")
  .select("*, source:sources!inner(name, url)")
  .eq("category", article.category)
  .neq("id", article.id)
  .order("scraped_at", { ascending: false })
  .limit(3);

const relatedArticles = (relatedData || []).map((a: any) => {
  const s = Array.isArray(a.source) ? a.source[0] : a.source;
  return {
    image: a.image_url || "/placeholder-image.jpg",
    title: a.title,
    date: formatDate(a.published_at),
    excerpt: a.excerpt,
    source: s.name,
    category: a.category,
    href: getArticleUrl(a.slug),
  };
});

// Page data
const heroImage = article.image_url || "/placeholder-image.jpg";
const formattedDate = formatDate(article.published_at);
const categorySlug = getCategorySlugByName(article.category);
const canonicalUrl = new URL(getArticleUrl(article.slug), Astro.site).toString();
---

<BaseLayout
  title={`${article.title} - EVMinds`}
  description={article.excerpt}
  image={article.image_url || undefined}
  type="article"
  publishedAt={article.published_at}
>
  <main class="article-detail">
    <Header />

    <article class="article-detail__content">
      <!-- Badges -->
      <div class="article-detail__badges">
        <Badge label={source.name} variant="filled" />
        {categorySlug && (
          <a href={`/categoria/${categorySlug}`} class="article-detail__category-link">
            <Badge label={article.category} variant="outlined" />
          </a>
        )}
        {!categorySlug && <Badge label={article.category} variant="outlined" />}
      </div>

      <!-- Hero image -->
      <div class="article-detail__hero">
        <img
          src={heroImage}
          alt={article.title}
          class="article-detail__hero-image"
          loading="eager"
          fetchpriority="high"
          width="900"
          height="500"
        />
      </div>

      <!-- Title -->
      <h1 class="article-detail__title">{article.title}</h1>

      <!-- Meta: date + source -->
      <div class="article-detail__meta">
        <time datetime={article.published_at}>{formattedDate}</time>
        <span class="article-detail__meta-separator">·</span>
        <a href={source.url} target="_blank" rel="noopener noreferrer" class="article-detail__source-link">
          {source.name}
        </a>
      </div>

      <!-- Excerpt -->
      <p class="article-detail__excerpt">{article.excerpt}</p>

      <!-- CTA: read full article -->
      <a
        href={article.article_url}
        target="_blank"
        rel="noopener noreferrer"
        class="article-detail__cta"
      >
        Leer artículo completo en {source.name}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          <polyline points="15 3 21 3 21 9" />
          <line x1="10" y1="14" x2="21" y2="3" />
        </svg>
      </a>

      <!-- Share buttons -->
      <ShareButtons url={canonicalUrl} title={article.title} />

      <!-- Related articles -->
      {relatedArticles.length > 0 && (
        <section class="article-detail__related" aria-label="Artículos relacionados">
          <h2 class="article-detail__related-title">Artículos relacionados</h2>
          <div class="article-detail__related-grid">
            {relatedArticles.map((props) => (
              <ArticleCard {...props} />
            ))}
          </div>
        </section>
      )}

      <!-- Disqus comments -->
      <DisqusComments
        identifier={article.id}
        url={canonicalUrl}
        title={article.title}
      />
    </article>

    <Footer />
  </main>
</BaseLayout>

<style>
  .article-detail {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    background-color: var(--sepia-light);
    min-height: 100vh;
  }

  .article-detail__content {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Badges */
  .article-detail__badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .article-detail__category-link {
    text-decoration: none;
  }

  .article-detail__category-link:hover {
    opacity: 0.8;
  }

  /* Hero image */
  .article-detail__hero {
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--ev-teal);
  }

  .article-detail__hero-image {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
    display: block;
  }

  /* Title */
  .article-detail__title {
    font-family: "Playfair Display", serif;
    font-size: 48px;
    font-weight: 700;
    font-style: italic;
    line-height: 1.1;
    color: var(--navy-light);
    letter-spacing: -0.01em;
  }

  /* Meta */
  .article-detail__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 15px;
    color: var(--navy-2);
  }

  .article-detail__meta-separator {
    font-weight: 700;
  }

  .article-detail__source-link {
    color: var(--navy-2);
    font-weight: 600;
    text-decoration: none;
  }

  .article-detail__source-link:hover {
    text-decoration: underline;
  }

  /* Excerpt */
  .article-detail__excerpt {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 19px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--navy-2);
    letter-spacing: -0.01em;
  }

  /* CTA button */
  .article-detail__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background-color: var(--navy-light);
    color: var(--sepia-light);
    border-radius: 8px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    align-self: flex-start;
  }

  .article-detail__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }

  /* Related articles */
  .article-detail__related {
    margin-top: 48px;
    padding-top: 36px;
    border-top: 1px solid rgba(25, 27, 65, 0.1);
  }

  .article-detail__related-title {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: var(--navy-light);
    margin-bottom: 24px;
  }

  .article-detail__related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .article-detail__title {
      font-size: 42px;
    }

    .article-detail__excerpt {
      font-size: 18px;
    }

    .article-detail__related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .article-detail {
      padding: 0 12px 72px;
      gap: 36px;
    }

    .article-detail__hero {
      border-radius: 12px;
    }

    .article-detail__title {
      font-size: 28px;
    }

    .article-detail__excerpt {
      font-size: 16px;
      line-height: 1.65;
    }

    .article-detail__cta {
      font-size: 15px;
      padding: 14px 28px;
    }

    .article-detail__related-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

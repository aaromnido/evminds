---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Badge from "@/components/Badge.astro";
import NewsCard from "@/components/NewsCard.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import DisqusComments from "@/components/DisqusComments.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "@/lib/date-utils";
import { getArticleUrl, getNewsUrl } from "@/lib/article-url";
import { supabase } from "@/lib/supabase";

const { slug } = Astro.params;

const allArticles = await getCollection("articulos");
const article = allArticles.find((a) => a.id === slug && !a.data.draft);

if (!article) {
  // Check if this slug exists as a news article (old /articulo/ URLs → new /noticia/)
  if (slug) {
    const { data: newsMatch } = await supabase
      .from("articles")
      .select("slug")
      .eq("slug", slug)
      .limit(1)
      .single();

    if (newsMatch) {
      return Astro.redirect(getNewsUrl(newsMatch.slug), 301);
    }
  }

  return new Response(null, { status: 404, statusText: "Not Found" });
}
const { Content } = await render(article);

const heroImage = article.data.image || "/images/placeholder-image.webp";
const formattedDate = formatDate(article.data.date.toISOString());
const canonicalUrl = new URL(getArticleUrl(article.id), Astro.site).toString();

// Related articles (same category, excluding current, max 2)
const relatedArticles = allArticles
  .filter((a) => !a.data.draft && a.id !== article.id && a.data.category === article.data.category)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
---

<BaseLayout
  title={`${article.data.title} — EVMinds`}
  description={article.data.excerpt}
  image={article.data.image || undefined}
  type="article"
  publishedAt={article.data.date.toISOString()}
  articleAuthor={article.data.author}
  articleSection={article.data.category}
  articleTags={article.data.tags}
  breadcrumbs={[
    { name: "Inicio", url: "/" },
    { name: "Artículos", url: "/articulos" },
    { name: article.data.title, url: getArticleUrl(article.id) },
  ]}
>
  <main class="article-detail">
    <Header />

    <!-- Title (centered, wide) -->
    <h1 class="article-detail__title">{article.data.title}</h1>

    <!-- Hero image (wide, like quienes-somos) -->
    <div class="article-detail__hero">
      <img
        src={heroImage}
        alt={article.data.title}
        class="article-detail__hero-image"
        loading="eager"
        fetchpriority="high"
        width="1200"
        height="500"
      />
    </div>

    <article class="article-detail__content">
      <!-- Meta + Badges -->
      <div class="article-detail__header">
        <div class="article-detail__meta">
          <time datetime={article.data.date.toISOString()}>{formattedDate}</time>
          <span class="article-detail__meta-separator">·</span>
          <span>{article.data.author}</span>
        </div>

        <div class="article-detail__badges">
          <Badge label="EVMinds" variant="filled" />
          <Badge label={article.data.category} variant="outlined" />
          {article.data.tags.map((tag) => (
            <Badge label={tag} variant="outlined" />
          ))}
        </div>
      </div>

      <!-- Full article body -->
      <div class="article-prose">
        <Content />
      </div>

      <!-- Share buttons -->
      <ShareButtons url={canonicalUrl} title={article.data.title} />

      <!-- Disqus comments -->
      <DisqusComments
        identifier={`articulo-${article.id}`}
        url={canonicalUrl}
        title={article.data.title}
      />

      <!-- Related articles -->
      {relatedArticles.length > 0 && (
        <section class="article-detail__related" aria-label="Artículos relacionados">
          <h2 class="article-detail__related-title">Artículos relacionados</h2>
          <div class="article-detail__related-grid">
            {relatedArticles.map((related) => (
              <NewsCard
                image={related.data.image || "/images/placeholder-image.webp"}
                title={related.data.title}
                date={formatDate(related.data.date.toISOString())}
                excerpt={related.data.excerpt}
                source={related.data.author}
                category={related.data.category}
                href={getArticleUrl(related.id)}
                articleId={`articulo-${related.id}`}
                articleSlug={related.id}
                identifier={`articulo-${related.id}`}
              />
            ))}
          </div>
        </section>
      )}
    </article>

    <Footer />
  </main>
</BaseLayout>

<style>
  .article-detail {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    min-height: 100vh;
  }

  /* Title (centered, wide) */
  .article-detail__title {
    font-family: "Playfair Display", serif;
    font-size: 56px;
    font-style: italic;
    font-weight: 700;
    line-height: 1.1;
    color: var(--navy-2);
    letter-spacing: -0.01em;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    padding: 48px 0 0;
  }

  /* Hero image (wide, like quienes-somos) */
  .article-detail__hero {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 16px;
  }

  .article-detail__hero-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-height: 500px;
  }

  .article-detail__content {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .article-detail__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .article-detail__badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .article-detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }


  .article-detail__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 15px;
    color: var(--navy-2);
  }

  .article-detail__meta-separator {
    font-weight: 700;
  }

  /* Prose styles for rendered Markdown */
  .article-prose {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.75;
    color: var(--navy-2);
    letter-spacing: -0.01em;
  }

  .article-prose :global(h2) {
    font-family: "Playfair Display", serif;
    font-size: 32px;
    font-weight: 700;
    font-style: italic;
    line-height: 1.2;
    color: var(--navy-light);
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .article-prose :global(h3) {
    font-family: "Playfair Display", serif;
    font-size: 24px;
    font-weight: 700;
    font-style: italic;
    line-height: 1.3;
    color: var(--navy-light);
    margin-top: 36px;
    margin-bottom: 12px;
  }

  .article-prose :global(h4) {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--navy-light);
    margin-top: 28px;
    margin-bottom: 8px;
  }

  .article-prose :global(p) {
    margin-bottom: 20px;
  }

  .article-prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 28px 0;
    display: block;
  }

  .article-prose :global(a) {
    color: var(--ev-primary-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-prose :global(a:hover) {
    opacity: 0.8;
  }

  .article-prose :global(strong) {
    font-weight: 700;
    color: var(--navy-light);
  }

  .article-prose :global(em) {
    font-style: italic;
  }

  .article-prose :global(blockquote) {
    border-left: 3px solid var(--ev-primary-blue);
    padding-left: 20px;
    margin: 24px 0;
    font-style: italic;
    opacity: 0.85;
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin: 16px 0;
    padding-left: 24px;
  }

  .article-prose :global(li) {
    margin-bottom: 8px;
  }

  .article-prose :global(code) {
    font-size: 0.9em;
    background-color: color-mix(in srgb, var(--navy-2) 8%, transparent);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .article-prose :global(pre) {
    background-color: var(--navy-light);
    color: var(--sepia-light);
    padding: 20px;
    border-radius: 8px;
    overflow-x: auto;
    margin: 24px 0;
  }

  .article-prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .article-prose :global(hr) {
    border: none;
    border-top: 2px solid var(--navy-2);
    margin: 40px 0;
    opacity: 0.15;
  }

  /* Related articles */
  .article-detail__related {
    margin-top: 48px;
    padding-top: 36px;
    border-top: 2px solid var(--navy-2);
  }

  .article-detail__related-title {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: var(--navy-light);
    margin-bottom: 24px;
  }

  .article-detail__related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .article-detail__title {
      font-size: 42px;
    }

    .article-prose {
      font-size: 17px;
    }

    .article-prose :global(h2) {
      font-size: 28px;
    }

    .article-prose :global(h3) {
      font-size: 22px;
    }
  }

  @media (max-width: 768px) {
    .article-detail {
      padding: 0 12px 72px;
      gap: 36px;
    }

    .article-detail__hero {
      border-radius: 12px;
      max-width: none;
    }

    .article-detail__hero-image {
      max-height: 300px;
    }

    .article-detail__title {
      font-size: 28px;
      padding: 24px 0 0;
    }

    .article-prose {
      font-size: 16px;
      line-height: 1.7;
    }

    .article-prose :global(h2) {
      font-size: 24px;
      margin-top: 36px;
    }

    .article-prose :global(h3) {
      font-size: 20px;
      margin-top: 28px;
    }

    .article-prose :global(img) {
      border-radius: 8px;
      margin: 20px 0;
    }

    .article-detail__related-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Badge from "@/components/Badge.astro";
import NewsCard from "@/components/NewsCard.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import DisqusComments from "@/components/DisqusComments.astro";
import { getCollection, render } from "astro:content";
import { formatDate } from "@/lib/date-utils";
import { calculateReadingTime } from "@/lib/reading-time";
import { getArticleUrl, getNewsUrl } from "@/lib/article-url";
import { supabase } from "@/lib/supabase";
import { getOwnArticles } from "@/lib/own-articles";

const { slug } = Astro.params;

const now = new Date();

// --- Dual content source during the .md → posts transition (Fase 4) ---
// Try the own markdown collection first (unchanged behaviour for the 5 existing
// articles), then the `posts` table. RLS (posts_public_read) returns only
// published & due rows, so drafts/scheduled never leak.
const allArticles = await getCollection("articulos");
const mdArticle = allArticles.find(
  (a) => a.id === slug && !a.data.draft && a.data.date <= now,
);

interface ArticleView {
  title: string;
  excerpt: string;
  image?: string;
  imageAlt?: string;
  date: Date;
  author: string;
  category: string;
  tags: string[];
  slug: string;
  bodyText: string; // plain text used only for reading-time
}

let view: ArticleView | null = null;
let Content: Awaited<ReturnType<typeof render>>["Content"] | null = null;
let bodyHtml: string | null = null;

if (mdArticle) {
  Content = (await render(mdArticle)).Content;
  view = {
    title: mdArticle.data.title,
    excerpt: mdArticle.data.excerpt,
    image: mdArticle.data.image,
    imageAlt: mdArticle.data.imageAlt,
    date: mdArticle.data.date,
    author: mdArticle.data.author,
    category: mdArticle.data.category,
    tags: mdArticle.data.tags,
    slug: mdArticle.id,
    bodyText: mdArticle.body ?? "",
  };
} else if (slug) {
  const { data: post } = await supabase
    .from("posts")
    .select("*")
    .eq("slug", slug)
    .maybeSingle();
  if (post) {
    const p = post as unknown as {
      title: string;
      excerpt: string;
      content: string;
      image_url: string | null;
      image_alt: string | null;
      author: string;
      category: string;
      tags: string[] | null;
      published_at: string | null;
      slug: string;
    };
    bodyHtml = p.content;
    view = {
      title: p.title,
      excerpt: p.excerpt,
      image: p.image_url ?? undefined,
      imageAlt: p.image_alt ?? undefined,
      date: p.published_at ? new Date(p.published_at) : now,
      author: p.author,
      category: p.category,
      tags: p.tags ?? [],
      slug: p.slug,
      bodyText: p.content.replace(/<[^>]+>/g, " "),
    };
  }
}

if (!view) {
  // Old /articulo/ URL that's actually a news item → 301 to /noticia/
  if (slug) {
    const { data: newsMatch } = await supabase
      .from("articles")
      .select("slug")
      .eq("slug", slug)
      .limit(1)
      .single();

    if (newsMatch) {
      return Astro.redirect(getNewsUrl(newsMatch.slug), 301);
    }
  }

  return new Response(null, { status: 404, statusText: "Not Found" });
}

const v = view;
const heroImage = v.image || "/images/placeholder-image.webp";
const formattedDate = formatDate(v.date.toISOString());
const readingTime = calculateReadingTime(v.bodyText);
const canonicalUrl = new URL(getArticleUrl(v.slug), Astro.site).toString();

// Related articles: score by shared tags (x2) + same category (+1), fallback to
// most recent. Drawn from the unified own-content pool (.md + posts).
const ownArticles = await getOwnArticles();
const relatedArticles = ownArticles
  .filter((a) => a.slug !== v.slug)
  .map((a) => {
    const sharedTags = a.tags.filter((t) => v.tags.includes(t)).length;
    const sameCategory = a.category === v.category ? 1 : 0;
    return { article: a, score: sharedTags * 2 + sameCategory };
  })
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return b.article.date.getTime() - a.article.date.getTime();
  })
  .slice(0, 2)
  .map((x) => x.article);
---

<BaseLayout
  title={`${v.title} — EVMinds`}
  description={v.excerpt}
  image={v.image || undefined}
  type="article"
  publishedAt={v.date.toISOString()}
  articleAuthor={v.author}
  articleSection={v.category}
  articleTags={v.tags}
  breadcrumbs={[
    { name: "Inicio", url: "/" },
    { name: "Artículos", url: "/articulos" },
    { name: v.title, url: getArticleUrl(v.slug) },
  ]}
>
  <main class="article-detail">
    <Header />

    <!-- Title (centered, wide) -->
    <h1 class="article-detail__title">{v.title}</h1>

    <!-- Hero image (wide, like quienes-somos) -->
    <div class="article-detail__hero">
      <img
        src={heroImage}
        alt={v.imageAlt || v.title}
        class="article-detail__hero-image"
        loading="eager"
        fetchpriority="high"
        width="1200"
        height="500"
      />
    </div>

    <article class="article-detail__content">
      <!-- Meta + Badges -->
      <div class="article-detail__header">
        <div class="article-detail__meta">
          <time datetime={v.date.toISOString()}>{formattedDate}</time>
          <span class="article-detail__meta-separator">·</span>
          <span>{v.author}</span>
          <span class="article-detail__meta-separator">·</span>
          <span>{readingTime} min de lectura</span>
        </div>

        <div class="article-detail__badges">
          <Badge label="EVMinds" variant="filled" />
          <Badge label={v.category} variant="outlined" />
          {v.tags.map((tag) => (
            <Badge label={tag} variant="outlined" />
          ))}
        </div>
      </div>

      <!-- Full article body: .md renders via <Content/>, posts via raw HTML -->
      <div class="article-prose">
        {Content ? <Content /> : <Fragment set:html={bodyHtml} />}
      </div>

      <!-- Share buttons -->
      <ShareButtons url={canonicalUrl} title={v.title} />

      <!-- Disqus comments. Identifier is articulo-${slug} (NOT a UUID) so threads
           stay linked when .md articles migrate to posts in Fase 5. -->
      <DisqusComments
        identifier={`articulo-${v.slug}`}
        url={canonicalUrl}
        title={v.title}
      />

      <!-- Related articles -->
      {relatedArticles.length > 0 && (
        <section class="article-detail__related" aria-label="Artículos relacionados">
          <h2 class="article-detail__related-title">Artículos relacionados</h2>
          <div class="article-detail__related-grid">
            {relatedArticles.map((related) => (
              <NewsCard
                image={related.image || "/images/placeholder-image.webp"}
                title={related.title}
                date={formatDate(related.date.toISOString())}
                excerpt={related.excerpt}
                source={related.author}
                category={related.category}
                href={getArticleUrl(related.slug)}
                articleId={`articulo-${related.slug}`}
                articleSlug={related.slug}
                identifier={`articulo-${related.slug}`}
              />
            ))}
          </div>
        </section>
      )}
    </article>

    <Footer />
  </main>
</BaseLayout>

<style>
  .article-detail {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    min-height: 100vh;
  }

  /* Title (centered, wide) */
  .article-detail__title {
    font-family: "Playfair Display", serif;
    font-size: 56px;
    font-style: italic;
    font-weight: 700;
    line-height: 1.1;
    color: var(--navy-2);
    letter-spacing: -0.01em;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    padding: 48px 0 0;
  }

  /* Hero image (wide, like quienes-somos) */
  .article-detail__hero {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 16px;
  }

  .article-detail__hero-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-height: 500px;
  }

  .article-detail__content {
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .article-detail__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .article-detail__badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .article-detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }


  .article-detail__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 15px;
    color: var(--navy-2);
  }

  .article-detail__meta-separator {
    font-weight: 700;
  }

  /* Prose styles for rendered Markdown */
  .article-prose {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.75;
    color: var(--navy-2);
    letter-spacing: -0.01em;
  }

  .article-prose :global(h2) {
    font-family: "Playfair Display", serif;
    font-size: 32px;
    font-weight: 700;
    font-style: italic;
    line-height: 1.2;
    color: var(--navy-light);
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .article-prose :global(h3) {
    font-family: "Playfair Display", serif;
    font-size: 24px;
    font-weight: 700;
    font-style: italic;
    line-height: 1.3;
    color: var(--navy-light);
    margin-top: 36px;
    margin-bottom: 12px;
  }

  .article-prose :global(h4) {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--navy-light);
    margin-top: 28px;
    margin-bottom: 8px;
  }

  .article-prose :global(p) {
    margin-bottom: 20px;
  }

  .article-prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 28px 0;
    display: block;
  }

  .article-prose :global(a) {
    color: var(--ev-primary-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-prose :global(a:hover) {
    opacity: 0.8;
  }

  .article-prose :global(strong) {
    font-weight: 700;
    color: var(--navy-light);
  }

  .article-prose :global(em) {
    font-style: italic;
  }

  .article-prose :global(blockquote) {
    border-left: 3px solid var(--ev-primary-blue);
    padding-left: 20px;
    margin: 24px 0;
    font-style: italic;
    opacity: 0.85;
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin: 16px 0;
    padding-left: 24px;
  }

  .article-prose :global(li) {
    margin-bottom: 8px;
  }

  .article-prose :global(code) {
    font-size: 0.9em;
    background-color: color-mix(in srgb, var(--navy-2) 8%, transparent);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .article-prose :global(pre) {
    background-color: var(--navy-light);
    color: var(--sepia-light);
    padding: 20px;
    border-radius: 8px;
    overflow-x: auto;
    margin: 24px 0;
  }

  .article-prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .article-prose :global(.data-card) {
    background-color: var(--ev-bg-accent);
    color: var(--ev-text-on-image);
    border-radius: 16px;
    padding: 28px 32px;
    margin: 32px 0;
  }

  .article-prose :global(.data-card h2),
  .article-prose :global(.data-card h3) {
    color: var(--ev-text-on-image);
    margin-top: 0;
    margin-bottom: 16px;
  }

  .article-prose :global(.data-card dl) {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 48px;
    row-gap: 24px;
    margin: 0;
  }

  .article-prose :global(.data-card dt) {
    font-weight: 700;
    color: var(--ev-text-on-image);
    opacity: 0.75;
  }

  .article-prose :global(.data-card dd) {
    margin: 0;
    color: var(--ev-text-on-image);
  }

  @media (max-width: 640px) {
    .article-prose :global(.data-card dl) {
      grid-template-columns: 1fr;
      row-gap: 4px;
    }

    .article-prose :global(.data-card dd) {
      margin-bottom: 8px;
    }
  }

  .article-prose :global(.data-card strong) {
    color: var(--ev-text-on-image);
    font-weight: 700;
  }

  .article-prose :global(hr) {
    border: none;
    border-top: 2px solid var(--navy-2);
    margin: 40px 0;
    opacity: 0.15;
  }

  /* Related articles */
  .article-detail__related {
    margin-top: 48px;
    padding-top: 36px;
    border-top: 2px solid var(--navy-2);
  }

  .article-detail__related-title {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: var(--navy-light);
    margin-bottom: 24px;
  }

  .article-detail__related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .article-detail__title {
      font-size: 42px;
    }

    .article-prose {
      font-size: 17px;
    }

    .article-prose :global(h2) {
      font-size: 28px;
    }

    .article-prose :global(h3) {
      font-size: 22px;
    }
  }

  @media (max-width: 768px) {
    .article-detail {
      padding: 0 12px 72px;
      gap: 36px;
    }

    .article-detail__hero {
      border-radius: 12px;
      max-width: none;
    }

    .article-detail__hero-image {
      max-height: 300px;
    }

    .article-detail__title {
      font-size: 28px;
      padding: 24px 0 0;
    }

    .article-prose {
      font-size: 16px;
      line-height: 1.7;
    }

    .article-prose :global(h2) {
      font-size: 24px;
      margin-top: 36px;
    }

    .article-prose :global(h3) {
      font-size: 20px;
      margin-top: 28px;
    }

    .article-prose :global(img) {
      border-radius: 8px;
      margin: 20px 0;
    }

    .article-detail__related-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

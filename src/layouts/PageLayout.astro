---
interface Props {
  variant?: "default" | "compact";
}

const { variant = "default" } = Astro.props;
---

<main class:list={["page", { "page--compact": variant === "compact" }]}>
  <slot />
</main>

<style>
  .page {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    background-color: var(--sepia-light);
    min-height: 100vh;
  }

  .page--compact {
    padding: 0 48px 48px;
    gap: 24px;
  }

  @media (max-width: 768px) {
    .page {
      padding: 0 12px 72px;
      gap: 36px;
    }

    .page--compact {
      padding: 0 12px 48px;
      gap: 24px;
    }
  }
</style>

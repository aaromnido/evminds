---
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminSidebarLayout from "@/components/admin/AdminSidebarLayout.tsx";

interface Props {
  /** Browser tab title. */
  title?: string;
  /** Page title shown in the top bar. */
  pageTitle: string;
  pageDescription?: string;
  /** Optional primary action on the right of the top bar. */
  actionLabel?: string;
  actionHref?: string;
}

const {
  title = "Admin · evminds",
  pageTitle,
  pageDescription,
  actionLabel,
  actionHref,
} = Astro.props;

// Set by the middleware on authenticated admin requests.
const userEmail = Astro.locals.user?.email ?? "";
const activePath = Astro.url.pathname;

// Sidebar open/collapsed state persists in the sidebar_state cookie (see
// ui/sidebar.tsx). Read it server-side so the state survives View Transition
// re-hydration without a hydration mismatch. Defaults to open.
const sidebarDefaultOpen = Astro.cookies.get("sidebar_state")?.value !== "false";
---

<AdminLayout title={title}>
  <AdminSidebarLayout
    client:load
    userEmail={userEmail}
    activePath={activePath}
    defaultOpen={sidebarDefaultOpen}
    pageTitle={pageTitle}
    pageDescription={pageDescription}
    actionLabel={actionLabel}
    actionHref={actionHref}
  >
    <slot />
  </AdminSidebarLayout>
</AdminLayout>

---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { buttonVariants } from "@/components/ui/button";

interface Props {
  title?: string;
}

const { title = "Admin · evminds" } = Astro.props;
// Set by the middleware on authenticated admin requests.
const userEmail = Astro.locals.user?.email ?? "";
---

<AdminLayout title={title}>
  <div class="flex min-h-dvh flex-col">
    <header
      class="flex items-center justify-between gap-4 border-b border-border bg-card px-6 py-3"
    >
      <a href="/admin" class="text-lg font-bold tracking-tight">
        evminds <span class="font-medium text-muted-foreground">admin</span>
      </a>
      <div class="flex items-center gap-3">
        {
          userEmail && (
            <span class="text-sm text-muted-foreground">{userEmail}</span>
          )
        }
        <form method="POST" action="/admin/logout">
          <button type="submit" class={buttonVariants({ variant: "outline", size: "sm" })}>
            Salir
          </button>
        </form>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-8">
      <slot />
    </main>
  </div>
</AdminLayout>

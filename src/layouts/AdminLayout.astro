---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "Admin · evminds" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- The admin must never be indexed. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#191B41" />
    <title>{title}</title>

    <!-- Client-side navigation: lets us show a skeleton during page transitions. -->
    <ClientRouter />

    <!-- Mark list regions as "loading" while the next page is fetched (View
         Transitions). The new DOM arrives without data-loading, so no reset is
         needed. Registered once on document; persists across navigations. -->
    <script is:inline>
      document.addEventListener("astro:before-preparation", () => {
        document
          .querySelectorAll("[data-list-region]")
          .forEach((el) => el.setAttribute("data-loading", ""));
      });
    </script>

    <!-- Apply dark class before first paint (FOUC prevention), same as BaseLayout -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("evminds-theme");
        var prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <slot />
  </body>
</html>

---
import "@/styles/global.css";

interface Props {
  title?: string;
}

const { title = "Admin · evminds" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- The admin must never be indexed. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#191B41" />
    <title>{title}</title>

    <!-- Apply dark class before first paint (FOUC prevention), same as BaseLayout -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("evminds-theme");
        var prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <slot />
  </body>
</html>

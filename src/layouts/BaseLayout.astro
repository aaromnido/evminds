---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
}

const {
  title = 'evminds.es — Movilidad Eléctrica',
  description = 'Un único lugar donde encontrar todas las noticias relevantes sobre movilidad eléctrica en español. Coches eléctricos, baterías, renovables e infraestructura de carga.',
  image = '/logo.svg',
  type = 'website',
  publishedAt,
} = Astro.props;

const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const jsonLd = type === 'article' ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": ogImageURL.toString(),
  "datePublished": publishedAt,
  "url": canonicalURL.toString(),
  "publisher": {
    "@type": "Organization",
    "name": "EVMinds.es",
    "url": Astro.site?.toString(),
  },
}) : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect to Google Fonts for faster font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="EVMinds.es" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Additional SEO -->
    <meta name="keywords" content="movilidad eléctrica, coches eléctricos, baterías, energías renovables, infraestructura de carga, vehículos eléctricos, EV, noticias EV" />
    <meta name="author" content="EVMinds.es" />
    <meta name="robots" content="index, follow" />

    <!-- Umami Analytics -->
    {umamiWebsiteId && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={umamiWebsiteId}
      ></script>
    )}

    <!-- Article-specific meta tags -->
    {type === 'article' && publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}

    <!-- JSON-LD structured data for articles -->
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={jsonLd} />
    )}

    <!-- Theme: apply dark class before first paint (FOUC prevention) -->
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('evminds-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Client Router for smooth page transitions -->
    <ClientRouter />
  </head>
  <body>
    <slot />

    <!-- Theme toggle system -->
    <script>
      function getTheme(): 'light' | 'dark' {
        const stored = localStorage.getItem('evminds-theme');
        if (stored === 'dark' || stored === 'light') return stored;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function setTheme(theme: 'light' | 'dark') {
        localStorage.setItem('evminds-theme', theme);
        document.documentElement.classList.toggle('dark', theme === 'dark');
      }

      function toggleTheme(): 'light' | 'dark' {
        const next = getTheme() === 'dark' ? 'light' : 'dark';
        setTheme(next);
        document.dispatchEvent(new CustomEvent('evminds:theme-change', { detail: { theme: next } }));
        return next;
      }

      (window as any).__evminds_theme = { get: getTheme, set: setTheme, toggle: toggleTheme };

      // Re-sync on View Transitions (html class may be reset during swap)
      function syncTheme() { setTheme(getTheme()); }
      syncTheme();
      document.addEventListener('astro:page-load', syncTheme);
    </script>

    <!-- Bookmark system (global event delegation + state sync) -->
    <script>
      import { isBookmarked, toggleBookmark } from "@/lib/bookmarks";
      import type { BookmarkEntry } from "@/lib/bookmarks";

      // Expose for inline scripts (infinite scroll dynamic cards)
      (window as any).__evminds_bookmarks = { isBookmarked, toggleBookmark };

      function updateBookmarkIcon(btn: Element, active: boolean) {
        const defaultIcon = btn.querySelector(".bookmark-btn__icon--default") as HTMLElement;
        const activeIcon = btn.querySelector(".bookmark-btn__icon--active") as HTMLElement;
        if (defaultIcon) defaultIcon.style.display = active ? "none" : "";
        if (activeIcon) activeIcon.style.display = active ? "" : "none";
        btn.setAttribute("aria-pressed", String(active));
        btn.setAttribute("aria-label", active ? "Quitar de guardados" : "Guardar artículo");
      }

      function syncAllBookmarkIcons() {
        document.querySelectorAll(".bookmark-btn").forEach((btn) => {
          const id = btn.getAttribute("data-article-id");
          if (id) updateBookmarkIcon(btn, isBookmarked(id));
        });
      }

      // Event delegation in capture phase — intercepts click before <a> navigates
      document.addEventListener("click", (e) => {
        const btn = (e.target as Element).closest(".bookmark-btn");
        if (!btn) return;

        e.preventDefault();
        e.stopPropagation();

        const id = btn.getAttribute("data-article-id");
        const dataStr = btn.getAttribute("data-article");
        if (!id || !dataStr) return;

        try {
          const entry: BookmarkEntry = JSON.parse(dataStr);
          const nowBookmarked = toggleBookmark(entry);
          updateBookmarkIcon(btn, nowBookmarked);

          // Sync other buttons for the same article on this page
          document.dispatchEvent(
            new CustomEvent("evminds:bookmark-change", {
              detail: { id, bookmarked: nowBookmarked },
            })
          );
        } catch {
          // Silently fail if data-article is malformed
        }
      }, true); // capture: true — intercepts before <a> bubbling phase

      // Sync duplicate buttons when bookmark changes
      document.addEventListener("evminds:bookmark-change", ((e: CustomEvent) => {
        const { id, bookmarked } = e.detail;
        document.querySelectorAll(`.bookmark-btn[data-article-id="${id}"]`).forEach((btn) => {
          updateBookmarkIcon(btn, bookmarked);
        });
      }) as EventListener);

      // Re-sync icons after View Transitions navigation
      syncAllBookmarkIcons();
      document.addEventListener("astro:page-load", syncAllBookmarkIcons);
    </script>

    <!-- Disqus Comment Count Script -->
    <script is:inline src="https://evminds-es.disqus.com/count.js" async id="dsq-count-scr"></script>
    <script is:inline>
      // Create visible badge dynamically only when comment count >= 1
      window.cleanDisqusCounts = function() {
        document.querySelectorAll('.disqus-comment-count').forEach(function(el) {
          var text = el.textContent || '';
          var match = text.match(/\d+/);
          var count = match ? parseInt(match[0], 10) : 0;
          var parent = el.parentElement;
          if (!parent) return;

          // Remove any previously injected badge (handles View Transitions re-runs)
          var existing = parent.querySelector('.comment-count-badge');
          if (existing) existing.remove();

          if (count > 0) {
            var badge = document.createElement('span');
            badge.className = 'comment-count-badge';

            var countText = document.createTextNode(count.toString() + ' ');
            badge.appendChild(countText);

            var icon = document.createElement('img');
            icon.src = '/icon-comment-white.svg';
            icon.alt = '';
            icon.width = 16;
            icon.height = 16;
            badge.appendChild(icon);

            parent.insertBefore(badge, el);
          }
        });
      }

      function refreshDisqusCount() {
        if (window.DISQUSWIDGETS) {
          window.DISQUSWIDGETS.getCount({ reset: true });
          setTimeout(cleanDisqusCounts, 500);
        }
      }

      function waitForDisqus() {
        if (window.DISQUSWIDGETS) {
          refreshDisqusCount();
        } else {
          setTimeout(waitForDisqus, 100);
        }
      }

      if (document.readyState === 'complete') {
        waitForDisqus();
      } else {
        window.addEventListener('load', waitForDisqus);
      }

      document.addEventListener('astro:page-load', refreshDisqusCount);
    </script>
  </body>
</html>

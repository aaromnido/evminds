---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
}

const {
  title = 'evminds.es — Movilidad Eléctrica',
  description = 'Un único lugar donde encontrar todas las noticias relevantes sobre movilidad eléctrica en español. Coches eléctricos, baterías, renovables e infraestructura de carga.',
  image = '/logo.svg',
  type = 'website',
  publishedAt,
} = Astro.props;

const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const jsonLd = type === 'article' ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": ogImageURL.toString(),
  "datePublished": publishedAt,
  "url": canonicalURL.toString(),
  "publisher": {
    "@type": "Organization",
    "name": "EVMinds.es",
    "url": Astro.site?.toString(),
  },
}) : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect to Google Fonts for faster font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="EVMinds.es" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Additional SEO -->
    <meta name="keywords" content="movilidad eléctrica, coches eléctricos, baterías, energías renovables, infraestructura de carga, vehículos eléctricos, EV, noticias EV" />
    <meta name="author" content="EVMinds.es" />
    <meta name="robots" content="index, follow" />

    <!-- Umami Analytics -->
    {umamiWebsiteId && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={umamiWebsiteId}
      ></script>
    )}

    <!-- Article-specific meta tags -->
    {type === 'article' && publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}

    <!-- JSON-LD structured data for articles -->
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={jsonLd} />
    )}

    <!-- Client Router for smooth page transitions -->
    <ClientRouter />
  </head>
  <body>
    <slot />

    <!-- Disqus Comment Count Script -->
    <script is:inline src="https://evminds-es.disqus.com/count.js" async id="dsq-count-scr"></script>
    <script is:inline>
      // Extract only the number from Disqus count text (e.g., "6 Comments" -> "6")
      // Hide badge if no comments (0 or no data)
      window.cleanDisqusCounts = function() {
        document.querySelectorAll('.disqus-comment-count').forEach(function(el) {
          const text = el.textContent || '';
          const match = text.match(/\d+/);
          const count = match ? parseInt(match[0], 10) : 0;
          const badge = el.parentElement;

          if (count > 0) {
            el.textContent = count.toString();
            if (badge) badge.style.display = '';
          } else {
            el.textContent = '';
            if (badge) badge.style.display = 'none';
          }
        });
      }

      function refreshDisqusCount() {
        if (window.DISQUSWIDGETS) {
          window.DISQUSWIDGETS.getCount({ reset: true });
          // Clean up after Disqus updates (slight delay for DOM update)
          setTimeout(cleanDisqusCounts, 500);
        }
      }

      // Wait for Disqus script to load, then refresh counts
      function waitForDisqus() {
        if (window.DISQUSWIDGETS) {
          refreshDisqusCount();
        } else {
          setTimeout(waitForDisqus, 100);
        }
      }

      // On initial page load
      if (document.readyState === 'complete') {
        waitForDisqus();
      } else {
        window.addEventListener('load', waitForDisqus);
      }

      // On View Transitions navigation
      document.addEventListener('astro:page-load', refreshDisqusCount);
    </script>
  </body>
</html>

---
import Badge from "./Badge.astro";

interface Props {
  image?: string;
  title: string;
  date: string;
  excerpt: string;
  category: string;
  href: string;
  author?: string;
}

const {
  image,
  title,
  date,
  excerpt,
  category,
  href,
  author = "EVMinds",
} = Astro.props;

const heroImage = image || "/images/placeholder-image.webp";
---

<article class="article-card">
  <a href={href} class="article-card__photo-link">
    <div class="article-card__photo">
      <img
        src={heroImage}
        alt={title}
        loading="lazy"
        width="600"
        height="300"
      />
    </div>
  </a>

  <div class="article-card__content">
    <div class="article-card__header">
      <a href={href} class="article-card__title-link">
        <h3 class="article-card__title">{title}</h3>
      </a>
      <svg
        class="article-card__arrow"
        width="11"
        height="11"
        viewBox="0 0 11 11"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M1 10L10 1M10 1H3M10 1V8"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    <p class="article-card__date">{date}</p>

    <div class="article-card__footer">
      <div class="article-card__badges">
        <Badge label={author} variant="filled" />
        <Badge label={category} variant="outlined" />
      </div>
    </div>
  </div>
</article>

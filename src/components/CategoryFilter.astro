---
import { CATEGORIES } from "@/lib/categories";
import { loadSources } from "@/lib/sources";
import Select from "./Select.astro";

interface Props {
  activeCategory?: string | null;
  availableCategorySlugs?: string[];
  activeSource?: string | null;
}

const {
  activeCategory = null,
  availableCategorySlugs,
  activeSource = null,
} = Astro.props;

// Filter categories to only show those with articles (if availableCategorySlugs is provided)
const visibleCategories = availableCategorySlugs
  ? CATEGORIES.filter((cat) => availableCategorySlugs.includes(cat.slug))
  : CATEGORIES;

// Load all active sources from database
const visibleSources = await loadSources();

// Get current URL for constructing filter links
const currentUrl = new URL(Astro.request.url);
const currentPath = currentUrl.pathname;

// Prepare category options
const categoryOptions = [
  {
    label: "Todas las categorías",
    href: activeSource ? `/?source=${activeSource}` : "/",
    isActive: !activeCategory,
  },
  ...visibleCategories.map((category) => ({
    label: category.name,
    href: activeSource
      ? `/categoria/${category.slug}?source=${activeSource}`
      : `/categoria/${category.slug}`,
    slug: category.slug,
    isActive: activeCategory === category.slug,
  })),
];

// Prepare source options
const sourceOptions = [
  {
    label: "Todos los medios",
    href: activeCategory ? `/categoria/${activeCategory}` : "/",
    isActive: !activeSource,
  },
  ...visibleSources.map((source) => {
    const queryParams = new URLSearchParams();
    queryParams.set("source", source.slug);
    const href = `${currentPath}?${queryParams.toString()}`;

    return {
      label: source.displayName,
      href,
      slug: source.slug,
      isActive: activeSource === source.slug,
    };
  }),
];

// Get active labels
const activeCategoryLabel = activeCategory
  ? visibleCategories.find((c) => c.slug === activeCategory)?.name
  : undefined;

const activeSourceLabel = activeSource
  ? visibleSources.find((s) => s.slug === activeSource)?.displayName
  : undefined;
---

<nav class="category-filter" aria-label="Filtrar por categoría y medio">
  <div class="category-filter__wrapper">
    <Select
      label="Todas las categorías"
      activeLabel={activeCategoryLabel}
      options={categoryOptions}
      dataSelector="category"
      minWidth="200px"
    />

    <Select
      label="Todos los medios"
      activeLabel={activeSourceLabel}
      options={sourceOptions}
      dataSelector="media"
      minWidth="160px"
    />
  </div>
</nav>

<style>
  .category-filter {
    flex-shrink: 0;
  }

  .category-filter__wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 4px 0;
  }

  @media (max-width: 768px) {
    .category-filter__wrapper {
      gap: 8px;
    }
  }
</style>

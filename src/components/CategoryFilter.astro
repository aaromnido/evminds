---
import { CATEGORIES } from "@/lib/categories";

interface Props {
  activeCategory?: string | null;
  availableCategorySlugs?: string[];
}

const { activeCategory = null, availableCategorySlugs } = Astro.props;

// Filter categories to only show those with articles (if availableCategorySlugs is provided)
const visibleCategories = availableCategorySlugs
  ? CATEGORIES.filter((cat) => availableCategorySlugs.includes(cat.slug))
  : CATEGORIES;
---

<nav class="category-filter" aria-label="Filtrar por categoría">
  <div class="category-filter__container">
    <a
      href="/"
      class:list={[
        "category-filter__chip",
        { "category-filter__chip--active": !activeCategory },
      ]}
      aria-current={!activeCategory ? "page" : undefined}
    >
      Todas
    </a>

    {
      visibleCategories.map((category) => (
        <a
          href={`/categoria/${category.slug}`}
          class:list={[
            "category-filter__chip",
            {
              "category-filter__chip--active":
                activeCategory === category.slug,
            },
          ]}
          aria-current={activeCategory === category.slug ? "page" : undefined}
        >
          {category.name}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .category-filter {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
  }

  .category-filter::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .category-filter__container {
    display: flex;
    gap: 12px;
    padding: 4px 0;
    min-width: min-content;
  }

  .category-filter__chip {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: 100px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s ease;
    border: 1.5px solid var(--navy-2);
    color: var(--navy-2);
    background-color: transparent;
    cursor: pointer;
  }

  .category-filter__chip:hover {
    background-color: color-mix(in srgb, var(--navy-2) 5%, transparent);
  }

  .category-filter__chip--active {
    background-color: var(--navy-2);
    color: var(--sepia-light);
    border-color: var(--navy-2);
  }

  .category-filter__chip--active:hover {
    background-color: color-mix(in srgb, var(--navy-2) 90%, black);
  }

  /* Mobile: reduce padding */
  @media (max-width: 768px) {
    .category-filter__chip {
      padding: 8px 14px;
      font-size: 13px;
    }

    .category-filter__container {
      gap: 8px;
    }
  }
</style>

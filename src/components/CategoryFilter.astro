---
import { CATEGORIES } from "@/lib/categories";
import Select from "./Select.astro";
import PreferencesButton from "./PreferencesButton.astro";

interface Props {
  activeCategory?: string | null;
  availableCategorySlugs?: string[];
  activeSource?: string | null;
}

const {
  activeCategory = null,
  availableCategorySlugs,
  activeSource = null,
} = Astro.props;

// Filter categories to only show those with articles (if availableCategorySlugs is provided)
const visibleCategories = availableCategorySlugs
  ? CATEGORIES.filter((cat) => availableCategorySlugs.includes(cat.slug))
  : CATEGORIES;

// Prepare category options
const categoryOptions = [
  {
    label: "Todas las categorías",
    href: activeSource ? `/?source=${activeSource}` : "/",
    isActive: !activeCategory,
  },
  ...visibleCategories.map((category) => ({
    label: category.name,
    href: activeSource
      ? `/categoria/${category.slug}?source=${activeSource}`
      : `/categoria/${category.slug}`,
    slug: category.slug,
    isActive: activeCategory === category.slug,
  })),
];

// Get active label
const activeCategoryLabel = activeCategory
  ? visibleCategories.find((c) => c.slug === activeCategory)?.name
  : undefined;
---

<nav class="category-filter" aria-label="Filtrar por categoría">
  <div class="category-filter__wrapper">
    <Select
      label="Todas las categorías"
      activeLabel={activeCategoryLabel}
      options={categoryOptions}
      dataSelector="category"
      minWidth="210px"
    />

    <PreferencesButton />
  </div>
</nav>

<style>
  .category-filter {
    flex-shrink: 0;
  }

  .category-filter__wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 4px 0;
  }

  @media (max-width: 768px) {
    .category-filter {
      width: 100%;
    }

    .category-filter__wrapper {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>

---
/**
 * Renders an article grid with optional loading skeletons.
 * Coupled with InfiniteScrollConfig + src/scripts/infinite-scroll.ts
 * which expect ids "articles-grid" and "loading-skeletons".
 */
import SkeletonCard from "./SkeletonCard.astro";

interface Props {
  ariaLabel: string;
  showSkeletons?: boolean;
}

const { ariaLabel, showSkeletons = false } = Astro.props;
---

<section class="news" aria-label={ariaLabel}>
  <div id="articles-grid" class="news__grid">
    <slot />
  </div>

  {
    showSkeletons && (
      <div id="loading-skeletons" class="news__grid" style="display: none;">
        <SkeletonCard />
        <SkeletonCard />
        <SkeletonCard />
      </div>
    )
  }
</section>

<style>
  .news {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .news__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: flex-start;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .news__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .news {
      gap: 48px;
    }

    .news__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }
  }
</style>

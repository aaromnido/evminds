---
import Badge from './Badge.astro';

interface Props {
  image: string;
  title: string;
  date: string;
  source: string;
  category: string;
  categoryVariant?: 'filled' | 'outlined' | 'light' | 'green';
  href?: string;
}

const {
  image,
  title,
  date,
  source,
  category,
  categoryVariant = 'filled',
  href = '#',
} = Astro.props;
---

<a href={href} class="featured-secondary">
  <img src={image} alt={title} class="featured-secondary__image" loading="lazy" />

  <div class="featured-secondary__footer">
    <div class="featured-secondary__badges">
      <Badge label={source} variant="light" />
      <Badge label={category} variant={categoryVariant} />
    </div>
    <h3 class="featured-secondary__title">{title}</h3>
    <p class="featured-secondary__date">{date}</p>
  </div>
</a>

<style>
  .featured-secondary {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 6px;
    overflow: hidden;
    height: 349px;
    width: 100%;
    text-decoration: none;
    background-color: var(--ev-teal);
    flex-shrink: 0;
  }

  .featured-secondary__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
  }

  .featured-secondary__footer {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: linear-gradient(to bottom, rgba(114, 114, 114, 0), var(--navy-1));
    height: 100%;
    justify-content: flex-end;
  }

  .featured-secondary__badges {
    display: flex;
    gap: 10px;
  }

  .featured-secondary__title {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    font-style: italic;
    line-height: 1.1;
    color: var(--sepia-light);
  }

  .featured-secondary__date {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: var(--sepia-light);
    white-space: nowrap;
  }
</style>

---
import Badge from "./Badge.astro";
import BookmarkButton from "./BookmarkButton.astro";
import DisqusCommentCount from "./DisqusCommentCount.astro";
import { serializeBookmarkData } from "@/lib/article-utils";

interface Props {
  image: string;
  title: string;
  date: string;
  source: string;
  category: string;
  categoryVariant?: "filled" | "outlined" | "light" | "green";
  href?: string;
  identifier?: string;
  articleId?: string;
  articleSlug?: string;
  excerpt?: string;
  scraped_at?: string;
}

const {
  image,
  title,
  date,
  source,
  category,
  categoryVariant = "filled",
  href = "#",
  identifier,
  articleId,
  articleSlug,
  excerpt = "",
  scraped_at,
} = Astro.props;

const articleDataJson = serializeBookmarkData({
  id: articleId,
  slug: articleSlug,
  title,
  excerpt,
  image,
  scraped_at,
  source,
  category,
});
---

<a
  href={href}
  class="featured-secondary"
>
  <img
    src={image}
    alt={title}
    class="featured-secondary__image"
    loading="lazy"
    width="600"
    height="288"
  />

  <!-- Actions: comment count + bookmark -->
  <div class="card-actions">
    {identifier && <DisqusCommentCount identifier={identifier} />}
    {articleId && (
      <BookmarkButton articleId={articleId} articleData={articleDataJson} />
    )}
  </div>

  <div class="featured-secondary__footer">
    <div class="featured-secondary__badges">
      <Badge label={source} variant="light" />
      <Badge label={category} variant={categoryVariant} />
    </div>
    <h3 class="featured-secondary__title">{title}</h3>
    <p class="featured-secondary__date">{date}</p>
  </div>
</a>

<style>
  .featured-secondary {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 6px;
    overflow: hidden;
    height: 288px;
    width: 100%;
    text-decoration: none;
    background-color: color-mix(in srgb, var(--navy-2) 8%, transparent);
    flex-shrink: 0;
    border: 1px solid var(--ev-border-subtle);
  }

  .featured-secondary__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
    transition: transform 0.3s ease-in-out;
  }

  .featured-secondary:hover .featured-secondary__image {
    transform: scale(1.05);
  }

  .featured-secondary__footer {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: linear-gradient(
      to bottom,
      rgba(114, 114, 114, 0),
      #1f1633
    );
    height: 100%;
    justify-content: flex-end;
  }

  .featured-secondary__badges {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .featured-secondary__title {
    font-family: "Playfair Display", serif;
    font-size: 28px;
    font-weight: 700;
    font-style: italic;
    line-height: 1.1;
    color: var(--ev-text-on-image);
    text-shadow: 2px 2px 4px rgba(25, 27, 65, 0.5);
    transition: text-decoration 0.2s ease;
  }

  .featured-secondary:hover .featured-secondary__title {
    text-decoration: underline;
  }

  .featured-secondary__date {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: var(--ev-text-on-image);
    text-shadow: 2px 2px 4px rgba(25, 27, 65, 0.5);
    white-space: nowrap;
  }

  /* Override badge colors — always on dark image overlay */
  .featured-secondary :global(.badge--filled) {
    background-color: var(--ev-bg-accent);
    color: var(--ev-text-on-image);
  }

  .featured-secondary :global(.badge--light) {
    background-color: #faf7f0;
    color: #191b41;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .featured-secondary {
      height: 340px;
    }
  }
</style>

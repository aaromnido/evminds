---
interface Props {
  size?: 'sm' | 'lg';
}

const { size = 'sm' } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${size}`]} aria-label="evminds.es">
  <img src="/logo.svg" alt="evminds.es" class="logo__img" />
</a>

<style>
  .logo {
    display: inline-block;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo__img {
    display: block;
    height: auto;
  }

  .logo--sm .logo__img {
    width: 160px;
  }

  .logo--lg .logo__img {
    width: 240px;
  }
</style>

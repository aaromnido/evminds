---
interface Props {
  title: string;
  footerLabel?: string;
  footerIcon?: boolean;
}

const { title, footerLabel, footerIcon = false } = Astro.props;
---

<div class="drawer-backdrop" data-drawer-backdrop></div>
<aside class="drawer" data-drawer aria-label={title}>
  <div class="drawer__header">
    <h2 class="drawer__title">{title}</h2>
    <button type="button" class="drawer__close" data-close-drawer aria-label="Cerrar">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="drawer__content">
    <slot />
  </div>

  {
    footerLabel && (
      <div class="drawer__footer">
        <button type="button" class="drawer__footer-btn" data-drawer-footer-action>
          {footerIcon && (
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
              <path d="M3 3v5h5" />
            </svg>
          )}
          {footerLabel}
        </button>
      </div>
    )
  }
</aside>

<style>
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--sepia-light) 50%, transparent);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
    z-index: 9998;
  }

  .drawer-backdrop.open {
    opacity: 1;
    visibility: visible;
  }

  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50%;
    max-width: 100%;
    background-color: var(--sepia-light);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .drawer.open {
    transform: translateX(0);
  }

  .drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1.5px solid var(--ev-border-subtle);
  }

  .drawer__title {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    color: var(--navy-2);
    margin: 0;
  }

  .drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: var(--navy-2);
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .drawer__close:hover {
    background-color: color-mix(in srgb, var(--navy-2) 8%, transparent);
  }

  .drawer__content {
    padding: 24px;
    flex: 1;
    overflow-y: auto;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--navy-2);
  }

  .drawer__footer {
    padding: 16px 24px;
    border-top: 1.5px solid var(--ev-border-subtle);
    flex-shrink: 0;
  }

  .drawer__footer-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1.5px solid var(--navy-2);
    border-radius: 100px;
    background: transparent;
    color: var(--navy-2);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .drawer__footer-btn:hover {
    background-color: color-mix(in srgb, var(--navy-2) 5%, transparent);
  }

  @media (max-width: 1024px) {
    .drawer {
      width: 75%;
    }
  }

  @media (max-width: 768px) {
    .drawer {
      width: 100%;
    }
  }
</style>

<script is:inline>
  (function () {
    function initDrawer() {
      var openBtn = document.querySelector("[data-open-drawer]");
      var closeBtn = document.querySelector("[data-close-drawer]");
      var drawer = document.querySelector("[data-drawer]");
      var backdrop = document.querySelector("[data-drawer-backdrop]");
      if (!openBtn || !closeBtn || !drawer || !backdrop) return;
      if (openBtn.hasAttribute("data-drawer-init")) return;
      openBtn.setAttribute("data-drawer-init", "");

      function open() {
        drawer.classList.add("open");
        backdrop.classList.add("open");
        document.body.style.overflow = "hidden";
        drawer.dispatchEvent(new CustomEvent("drawer:open"));
      }

      function close() {
        drawer.classList.remove("open");
        backdrop.classList.remove("open");
        document.body.style.overflow = "";
        drawer.dispatchEvent(new CustomEvent("drawer:close"));
      }

      openBtn.addEventListener("click", open);
      closeBtn.addEventListener("click", close);
      backdrop.addEventListener("click", close);

      document.addEventListener(
        "keydown",
        function (e) {
          if ((e.key === "Escape" || e.key === "Esc") && drawer.classList.contains("open")) {
            e.preventDefault();
            e.stopImmediatePropagation();
            close();
          }
        },
        true,
      );
    }

    initDrawer();
  })();
</script>

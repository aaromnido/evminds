---
// AdminEditButton — floating link to this content's admin edit page. Rendered
// only when the caller (Phase 3/4 pages) has already confirmed the visitor is
// an authenticated admin via src/lib/admin-session.ts; this component has no
// auth logic of its own.
//
// Positioning contract: it anchors with `position: absolute` to overlap the
// top-right corner of its container, so the parent title/heading wrapper
// MUST set `position: relative` for the overlay to land in the right spot.
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  class="admin-edit-button"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Editar en el panel de administración"
  title="Editar en el panel de administración"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 20h9"></path>
    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
  </svg>
</a>

<style>
  .admin-edit-button {
    position: absolute;
    top: -10px;
    right: -10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: var(--background);
    border: 1px solid var(--ev-border-subtle);
    border-radius: 6px;
    color: var(--navy-2);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    transition:
      opacity 0.15s,
      transform 0.15s;
    flex-shrink: 0;
  }

  .admin-edit-button:hover {
    opacity: 0.7;
  }

  .admin-edit-button:active {
    transform: scale(0.95);
  }
</style>

---
interface Props {
  subtitle?: string;
  variant?: "default" | "category";
}

const { subtitle, variant = "default" } = Astro.props;
---

<section class:list={["subheader", `subheader--${variant}`]}>
  <h1 class="subheader__title">
    <slot name="title" />
  </h1>
  <div class="subheader__row">
    {subtitle && <p class="subheader__subtitle">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .subheader {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    width: 100%;
  }

  .subheader__title {
    font-family: var(--font-heading);
    font-size: 48px;
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    color: var(--navy-2);
    letter-spacing: -0.01em;
  }

  .subheader__title :global(strong) {
    font-weight: 600;
  }

  .subheader__subtitle {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    color: var(--navy-2);
    letter-spacing: -0.01em;
    line-height: 1;
  }

  /* Category variant */
  .subheader--category {
    gap: 16px;
  }

  .subheader--category .subheader__title {
    font-size: 42px;
    font-weight: 600;
    line-height: 1.1;
  }

  .subheader--category .subheader__subtitle {
    font-size: 16px;
    line-height: 1.4;
    opacity: 0.8;
  }

  .subheader__row {
    width: 100%;
  }

  @media (max-width: 768px) {
    .subheader__title {
      font-size: 24px;
    }

    .subheader__subtitle {
      font-size: 13.5px;
    }

    .subheader--category .subheader__title {
      font-size: 28px;
    }

    .subheader--category .subheader__subtitle {
      font-size: 14px;
    }
  }
</style>

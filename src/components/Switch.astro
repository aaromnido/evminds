---
interface Props {
  dataPref: string;
  checked?: boolean;
  dataLang?: string;
  dataSourceName?: string;
  dataCategoryName?: string;
  /** Accessible name: the visible text label lives in a sibling element, so the
   * checkbox needs its own name for screen readers. */
  ariaLabel: string;
}

const {
  dataPref,
  checked = true,
  dataLang,
  dataSourceName,
  dataCategoryName,
  ariaLabel,
} = Astro.props;
---

<label class="switch">
  <input
    type="checkbox"
    checked={checked}
    aria-label={ariaLabel}
    data-pref={dataPref}
    data-lang={dataLang}
    data-source-name={dataSourceName}
    data-category-name={dataCategoryName}
  />
  <span class="switch__track"></span>
</label>

<style>
  .switch {
    position: relative;
    display: inline-flex;
    cursor: pointer;
    flex-shrink: 0;
  }

  .switch input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .switch__track {
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background-color: transparent;
    border: 1.5px solid var(--navy-2);
    opacity: 0.8;
    transition: background-color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
    position: relative;
  }

  .switch__track::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background-color: var(--navy-2);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .switch input:checked + .switch__track {
    background-color: var(--navy-2);
    border-color: var(--navy-2);
    opacity: 1;
  }

  .switch input:checked + .switch__track::after {
    transform: translateX(20px);
    background-color: white;
  }
</style>

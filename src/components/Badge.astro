---
interface Props {
  label: string;
  variant?: 'filled' | 'outlined' | 'light' | 'green';
}

const { label, variant = 'outlined' } = Astro.props;
---

<span class:list={['badge', `badge--${variant}`]}>{label}</span>

<style is:global>
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7.4px 8.9px;
    border-radius: 75px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 11.67px;
    letter-spacing: -0.117px;
    white-space: nowrap;
    line-height: 1;
  }

  .badge--filled {
    background-color: var(--ev-bg-accent);
    border: 0.5px solid var(--ev-text-on-image);
    color: var(--ev-text-on-image);
  }

  .badge--outlined {
    border: 1.5px solid var(--navy-2);
    color: var(--navy-2);
    background-color: transparent;
  }

  .dark .badge--outlined {
    background-color: #faf7f0;
    color: #191b41;
    border-color: #faf7f0;
  }

  .badge--light {
    background-color: var(--sepia-light);
    color: var(--navy-2);
  }

  .badge--green {
    background-color: var(--ev-primary-green);
    color: var(--navy-2);
  }
</style>

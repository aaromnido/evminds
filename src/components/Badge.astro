---
interface Props {
  label: string;
  variant?: "filled" | "outlined" | "light" | "green" | "amber" | "red";
  /** When set, the badge renders as a link. */
  href?: string;
  title?: string;
  ariaLabel?: string;
}

const { label, variant = "outlined", href, title, ariaLabel } = Astro.props;
---

{
  href ? (
    <a class:list={["badge", `badge--${variant}`]} href={href} title={title} aria-label={ariaLabel}>
      {label}
    </a>
  ) : (
    <span class:list={["badge", `badge--${variant}`]} title={title} aria-label={ariaLabel}>
      {label}
    </span>
  )
}

<style is:global>
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7.4px 8.9px;
    border-radius: 75px;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 11.67px;
    letter-spacing: -0.117px;
    white-space: nowrap;
    line-height: 1;
  }

  a.badge {
    text-decoration: none;
    transition: filter 0.15s ease;
  }
  a.badge:hover,
  a.badge:focus-visible {
    filter: brightness(0.96);
  }

  .badge--filled {
    background-color: var(--ev-bg-accent);
    border: 0.5px solid var(--ev-text-on-image);
    color: var(--ev-text-on-image);
  }

  .badge--outlined {
    border: 1.5px solid var(--navy-2);
    color: var(--navy-2);
    background-color: transparent;
  }

  .dark .badge--outlined {
    background-color: var(--ev-text-on-image);
    color: var(--ev-bg-accent);
    border-color: var(--ev-text-on-image);
  }

  .badge--light {
    background-color: var(--sepia-light);
    color: var(--navy-2);
  }

  /* Headline-tone fills (A12). Same pill shape/typography as --outlined; only
     the color changes. Fixed inks (not theme tokens) so contrast holds in light
     and dark, since the fills stay vivid in both. */
  .badge--green {
    background-color: var(--ev-tone-green);
    border: 1.5px solid var(--ev-tone-green);
    color: var(--ev-text-on-image);
  }
  .badge--amber {
    background-color: var(--ev-tone-amber);
    border: 1.5px solid var(--ev-tone-amber);
    color: var(--ev-bg-accent);
  }
  .badge--red {
    background-color: var(--ev-tone-red);
    border: 1.5px solid var(--ev-tone-red);
    color: var(--ev-text-on-image);
  }
</style>

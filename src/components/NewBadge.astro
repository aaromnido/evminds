---
// Small "New" novelty badge (blue pill). Reusable: nav items, icon buttons, etc.
// Positioning is left to the consumer (inline by default; wrap in a positioned
// element to float it over a button).
interface Props {
  label?: string;
  class?: string;
}
const { label = "New", class: className } = Astro.props;
---

<span class:list={["new-badge", className]}>{label}</span>

<style>
  .new-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 8px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fff;
    background-color: var(--ev-primary-blue);
    padding: 2px 6px;
    border-radius: 20px;
    line-height: 1;
  }
</style>

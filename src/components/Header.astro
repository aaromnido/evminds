---
import Logo from "./Logo.astro";
import { MobileMenu } from "./MobileMenu";

const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Artículos", href: "/", active: currentPath === "/" || currentPath.startsWith("/articulo/") },
  { label: "Guardados", href: "/articulos-guardados", active: currentPath === "/articulos-guardados" },
  { label: "Quienes somos", href: "/quienes-somos", active: currentPath === "/quienes-somos" },
  { label: "Contacto", href: "/contacto", active: currentPath === "/contacto" },
];
---

<header class="site-header">
  <div class="header__brand">
    <Logo />
    <span class="header__beta-badge">Beta</span>
  </div>

  {/* Desktop Navigation */}
  <nav class="nav" aria-label="Navegación principal">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={["nav__item", { "nav__item--active": item.active }]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  {/* Mobile Menu */}
  <MobileMenu navItems={navItems} client:load />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 2px solid var(--navy-2);
    width: 100%;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header__beta-badge {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--navy-2);
    background: transparent;
    border: 1.5px solid var(--navy-2);
    border-radius: 20px;
    padding: 4px 12px;
    letter-spacing: 0.02em;
  }

  .nav {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .nav__item {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--navy-2);
    text-decoration: none;
    padding: 12px 0;
    letter-spacing: -0.01em;
    white-space: nowrap;
    border-top: 2px solid transparent;
    transition: border-color 0.15s;
  }

  .nav__item--active {
    border-top-color: var(--navy-2);
  }

  .nav__item:hover:not(.nav__item--active) {
    border-top-color: color-mix(in srgb, var(--navy-2) 30%, transparent);
  }

  /* Mobile - Hide desktop navigation */
  @media (max-width: 768px) {
    .nav {
      display: none;
    }
  }
</style>

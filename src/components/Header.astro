---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SearchButton from "./SearchButton.astro";
import SearchModal from "./SearchModal.astro";
import { MobileMenu } from "./MobileMenu";

const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Noticias", href: "/", active: currentPath === "/" || currentPath.startsWith("/noticia/") },
  { label: "Artículos", href: "/articulos", active: currentPath === "/articulos" || currentPath.startsWith("/articulo/") },
  { label: "Vídeos", href: "/videos", active: currentPath === "/videos" || currentPath.startsWith("/video/") },
  { label: "Guardados", href: "/articulos-guardados", active: currentPath === "/articulos-guardados" },
  { label: "Recursos", href: "/recursos", active: currentPath === "/recursos" || currentPath.startsWith("/recursos/") },
  { label: "Confianza medios", href: "/medios-de-confianza", active: currentPath === "/medios-de-confianza" },
];
---

<header class="site-header">
  <div class="header__brand">
    <Logo />
    <span class="header__beta-badge">Beta</span>
  </div>

  {/* Desktop Navigation */}
  <nav class="nav" aria-label="Navegación principal">
    <div class="nav__indicator" aria-hidden="true"></div>
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={["nav__item", { "nav__item--active": item.active }]}
        >
          {item.label}
        </a>
      ))
    }
    <SearchButton showNew />
    <ThemeToggle />
  </nav>

  {/* Mobile actions: search + menu */}
  <div class="header__mobile-actions">
    <SearchButton showNew />
    <MobileMenu navItems={navItems} client:idle />
  </div>
</header>

<SearchModal />

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 2px solid var(--navy-2);
    width: 100%;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header__beta-badge {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--navy-2);
    background: transparent;
    border: 1.5px solid var(--navy-2);
    border-radius: 20px;
    padding: 4px 12px;
    letter-spacing: 0.02em;
  }

  .nav {
    display: flex;
    gap: 24px;
    align-items: center;
    position: relative;
  }

  .nav__indicator {
    position: absolute;
    top: 0;
    height: 2px;
    background-color: var(--navy-2);
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.15s, background-color 0.15s;
    opacity: 0;
    pointer-events: none;
  }

  .nav__item {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--navy-2);
    text-decoration: none;
    padding: 12px 0;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .header__mobile-actions {
    display: none;
    align-items: center;
    gap: 12px;
  }

  /* Mobile - Hide desktop navigation, show mobile actions */
  @media (max-width: 768px) {
    .nav {
      display: none;
    }

    .header__mobile-actions {
      display: flex;
    }
  }
</style>

<script is:inline>
  function initNavIndicator() {
    var nav = document.querySelector('.nav');
    var indicator = nav && nav.querySelector('.nav__indicator');
    var items = nav ? nav.querySelectorAll('.nav__item') : [];
    if (!nav || !indicator || !items.length) return;

    // Already initialized — skip
    if (nav.hasAttribute('data-nav-init')) return;
    nav.setAttribute('data-nav-init', '');

    var activeItem = nav.querySelector('.nav__item--active');
    var navColor = getComputedStyle(document.documentElement).getPropertyValue('--navy-2').trim();
    var blueColor = getComputedStyle(document.documentElement).getPropertyValue('--ev-primary-blue').trim();

    function positionAt(el, color) {
      var navRect = nav.getBoundingClientRect();
      var elRect = el.getBoundingClientRect();
      indicator.style.left = (elRect.left - navRect.left) + 'px';
      indicator.style.width = elRect.width + 'px';
      indicator.style.backgroundColor = color;
      indicator.style.opacity = '1';
    }

    // Show on active item initially
    if (activeItem) {
      positionAt(activeItem, navColor);
    }

    items.forEach(function(item) {
      item.addEventListener('mouseenter', function() {
        var isActive = item.classList.contains('nav__item--active');
        positionAt(item, isActive ? navColor : blueColor);
      });
    });

    nav.addEventListener('mouseleave', function() {
      if (activeItem) {
        positionAt(activeItem, navColor);
      } else {
        indicator.style.opacity = '0';
      }
    });
  }

  initNavIndicator();
</script>

---
interface Props {
  subtitle: string;
}

const { subtitle } = Astro.props;
---

<section class="hero">
  <h1 class="hero__title">
    <slot />
  </h1>
  <p class="hero__subtitle">{subtitle}</p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 0;
  }

  .hero__title {
    font-family: "Playfair Display", serif;
    font-size: 56px;
    font-style: italic;
    font-weight: 300;
    line-height: 1.1;
    color: var(--navy-2);
    letter-spacing: -0.01em;
    width: 100%;
  }

  .hero__title :global(strong) {
    font-weight: 600;
  }

  .hero__subtitle {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 20px;
    font-weight: 400;
    color: var(--navy-2);
    opacity: 0.6;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .hero__title {
      font-size: 42px;
    }

    .hero__subtitle {
      font-size: 18px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero {
      padding: 24px 0;
      gap: 16px;
    }

    .hero__title {
      font-size: 28px;
    }

    .hero__subtitle {
      font-size: 15px;
    }
  }
</style>

---
// Spotlight-style search modal. Mounted once globally (via Header).
// Opens with ⌘K / Ctrl+K (desktop) or a `search:open` event (magnifier button).
// Queries /api/search (pg_trgm + unaccent) live as you type.
---

<div class="search-modal" data-search-modal hidden>
  <div class="search-modal__backdrop" data-search-close></div>

  <div class="search-modal__panel" role="dialog" aria-modal="true" aria-label="Buscar contenido">
    <div class="search-modal__input-row">
      <svg class="search-modal__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        class="search-modal__input"
        data-search-input
        placeholder="Buscar noticias, vídeos y artículos…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="Buscar"
      />
      <button type="button" class="search-modal__esc" data-search-close aria-label="Cerrar">esc</button>
    </div>

    <div class="search-modal__results" data-search-results role="listbox" aria-label="Resultados"></div>

    <div class="search-modal__hint" data-search-hint></div>

    <div class="search-modal__footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> navegar</span>
      <span><kbd>↵</kbd> abrir</span>
      <span><kbd>esc</kbd> cerrar</span>
    </div>
  </div>
</div>

<style is:global>
  .search-modal[hidden] { display: none; }

  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
  }

  .search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--sepia-light) 50%, transparent);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    animation: search-fade 0.15s ease;
  }

  .search-modal__panel {
    position: absolute;
    top: 12vh;
    left: 50%;
    transform: translateX(-50%);
    width: min(860px, 92vw);
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--sepia-light);
    border: 1.5px solid var(--ev-border-subtle);
    border-radius: 12px;
    box-shadow: 0 20px 48px rgba(25, 27, 65, 0.18);
    animation: search-pop 0.16s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes search-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes search-pop {
    from { opacity: 0; transform: translateX(-50%) translateY(-8px) scale(0.985); }
    to { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
  }

  .search-modal__input-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1.5px solid var(--ev-border-subtle);
    flex-shrink: 0;
  }

  .search-modal__icon { color: color-mix(in srgb, var(--navy-2) 55%, transparent); flex-shrink: 0; }

  .search-modal__input {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 17px;
    color: var(--navy-2);
    padding: 0;
  }
  .search-modal__input::placeholder { color: color-mix(in srgb, var(--navy-2) 45%, transparent); }

  .search-modal__esc {
    flex-shrink: 0;
    border: 1.5px solid var(--ev-border-subtle);
    background: transparent;
    color: color-mix(in srgb, var(--navy-2) 65%, transparent);
    border-radius: 6px;
    padding: 3px 8px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .search-modal__esc:hover { background-color: color-mix(in srgb, var(--navy-2) 6%, transparent); }

  .search-modal__results {
    overflow-y: auto;
    padding: 6px;
  }
  .search-modal__results:empty { display: none; }

  .search-result {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 10px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    scroll-margin: 8px;
  }
  .search-result.is-active { background: color-mix(in srgb, var(--ev-primary-blue) 12%, transparent); }

  .search-result__thumb {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 6px;
    object-fit: cover;
    background: var(--ev-skeleton);
  }

  .search-result__body { min-width: 0; }

  .search-result__title {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--navy-2);
    line-height: 1.3;
    margin: 0 0 3px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-result__meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    color: color-mix(in srgb, var(--navy-2) 60%, transparent);
    overflow: hidden;
    white-space: nowrap;
  }
  .search-result__meta span { overflow: hidden; text-overflow: ellipsis; }
  .search-result__sep { opacity: 0.5; }

  .search-result__badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--ev-primary-blue);
    font-weight: 600;
    flex-shrink: 0;
  }

  .search-result__date {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    color: color-mix(in srgb, var(--navy-2) 55%, transparent);
    white-space: nowrap;
    text-align: right;
  }

  .search-modal__hint {
    padding: 22px 18px 26px;
    text-align: center;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 13px;
    color: color-mix(in srgb, var(--navy-2) 55%, transparent);
  }
  .search-modal__hint:empty { display: none; }
  .search-modal__hint strong { color: var(--navy-2); font-weight: 600; }

  .search-modal__footer {
    display: flex;
    gap: 16px;
    padding: 10px 18px;
    border-top: 1.5px solid var(--ev-border-subtle);
    flex-shrink: 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 11px;
    color: color-mix(in srgb, var(--navy-2) 50%, transparent);
  }
  .search-modal__footer kbd {
    display: inline-block;
    min-width: 16px;
    padding: 1px 5px;
    margin-right: 2px;
    border: 1px solid var(--ev-border-subtle);
    border-radius: 4px;
    background: color-mix(in srgb, var(--navy-2) 4%, transparent);
    font-family: inherit;
    font-size: 10px;
    text-align: center;
  }

  /* Touch devices: no physical keyboard, hide shortcut hints */
  @media (hover: none) {
    .search-modal__footer { display: none; }
    .search-modal__panel { top: 6vh; max-height: 80vh; }
  }
</style>

<script is:inline>
  (function () {
    // Bind document-level listeners only once; they survive View Transitions and
    // always target the live modal element (re-queried on each interaction).
    if (window.__searchModalInit) return;
    window.__searchModalInit = true;

    var MIN_LEN = 2;
    var DEBOUNCE_MS = 200;
    var debounceTimer = null;
    var results = [];
    var activeIndex = -1;
    var lastQuery = '';

    function els() {
      return {
        modal: document.querySelector('[data-search-modal]'),
        input: document.querySelector('[data-search-input]'),
        list: document.querySelector('[data-search-results]'),
        hint: document.querySelector('[data-search-hint]'),
      };
    }

    function isOpen() {
      var m = document.querySelector('[data-search-modal]');
      return m && !m.hidden;
    }

    function open() {
      var e = els();
      if (!e.modal) return;
      e.modal.hidden = false;
      document.body.style.overflow = 'hidden';
      results = [];
      activeIndex = -1;
      lastQuery = '';
      if (e.input) { e.input.value = ''; e.input.focus(); }
      if (e.list) e.list.innerHTML = '';
      setHint('Escribe para buscar en <strong>noticias, vídeos y artículos</strong>.');
    }

    function close() {
      var e = els();
      if (!e.modal) return;
      e.modal.hidden = true;
      document.body.style.overflow = '';
    }

    function setHint(html) {
      var e = els();
      if (e.hint) e.hint.innerHTML = html || '';
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    var VIDEO_ICON = '<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>';

    function render() {
      var e = els();
      if (!e.list) return;
      if (!results.length) { e.list.innerHTML = ''; return; }

      var html = '';
      for (var i = 0; i < results.length; i++) {
        var r = results[i];
        var badge = r.contentType === 'video'
          ? '<span class="search-result__badge">' + VIDEO_ICON + 'Vídeo</span><span class="search-result__sep">·</span>'
          : '';
        html +=
          '<a class="search-result' + (i === activeIndex ? ' is-active' : '') + '" href="' + escapeHtml(r.href) + '" role="option" data-index="' + i + '">' +
            '<img class="search-result__thumb" src="' + escapeHtml(r.image) + '" alt="" loading="lazy" />' +
            '<div class="search-result__body">' +
              '<p class="search-result__title">' + escapeHtml(r.title) + '</p>' +
              '<div class="search-result__meta">' + badge +
                '<span>' + escapeHtml(r.source) + '</span>' +
                '<span class="search-result__sep">·</span>' +
                '<span>' + escapeHtml(r.category) + '</span>' +
              '</div>' +
            '</div>' +
            '<span class="search-result__date">' + escapeHtml(r.date) + '</span>' +
          '</a>';
      }
      e.list.innerHTML = html;
    }

    function setActive(i) {
      if (!results.length) return;
      activeIndex = (i + results.length) % results.length;
      render();
      var e = els();
      var el = e.list && e.list.querySelector('.search-result.is-active');
      if (el) el.scrollIntoView({ block: 'nearest' });
    }

    function runSearch(q) {
      lastQuery = q;
      setHint('Buscando…');
      fetch('/api/search?q=' + encodeURIComponent(q))
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (q !== lastQuery) return; // stale response, a newer query is in flight
          results = (data && data.results) || [];
          activeIndex = results.length ? 0 : -1;
          if (!results.length) {
            setHint('Sin resultados para «<strong>' + escapeHtml(q) + '</strong>».');
          } else {
            setHint('');
          }
          render();
        })
        .catch(function () {
          if (q !== lastQuery) return;
          results = [];
          setHint('No se pudo buscar. Inténtalo de nuevo.');
          render();
        });
    }

    function onInput(value) {
      var q = (value || '').trim();
      clearTimeout(debounceTimer);
      if (q.length < MIN_LEN) {
        results = [];
        activeIndex = -1;
        render();
        setHint('Escribe para buscar en <strong>noticias, vídeos y artículos</strong>.');
        return;
      }
      debounceTimer = setTimeout(function () { runSearch(q); }, DEBOUNCE_MS);
    }

    // --- Global event wiring (once) ---

    document.addEventListener('search:open', open);

    document.addEventListener('input', function (e) {
      if (e.target && e.target.matches && e.target.matches('[data-search-input]')) {
        onInput(e.target.value);
      }
    });

    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('[data-search-close]')) {
        e.preventDefault();
        close();
        return;
      }
      // Closing on result click; let the anchor navigation proceed
      if (e.target.closest && e.target.closest('.search-result')) {
        close();
      }
    });

    document.addEventListener('keydown', function (e) {
      var mac = (navigator.userAgentData && navigator.userAgentData.platform === 'macOS') ||
                /Mac|iPod|iPhone|iPad/.test(navigator.platform);
      var cmdK = (mac ? e.metaKey : e.ctrlKey) && (e.key === 'k' || e.key === 'K');

      if (cmdK) {
        e.preventDefault();
        if (isOpen()) { close(); } else { open(); }
        return;
      }

      if (!isOpen()) return;

      if (e.key === 'Escape' || e.key === 'Esc') {
        e.preventDefault();
        e.stopImmediatePropagation();
        close();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(activeIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(activeIndex - 1);
      } else if (e.key === 'Enter') {
        if (activeIndex >= 0 && results[activeIndex]) {
          e.preventDefault();
          close();
          window.location.href = results[activeIndex].href;
        }
      }
    }, true);
  })();
</script>

---
interface Props {
  articleId: string;
  articleData: string;
  variant?: "dark" | "white";
  tooltipPosition?: "center" | "left";
}

const { articleId, articleData, variant = "dark", tooltipPosition = "center" } = Astro.props;

const defaultIcon = variant === "white" ? "/icon-bookmark-white-default.svg" : "/icon-bookmark-default.svg";
const activeIcon = variant === "white" ? "/icon-bookmark-white-active.svg" : "/icon-bookmark-active.svg";
---

<button
  class:list={["bookmark-btn", { "bookmark-btn--white": variant === "white", "bookmark-btn--tooltip-left": tooltipPosition === "left" }]}
  data-article-id={articleId}
  data-article={articleData}
  data-tooltip="Guardar artículo"
  aria-label="Guardar artículo"
  aria-pressed="false"
>
  <img
    class="bookmark-btn__icon bookmark-btn__icon--default"
    src={defaultIcon}
    width="24"
    height="24"
    alt=""
  />
  <img
    class="bookmark-btn__icon bookmark-btn__icon--active"
    src={activeIcon}
    width="24"
    height="24"
    alt=""
    style="display:none;"
  />
</button>

<style is:global>
  .bookmark-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: transform 0.15s ease;
    flex-shrink: 0;
    position: relative;
  }

  /* Tooltip text bubble */
  .bookmark-btn::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--navy, #1a1a2e);
    color: var(--cream, #f6f2e6);
    font-family: var(--font-body, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    padding: 6px 10px;
    border-radius: 6px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  /* Triangle arrow — flush with bottom edge of tooltip bubble */
  .bookmark-btn::before {
    content: "";
    position: absolute;
    bottom: calc(100% - 2px);
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--navy, #1a1a2e);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 1;
  }

  /* Featured tooltip: above button, starts slightly before button left, triangle centered on button */
  .bookmark-btn--tooltip-left::after {
    left: -6px;
    transform: none;
  }

  .bookmark-btn:hover {
    transform: scale(1.15);
  }

  .bookmark-btn:hover::after,
  .bookmark-btn:hover::before {
    opacity: 1;
  }

  .bookmark-btn:active {
    transform: scale(0.95);
  }

  /* In dark mode, invert dark variant icons to white */
  .dark .bookmark-btn:not(.bookmark-btn--white) .bookmark-btn__icon {
    filter: brightness(0) invert(1);
  }
</style>

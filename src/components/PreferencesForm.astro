---
import { CATEGORIES } from "@/lib/categories";
import { loadSources } from "@/lib/sources";
import Switch from "./Switch.astro";

const sources = await loadSources();
const mediaSources = sources.filter((s) => s.feedType !== 'youtube');
const videoSources = sources.filter((s) => s.feedType === 'youtube');
---

<!-- Content -->
<section class="prefs__section">
  <h3 class="prefs__section-title">Contenido</h3>
  <div class="prefs__option">
    <span class="prefs__option-label">Solo con comentarios</span>
    <Switch dataPref="only-with-comments" checked={false} />
  </div>
</section>

<!-- Language -->
<section class="prefs__section">
  <h3 class="prefs__section-title">Idioma</h3>
  <div class="prefs__option">
    <span class="prefs__option-label">Contenido en inglés</span>
    <Switch dataPref="lang-en" />
  </div>
</section>

<!-- Media Sources -->
<section class="prefs__section">
  <h3 class="prefs__section-title">Medios</h3>
  <div class="prefs__grid">
    {mediaSources.map((source) => (
      <div class="prefs__option">
        <span class="prefs__option-label">
          {source.displayName}
          {source.lang === 'en' && <span class="prefs__badge">EN</span>}
        </span>
        <Switch
          dataPref={`source-${source.slug}`}
          dataLang={source.lang}
          dataSourceName={source.name}
        />
      </div>
    ))}
  </div>
</section>

<!-- Video Sources -->
<section class="prefs__section">
  <h3 class="prefs__section-title">Vídeos</h3>
  <div class="prefs__grid">
    {videoSources.map((source) => (
      <div class="prefs__option">
        <span class="prefs__option-label">
          {source.displayName}
          {source.lang === 'en' && <span class="prefs__badge">EN</span>}
        </span>
        <Switch
          dataPref={`source-${source.slug}`}
          dataLang={source.lang}
          dataSourceName={source.name}
        />
      </div>
    ))}
  </div>
</section>

<!-- Categories -->
<section class="prefs__section">
  <h3 class="prefs__section-title">Categorías</h3>
  <div class="prefs__grid">
    {CATEGORIES.map((cat) => (
      <div class="prefs__option">
        <span class="prefs__option-label">{cat.name}</span>
        <Switch
          dataPref={`category-${cat.slug}`}
          dataCategoryName={cat.name}
        />
      </div>
    ))}
  </div>
</section>

<style>
  .prefs__section {
    margin-bottom: 24px;
  }

  .prefs__section:last-child {
    margin-bottom: 0;
  }

  .prefs__section-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--navy-2) 50%, transparent);
    margin: 0 0 12px 0;
  }

  .prefs__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
  }

  .prefs__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--ev-border-subtle);
  }

  .prefs__option-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--navy-2);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .prefs__badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
    background-color: color-mix(in srgb, var(--ev-primary-blue) 15%, transparent);
    color: var(--ev-primary-blue);
  }

  @media (max-width: 768px) {
    .prefs__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

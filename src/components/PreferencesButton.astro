---
import PreferencesDrawer from "./PreferencesDrawer.astro";
---

<button
  type="button"
  class="preferences-btn"
  data-tooltip="Personalizar"
  aria-label="Personalizar"
  data-open-drawer
>
  <svg
    class="preferences-btn__icon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <line x1="4" y1="21" x2="4" y2="14"></line>
    <line x1="4" y1="10" x2="4" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="12"></line>
    <line x1="12" y1="8" x2="12" y2="3"></line>
    <line x1="20" y1="21" x2="20" y2="16"></line>
    <line x1="20" y1="12" x2="20" y2="3"></line>
    <line x1="1" y1="14" x2="7" y2="14"></line>
    <line x1="9" y1="8" x2="15" y2="8"></line>
    <line x1="17" y1="16" x2="23" y2="16"></line>
  </svg>
  <span class="preferences-btn__label">Personalizar preferencias</span>
</button>

<PreferencesDrawer />

<style>
  .preferences-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 42px;
    height: 42px;
    border-radius: 100px;
    border: 1.5px solid var(--navy-2);
    color: var(--navy-2);
    background-color: transparent;
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
    position: relative;
  }

  .preferences-btn__label {
    display: none;
  }

  .preferences-btn:hover {
    background-color: color-mix(in srgb, var(--navy-2) 5%, transparent);
  }

  /* Tooltip — above button, right-aligned */
  .preferences-btn::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 10px);
    right: 0;
    background: var(--navy-2);
    color: var(--ev-text-on-image);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    padding: 6px 10px;
    border-radius: 6px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  /* Triangle arrow — pointing down, right-aligned */
  .preferences-btn::before {
    content: "";
    position: absolute;
    bottom: calc(100% - 2px);
    right: 12px;
    border: 6px solid transparent;
    border-top-color: var(--navy-2);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
    z-index: 1;
  }

  @media (hover: hover) {
    .preferences-btn:hover::after,
    .preferences-btn:hover::before {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (max-width: 768px) {
    .preferences-btn {
      width: 100%;
      height: auto;
      padding: 10px 18px;
      justify-content: center;
    }

    .preferences-btn__label {
      display: inline;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 500;
      letter-spacing: -0.01em;
    }

    .preferences-btn::after,
    .preferences-btn::before {
      display: none;
    }
  }
</style>

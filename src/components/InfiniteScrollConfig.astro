---
/**
 * Configuration for infinite scroll pagination.
 * Must be used alongside NewsGrid which provides the "articles-grid"
 * and "loading-skeletons" elements that src/scripts/infinite-scroll.ts expects.
 */
interface Props {
  cursor: string;
  category?: string;
  source?: string;
  contentType?: string;
}

const { cursor, category, source, contentType } = Astro.props;
---

<div
  id="infinite-scroll-config"
  data-cursor={cursor}
  data-category={category || ""}
  data-source={source || ""}
  data-content-type={contentType || ""}
  hidden
></div>
<script>
  import "@/scripts/infinite-scroll";
</script>

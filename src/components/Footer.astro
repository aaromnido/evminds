---
import { CATEGORIES } from "@/lib/categories";
import Logo from "./Logo.astro";

interface Props {
  availableCategorySlugs?: string[];
}

const { availableCategorySlugs } = Astro.props;

// Filter categories to only show those with articles (if availableCategorySlugs is provided)
const visibleCategories = availableCategorySlugs
  ? CATEGORIES.filter((cat) => availableCategorySlugs.includes(cat.slug))
  : CATEGORIES;
---

<footer class="site-footer">
  <div class="footer__columns">
    <!-- Column 1: Brand & Social -->
    <div class="footer__column">
      <Logo />
      <p class="footer__tagline">
        Un punto de encuentro para mentes inquietas y eléctricas
      </p>
      <div class="footer__social">
        <a
          href="https://t.me/evminders"
          target="_blank"
          rel="noopener noreferrer"
          class="footer__social-link"
          aria-label="Unirse a Telegram"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M18.384 2.394a1.215 1.215 0 0 0-1.244-.047L1.29 9.597a1.217 1.217 0 0 0 .046 2.26l3.99 1.496 1.53 4.893a1.217 1.217 0 0 0 1.952.455l2.413-2.02 3.807 2.843a1.217 1.217 0 0 0 1.91-.705l2.6-14.906a1.218 1.218 0 0 0-.154-.519zM7.44 12.662l-.962 3.076-.964-3.076 9.643-7.183-7.717 7.183z"
              fill="currentColor"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Column 2: Categories -->
    <div class="footer__column">
      <h3 class="footer__heading">Categorías</h3>
      <nav aria-label="Categorías de contenido">
        <ul class="footer__list">
          {
            visibleCategories.map((category) => (
              <li>
                <a href={`/categoria/${category.slug}`} class="footer__link">
                  {category.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/articulos" class="footer__link">Artículos</a>
          </li>
          <li>
            <a href="/videos" class="footer__link">Vídeos</a>
          </li>
          <li>
            <a href="/recursos" class="footer__link">Recursos</a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Column 3: EVMinds -->
    <div class="footer__column">
      <h3 class="footer__heading">EVMinds</h3>
      <nav aria-label="Acerca de EVMinds">
        <ul class="footer__list">
          <li>
            <a href="/quienes-somos" class="footer__link">Acerca de</a>
          </li>
          <li>
            <a href="/contacto" class="footer__link">Colaboraciones</a>
          </li>
          <li>
            <a href="/contacto" class="footer__link">Contacto</a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Column 4: Legal -->
    <div class="footer__column">
      <h3 class="footer__heading">Legal</h3>
      <nav aria-label="Información legal">
        <ul class="footer__list">
          <li>
            <a href="/aviso-legal" class="footer__link">Aviso legal</a>
          </li>
          <li>
            <a href="/politica-privacidad" class="footer__link">Política de privacidad</a>
          </li>
          <li>
            <a href="/politica-cookies" class="footer__link">Política de cookies</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer__bottom">
    <p class="footer__copyright">© 2026 EVMinds.es</p>
    <p class="footer__disclaimer">
      Las noticias enlazan a sus fuentes originales. EVMinds.es es un agregador
      de noticias y no produce contenido propio.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    padding: 48px 0 24px;
    border-top: 2px solid var(--ev-border-subtle);
    background-color: var(--sepia-light);
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    margin-bottom: 48px;
  }

  .footer__column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__tagline {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: var(--navy-2);
    line-height: 1.4;
    letter-spacing: -0.01em;
    opacity: 0.8;
  }

  .footer__social {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--ev-bg-accent);
    color: var(--ev-text-on-image);
    transition: opacity 0.15s;
  }

  :global(.dark) .footer__social-link {
    background-color: #faf7f0;
    color: #191b41;
  }

  .footer__social-link:hover {
    opacity: 0.8;
  }

  .footer__heading {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--navy-2);
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }

  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer__link {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: var(--navy-2);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: opacity 0.15s;
  }

  .footer__link:hover {
    opacity: 0.7;
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb, var(--navy-2) 20%, transparent);
  }

  .footer__copyright,
  .footer__disclaimer {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: var(--navy-2);
    letter-spacing: -0.01em;
    text-align: center;
    opacity: 0.7;
  }

  /* Tablet: 2 columns */
  @media (max-width: 1024px) {
    .footer__columns {
      grid-template-columns: repeat(2, 1fr);
      gap: 36px;
    }
  }

  /* Mobile: 1 column */
  @media (max-width: 768px) {
    .site-footer {
      padding: 36px 0 24px;
    }

    .footer__columns {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 32px;
    }

    .footer__bottom {
      padding-top: 20px;
      gap: 12px;
    }

    .footer__copyright,
    .footer__disclaimer {
      font-size: 11px;
    }
  }
</style>

---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const twitterUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const telegramUrl = `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`;
---

<div class="share-buttons">
  <span class="share-buttons__label">Compartir</span>

  <a
    href={twitterUrl}
    class="share-buttons__item share-buttons__item--twitter"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Compartir en Twitter/X"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
    </svg>
  </a>

  <a
    href={telegramUrl}
    class="share-buttons__item share-buttons__item--telegram"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Compartir en Telegram"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
    </svg>
  </a>

  <button
    class="share-buttons__item share-buttons__item--copy"
    aria-label="Copiar enlace"
    data-url={url}
  >
    <svg class="share-buttons__icon-copy" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
    <svg class="share-buttons__icon-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;">
      <polyline points="20 6 9 17 4 12" />
    </svg>
  </button>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('.share-buttons__item--copy').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        var url = btn.getAttribute('data-url');
        if (!url) return;

        try {
          await navigator.clipboard.writeText(url);
          var iconCopy = btn.querySelector('.share-buttons__icon-copy');
          var iconCheck = btn.querySelector('.share-buttons__icon-check');
          if (iconCopy) iconCopy.style.display = 'none';
          if (iconCheck) iconCheck.style.display = 'block';

          setTimeout(function () {
            if (iconCopy) iconCopy.style.display = 'block';
            if (iconCheck) iconCheck.style.display = 'none';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy link:', err);
        }
      });
    });
  })();
</script>

<style>
  .share-buttons {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .share-buttons__label {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--navy-2);
  }

  .share-buttons__item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--navy-2);
    background: transparent;
    color: var(--navy-light);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
    text-decoration: none;
  }

  .share-buttons__item:hover {
    background-color: var(--navy-light);
    color: var(--sepia-light);
  }

  :global(.dark) .share-buttons__item {
    border-color: #faf7f0;
    color: #faf7f0;
  }

  :global(.dark) .share-buttons__item:hover {
    background-color: #faf7f0;
    color: #191b41;
  }
</style>
